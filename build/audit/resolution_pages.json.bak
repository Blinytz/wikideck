 },
 "cinema-moderne|Astérix et Obélix : Mission Cléopâtre": {
  "slug": "cinema-moderne",
  "nom": "Astérix et Obélix : Mission Cléopâtre",
  "titre": "Astérix et Obélix : Mission Cléopâtre",
  "extrait": "Astérix et Obélix : Mission Cléopâtre est un film franco-allemand écrit et réalisé par Alain Chabat, sorti en 2002.\nLe film débute alors que Cléopâtre, la reine d'Égypte, décide, pour prouver à Jules César la grandeur de la civilisation égyptienne, de construire un palais en plein désert en l'espace de trois mois. Pour cela, elle fait appel à l'architecte Numérobis. Ce choix déplaît fortement à l'architecte royal, Amonbofis, jaloux de n'avoir pas été désigné pour mener à bien le projet. Numérobi",
  "illustration": "https://upload.wikimedia.org/wikipedia/fr/5/5f/Asterix--obelix-mission-cleopatra-54497279cc751.png",
  "lien": "https://fr.wikipedia.org/wiki/Ast%C3%A9rix_et_Ob%C3%A9lix_%3A_Mission_Cl%C3%A9op%C3%A2tre",
  "etape": "recherche"
 },
 "cinema-moderne|La Reine des neiges": {
  "slug": "cinema-moderne",
  "nom": "La Reine des neiges",
  "titre": "La Reine des neiges (film, 2013)",
  "extrait": "La Reine des neiges (Frozen) est le 128e long-métrage d'animation et le 53e « Classique d'animation » des studios Disney. Sorti en 2013 et réalisé par Chris Buck et Jennifer Lee, il est librement inspiré du conte éponyme de Hans Christian Andersen publié en 1844.\nIl raconte l'histoire de l'optimiste et intrépide princesse Anna, partie en voyage aux côtés de Kristoff le montagnard, de Sven, son fidèle renne, et d'un bonhomme de neige parlant nommé Olaf afin de retrouver sa sœur, Elsa, auto-exilée",
  "illustration": "https://upload.wikimedia.org/wikipedia/fr/2/28/La_Reine_des_neiges_%28film%2C_2013%29_Logo.png",
