 "tableaux-celebres|Les Joueurs de cartes": {
  "slug": "tableaux-celebres",
  "nom": "Les Joueurs de cartes",
  "titre": "Les Joueurs de cartes (Cézanne)",
  "extrait": "Les Joueurs de cartes est une série de peintures à l'huile de l'artiste postimpressionniste français Paul Cézanne, qui a produit plusieurs versions de ce thème. Peintes durant la dernière période de Cézanne au début des années 1890, la série comprend cinq tableaux, qui varient en taille, en nombre de joueurs et en environnement dans lequel le jeu se déroule. Au fur et à mesure que Cézanne traite le sujet, il en réduit le nombre jusqu'à aboutir à une composition à deux personnages dont le caractè",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/e5/Les_Joueurs_de_cartes_-_Paul_C%C3%A9zanne.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Les_Joueurs_de_cartes_%28C%C3%A9zanne%29",
  "etape": "titre qualifié"
 },
 "tableaux-celebres|Golconde": {
  "slug": "tableaux-celebres",
  "nom": "Golconde",
  "titre": "Golconde (Magritte)",
  "extrait": "Golconde est un tableau de René Magritte peint en 1953. Il en existe plusieurs versions dont l'une fait partie de la Menil Collection à Houston. Une esquisse de petite taille est l'une des nombreuses œuvres du legs Scutenaire-Hamoir aux musées royaux des Beaux-Arts de Belgique à Bruxelles.\nC'est un tableau surréaliste (80 x 100 cm) qui représente de manière répétée, quasiment obsédante et symétrique, un homme très impersonnel, un peu raide, qui « pleut » sur la ville représentée par de simples i",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Golconde_%28Magritte%29",
  "etape": "titre qualifié"
 },
 "tableaux-celebres|La Femme qui pleure": {
  "slug": "tableaux-celebres",
  "nom": "La Femme qui pleure",
  "titre": "La Femme qui pleure (Picasso)",
  "extrait": "La Femme qui pleure est une œuvre de Pablo Picasso datant de 1937. Il s'agit d'une huile sur toile de 59,5 cm par 49 cm représentant le portrait de Dora Maar, qui est alors sa maîtresse.\nLe tableau est reconnu comme étant l'un des témoignages de la violence contre les femmes de l'artiste.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/cb/La_mujer_que_llora_%28Femme_en_pleurs%29_de_Pablo_Picasso%2C_1937.jpg",
  "lien": "https://fr.wikipedia.org/wiki/La_Femme_qui_pleure_%28Picasso%29",
