{
 "sites-antiques|Ziggourat d'Our": {
  "slug": "sites-antiques",
  "nom": "Ziggourat d'Our",
  "titre": "Ziggurat d'Ur",
  "extrait": "La ziggurat d'Ur ou Grande Ziggurat d'Ur (en sumérien : é-temen-ní-gùru \"Etemenniguru\", signifiant quelque chose comme « Maison/Temple chargé(e) et represent une richesse pour les cité-État de splendeur » ou « qui suscite la crainte ») est une ziggurat érigée sous la troisième dynastie d'Ur dans la ville d'Ur près de Nassiriya, dans l'actuelle province de Dhi Qar, en Irak. Construite au début du XXIe siècle av. J.-C., elle est restaurée par le roi Nabonide de l'empire néo-babylonien au VIe siècl",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/6b/Ziggarat_of_Ur_001.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Ziggurat_d%27Ur",
  "etape": "tranché à la main"
 },
 "sites-antiques|Lascaux": {
  "slug": "sites-antiques",
  "nom": "Lascaux",
  "titre": "Grotte de Lascaux",
  "extrait": "La grotte de Lascaux, située dans la commune de Montignac-Lascaux dans le département français de la Dordogne en région Nouvelle-Aquitaine, dans la vallée de la Vézère, est l'une des plus importantes grottes ornées du Paléolithique supérieur par le nombre et la qualité esthétique de ses peintures et gravures, principalement des représentations d'animaux. Elle est parfois surnommée « la chapelle Sixtine de l'art pariétal », selon une expression attribuée à Henri Breuil, qui la nomme également « V",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/1e/Lascaux_painting.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Grotte_de_Lascaux",
  "etape": "tranché à la main"
 },
 "monuments-emblematiques|Palais des Papes": {
  "slug": "monuments-emblematiques",
  "nom": "Palais des Papes",
  "titre": "Palais des papes d'Avignon",
  "extrait": "Le palais des Papes d'Avignon est la plus grande des constructions gothiques du Moyen Âge.\nÀ la fois forteresse et palais, la résidence pontificale fut pendant le XIVe siècle le siège de la chrétienté d'Occident. Six conclaves se sont tenus dans le palais d'Avignon qui aboutirent à l'élection de Benoît XII, en 1335 ; de Clément VI, en 1342 ; d'Innocent VI, en 1352 ; d'Urbain V, en 1362 ; de Grégoire XI, en 1370, et de Benoît XIII, en 1394.\nLe palais, qui est l'imbrication de deux bâtiments, le p",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c3/MK53831-32_Palais_des_Papes_d%27Avignon.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Palais_des_papes_d%27Avignon",
  "etape": "tranché à la main"
 },
 "monuments-emblematiques|Temple d'Or d'Amritsar": {
  "slug": "monuments-emblematiques",
  "nom": "Temple d'Or d'Amritsar",
  "titre": "Harmandir Sahib",
  "extrait": "Le temple d'Or est le nom informel du Harmandir Sahib (pendjabi : ਹਰਿਮੰਦਰ ਸਾਹਿਬ ; signifiant « l'Illustre Temple de Dieu »), l'édifice le plus sacré des sikhs, situé au cœur de la ville d'Amritsar, au Pendjab, dans le nord-ouest de l'Inde. Le nom de « temple d'Or » est dû à sa couverture dorée.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/4d/Hamandir_Sahib_%28Golden_Temple%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Harmandir_Sahib",
  "etape": "tranché à la main"
 },
 "creatures-prehistoriques|Lion des cavernes": {
  "slug": "creatures-prehistoriques",
  "nom": "Lion des cavernes",
  "titre": "Lion des cavernes eurasiatique",
  "extrait": "Le lion des cavernes eurasiatique (Panthera spelaea) est une espèce disparue de grands félins du genre Panthera, qui peuplait l’Eurasie durant la seconde moitié du Pléistocène. Il regroupe plusieurs sous-espèces connues sous le nom de « lion des cavernes ».\nIl a été l'un des plus importants prédateurs du Pléistocène moyen et supérieur. Probablement originaire d'Afrique, ancêtre du lion (Panthera leo, Linnaeus), il s'est installé en Europe avant de s'étendre peu à peu vers l'Asie, puis l'Amérique",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/5/5a/European_cave_lion_%28Panthera_leo_spelaea%29_-_Mauricio_Ant%C3%B3n.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Lion_des_cavernes_eurasiatique",
  "etape": "tranché à la main"
 },
 "creatures-prehistoriques|Moa": {
  "slug": "creatures-prehistoriques",
  "nom": "Moa",
  "titre": "Dinornithiformes",
  "extrait": "Les Dinornithiformes sont un ordre fossile d'oiseaux coureurs aptères (sans ailes) de Nouvelle-Zélande. Dans la classification d'Howard et Moore, cet ordre est constitué de trois familles. Pour The Paleobiology Database, il n'est constitué que de la famille des Dinornithidae, à laquelle sont rattachées les espèces des familles des Emeidae et des Megalapterygidae. Ces oiseaux sont nommés moas en langue vernaculaire. Toutes les espèces de moas ont disparu après l'arrivée des ancêtres des Maoris da",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/2d/Giant_Haasts_eagle_attacking_New_Zealand_moa.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Dinornithiformes",
  "etape": "tranché à la main"
 },
 "grands-explorateurs|Ahmad ibn Fadlan": {
  "slug": "grands-explorateurs",
  "nom": "Ahmad ibn Fadlan",
  "titre": "Ibn Fadlân",
  "extrait": "Ahmad ibn-al-'Abbas ibn Rashid ibn-Hammad ibn-Fadlan, en arabe : أحمد ابن العباس ابن راشد ابن حماد ابن فضلان (’Aḥmad ’ibn ’al-ʿAbbās ’ibn Rāšid ’ibn Ḥammād ’ibn Faḍlān), est un lettré irakien du Xe siècle qui a laissé un récit de ses voyages comme membre de l’ambassade du Calife de Bagdad au roi des Proto-Bulgares de la Volga.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/b/b2/Ibn_Fadhlan_manuscript.jpg",
