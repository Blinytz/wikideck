 "oiseaux|Pigeon voyageur": {
  "slug": "oiseaux",
  "nom": "Pigeon voyageur",
  "titre": "Pigeon voyageur",
  "extrait": "Le pigeon voyageur est une variété d'oiseaux appartenant à l'espèce Pigeon biset (Columba livia), spécialement sélectionnée pour effectuer des voyages afin d'acheminer des messages.\nLes déplacements du pigeon voyageur ont constitué un moyen de communication courant et considéré comme très fiable jusqu'à la fin de la Première Guerre mondiale. Les éleveurs de cette race d'oiseaux sont nommés colombophiles et les messages envoyés, des colombogrammes.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/3/3a/Pigeons_voyageurs.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Pigeon_voyageur",
  "etape": "recherche"
 },
