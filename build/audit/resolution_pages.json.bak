 "grandes-batailles-historiques|Bataille de Tannenberg": {
  "slug": "grandes-batailles-historiques",
  "nom": "Bataille de Tannenberg",
  "titre": "Bataille de Tannenberg (1914)",
  "extrait": "La bataille de Tannenberg (aujourd'hui Stębark en Pologne), qui a lieu du 26 au 30 août 1914 dans les premières semaines de la Première Guerre mondiale, oppose l'armée impériale allemande (8e armée) à l'armée impériale russe (2e, puis 1re armée). \nElle s'achève par la victoire de l'armée allemande, commandée par Hindenburg et Ludendorff, entrainant l'arrêt de l'offensive russe dans la province de Prusse-Orientale. En revanche, sur le front de l'Ouest, l'offensive allemande en France est mise en ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/7a/Russian_prisoners_tannenberg.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Bataille_de_Tannenberg_%281914%29",
  "etape": "recherche"
 },
 "grandes-batailles-historiques|Bataille de la baie des Cochons": {
  "slug": "grandes-batailles-historiques",
  "nom": "Bataille de la baie des Cochons",
  "titre": "Débarquement de la baie des Cochons",
  "extrait": "Le débarquement de la baie des Cochons est une tentative d'invasion militaire de Cuba par des exilés cubains soutenus par les États-Unis en avril 1961. Planifiée sous l'administration de Dwight D. Eisenhower et organisée par la Central Intelligence Agency, l'opération est lancée au début du mandat de John F. Kennedy.\nElle vise à faire débarquer à Cuba, le 17 avril 1961, environ mille quatre cents exilés cubains recrutés et entraînés aux États-Unis par la CIA. L'objectif est de renverser le nouve",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/63/Attack_near_Playa_Giron._April_19%2C_1961._-_panoramio.jpg",
  "lien": "https://fr.wikipedia.org/wiki/D%C3%A9barquement_de_la_baie_des_Cochons",
  "etape": "recherche"
 },
 "grandes-guerres|Guerre d'Afghanistan (2001-2021)": {
  "slug": "grandes-guerres",
  "nom": "Guerre d'Afghanistan (2001-2021)",
  "titre": "Guerre d'Afghanistan (2001-2021)",
  "extrait": "La guerre d'Afghanistan oppose de 2001 à 2021 les États-Unis, avec la contribution militaire de l'Alliance du Nord et d'autres nations occidentales (Royaume-Uni, France, Canada, etc.), au régime taliban. Cette guerre s'inscrit dans la « guerre contre le terrorisme » déclarée par l'administration Bush à la suite des attentats du 11 septembre 2001 à New York et Washington. Le but de l'invasion selon les États-Unis et leurs alliés était de capturer Oussama ben Laden, détruire l'organisation Al-Qaïd",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f2/Collage_of_the_War_in_Afghanistan_%282001-2021%29.png",
  "lien": "https://fr.wikipedia.org/wiki/Guerre_d%27Afghanistan_%282001-2021%29",
  "etape": "recherche"
 },
 "creatures-prehistoriques|Pterodactylus": {
  "slug": "creatures-prehistoriques",
  "nom": "Pterodactylus",
  "titre": "Ptérodactyle",
  "extrait": "Le ptérodactyle (Pterodactylus, signifiant « doigt ailé ») est un genre fossile de ptérosaures ayant vécu de l'Angulata du Jurassique supérieur au Valanginien inférieur du Crétacé inférieur en Europe (et en Tanzanie), il y a environ 150 Ma (millions d'années).\nIl ne contient probablement qu'une seule espèce valide, Pterodactylus antiquus, la première espèce de ptérosaures à avoir été nommée et identifiée comme un « reptile volant ».",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/fc/Pterodactylus_kochi_1.JPG",
  "lien": "https://fr.wikipedia.org/wiki/Pt%C3%A9rodactyle",
  "etape": "recherche"
 },
 "creatures-prehistoriques|Pteranodon": {
  "slug": "creatures-prehistoriques",
  "nom": "Pteranodon",
  "titre": "Ptéranodon",
  "extrait": "Le ptéranodon (genre Pteranodon), du grec ancien πτερόν / pterón (« aile ») et ἀνόδων / an-  (« sans ») et odon (« dents ») est un genre fossile de ptérosaure ayant vécu au Crétacé supérieur, il y a entre 86 et 84,5 millions d’années.\n\n",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/1f/Pteranodon_longiceps_mmartyniuk_wiki.png",
  "lien": "https://fr.wikipedia.org/wiki/Pt%C3%A9ranodon",
