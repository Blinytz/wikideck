 "mythologie-nordique|Njörd": {
  "slug": "mythologie-nordique",
  "nom": "Njörd",
  "titre": "Njörd",
  "extrait": "Njörd (en proto-germanique : *Nerþuz) est une divinité nordique (groupe des vanes), dieu de la Mer et des Vents.\nIl apporte la bonne fortune en mer ainsi qu'une bonne pêche.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/9/9a/Njord_dieu_de_la_mer.jpg",
