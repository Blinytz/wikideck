 },
 "classiques-du-cinema|Vol au-dessus d'un nid de coucou": {
  "slug": "classiques-du-cinema",
  "nom": "Vol au-dessus d'un nid de coucou",
  "titre": "Vol au-dessus d'un nid de coucou",
  "extrait": "Vol au-dessus d’un nid de coucou (One Flew Over the Cuckoo's Nest) est un film américain réalisé par Miloš Forman, sorti en 1975.\nAdaptation du roman éponyme de Ken Kesey paru en 1962 (qui avait déjà fait l’objet d’une adaptation au théâtre à Broadway en 1963), le film est récompensé par les cinq principaux Oscars du cinéma, dont celui du meilleur film ainsi que par six Golden Globes.\nL’histoire est centrée sur R. P. McMurphy qui, en simulant la folie, se fait interner dans un hôpital psychiatri",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/6a/Vol_au-dessus_d%27un_nid_de_coucou_logo.svg",
  "lien": "https://fr.wikipedia.org/wiki/Vol_au-dessus_d%27un_nid_de_coucou",
  "etape": "titre du CSV"
 },
 "classiques-du-cinema|Il était une fois dans l'Ouest": {
  "slug": "classiques-du-cinema",
  "nom": "Il était une fois dans l'Ouest",
  "titre": "Il était une fois dans l'Ouest",
  "extrait": "Il était une fois dans l'Ouest (C'era una volta il West) est un western italo-américain de Sergio Leone réalisé en 1968, sorti en salle en Italie la même année et en 1969 dans le reste du monde.\nL'action du film se passe lors de la conquête de l'Ouest américain. Il évoque l'âpre rivalité pour l’appropriation de terres que traverse la construction du chemin de fer, et met en scène différents personnages représentatifs des westerns classiques pour mieux les détourner.\nL'actrice Claudia Cardinale j",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Il_%C3%A9tait_une_fois_dans_l%27Ouest",
  "etape": "titre du CSV"
 },
 "classiques-du-cinema|Le Septième Sceau": {
  "slug": "classiques-du-cinema",
  "nom": "Le Septième Sceau",
  "titre": "Le Septième Sceau",
  "extrait": "Le Septième Sceau (Det sjunde inseglet) est un film suédois d'Ingmar Bergman, sorti en 1957.\nLe film est considéré comme un classique du cinéma mondial (en), ainsi que l'un des plus grands films de tous les temps. Il a établi Bergman en tant que réalisateur de renommée mondiale, contenant des scènes qui sont devenues emblématiques grâce aux hommages, à l'analyse critique et aux parodies.",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Le_Septi%C3%A8me_Sceau",
  "etape": "titre du CSV"
 },
 "classiques-du-cinema|La Règle du jeu": {
  "slug": "classiques-du-cinema",
  "nom": "La Règle du jeu",
  "titre": "La Règle du jeu",
  "extrait": "La Règle du jeu est un film français écrit et réalisé par Jean Renoir, sorti en 1939.\nCe « drame gai » ou « fantaisie dramatique », pour reprendre l'expression du réalisateur, a pour ambition d'être une peinture de mœurs de l'aristocratie et de la grande bourgeoisie ainsi que des domestiques qui les servent, à la fin des années 1930. Jean Renoir porte sur le fonctionnement de cette société un regard hautement critique mais aussi résolument humaniste.\nLe film est désormais très largement considér",
  "illustration": "https://upload.wikimedia.org/wikipedia/fr/e/e7/La_R%C3%A8gle_du_jeu.png",
  "lien": "https://fr.wikipedia.org/wiki/La_R%C3%A8gle_du_jeu",
  "etape": "titre du CSV"
 },
 "classiques-du-cinema|Le Voleur de bicyclette": {
  "slug": "classiques-du-cinema",
  "nom": "Le Voleur de bicyclette",
  "titre": "Le Voleur de bicyclette",
  "extrait": "Le Voleur de bicyclette (en italien Ladri di biciclette, signifiant « Voleurs de bicyclettes ») est un film italien de Vittorio De Sica sorti en 1948. Le film retrace l'histoire d'un père de famille pauvre de l'immédiat après-guerre, en plein désarroi à la suite du vol de son outil de travail indispensable à la survie de sa jeune famille, sa bicyclette. Il est considéré comme un des chefs-d'œuvre du néoréalisme italien.\nAdaptation pour le cinéma par Cesare Zavattini du roman de Luigi Bartolini a",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/3/37/Ladri-biciclette.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Le_Voleur_de_bicyclette",
  "etape": "titre du CSV"
 },
 "classiques-du-cinema|Les Enfants du paradis": {
  "slug": "classiques-du-cinema",
  "nom": "Les Enfants du paradis",
  "titre": "Les Enfants du paradis",
  "extrait": "Les Enfants du paradis est un film français réalisé par Marcel Carné avec un scénario de Jacques Prévert, tourné en 1943-1944 et sorti en mars 1945.\nChef-d'œuvre du réalisme poétique, c'est l'une des rares superproductions françaises entreprises sous l'Occupation, qui bénéficie notamment de la présence d'Arletty, de Pierre Brasseur, de Jean-Louis Barrault et de Maria Casarès.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/2c/Les_enfants_du_Paradis.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Les_Enfants_du_paradis",
  "etape": "titre du CSV"
 },
 "classiques-du-cinema|Les Lumières de la ville": {
  "slug": "classiques-du-cinema",
  "nom": "Les Lumières de la ville",
  "titre": "Les Lumières de la ville",
  "extrait": "Les Lumières de la ville (City Lights) est une comédie dramatique américaine réalisée par Charlie Chaplin, sortie le 30 janvier 1931.\nIl s'agit du premier film sonore de Chaplin, mais qui, en l'absence de dialogues, comprend des intertitres. L'histoire commence par l'inauguration d'un monument dénommé « Paix et Prospérité » sur lequel dort un vagabond, donnant dès le début le ton à une fable moderne drôle et sarcastique avec, à la clef, un gigantesque pied de nez (visible de façon concrète à la ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/5/59/City_Lights_%281931_theatrical_poster%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Les_Lumi%C3%A8res_de_la_ville",
  "etape": "titre du CSV"
 },
 "classiques-du-cinema|Le Dictateur": {
  "slug": "classiques-du-cinema",
  "nom": "Le Dictateur",
  "titre": "Le Dictateur",
  "extrait": "Le Dictateur (The Great Dictator) est un film américain satirique réalisé par Charlie Chaplin, sorti en 1940. Il s'agit du premier film parlant du réalisateur.\nConçu avant la Seconde Guerre mondiale et sorti avant l'entrée en guerre des États-Unis, ce film est le plus grand succès commercial de Chaplin et contribue à mobiliser l'opinion publique nord-américaine (mars 1941 aux États-Unis) en faveur des démocraties européennes, à une époque où seul le Royaume-Uni résistait à l'Allemagne nazie.\nIl ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/9/9d/The_Great_Dictator_%281940%29_poster.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Le_Dictateur",
  "etape": "titre du CSV"
 },
 "classiques-du-cinema|M le maudit": {
  "slug": "classiques-du-cinema",
  "nom": "M le maudit",
  "titre": "M le maudit",
  "extrait": "M le maudit (M – Eine Stadt sucht einen Mörder) est un film allemand réalisé par Fritz Lang, sorti en 1931.\nIl s'agit du premier long métrage parlant du réalisateur. Inspiré notamment de l'affaire Peter Kürten et de quelques autres faits divers semblables, il montre les habitants d'une grande ville allemande jetés dans la terreur et l'hystérie par un meurtrier d'enfants, de sorte que la police et la pègre se mettent l'une et l'autre à sa poursuite.\nPlaidoyer nuancé contre la peine de mort, ce ch",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/e1/Wandmalerei_im_Tanzcafe_LiBella.jpg",
  "lien": "https://fr.wikipedia.org/wiki/M_le_maudit",
  "etape": "titre du CSV"
 },
 "classiques-du-cinema|Le Lauréat": {
  "slug": "classiques-du-cinema",
  "nom": "Le Lauréat",
  "titre": "Le Lauréat",
  "extrait": "Le Lauréat (The Graduate) est un film américain réalisé par Mike Nichols et sorti en 1967. Le scénario, écrit par Buck Henry et Calder Willingham, est adapté du roman de même titre de Charles Webb publié en 1963. Le film raconte l'histoire d'un étudiant de 21 ans, Benjamin Braddock (Dustin Hoffman), récemment diplômé de l'Université mais qui ne sait pas quoi faire de sa vie. Il est séduit (et en même temps victime de chantage) par une femme plus âgée que lui, Mme Robinson (Anne Bancroft), et tom",
  "illustration": "https://upload.wikimedia.org/wikipedia/fr/7/7e/Le_Laur%C3%A9at.png",
  "lien": "https://fr.wikipedia.org/wiki/Le_Laur%C3%A9at",
  "etape": "titre du CSV"
 },
 "classiques-du-cinema|Macadam Cowboy": {
  "slug": "classiques-du-cinema",
  "nom": "Macadam Cowboy",
  "titre": "Macadam Cowboy",
  "extrait": "Macadam Cowboy (titre original : Midnight Cowboy) est un film dramatique américain réalisé par John Schlesinger sorti en 1969.\nClassé X à sa sortie en salles par la commission de classification américaine en raison de ses scènes érotiques, il a été récompensé par trois Oscars en  1970 (dont celui du meilleur film, une première pour un film classé X), avant d'être finalement interdit aux moins de 17 ans en 1971.",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Macadam_Cowboy",
  "etape": "titre du CSV"
 },
 "classiques-du-cinema|Le Salaire de la peur": {
  "slug": "classiques-du-cinema",
  "nom": "Le Salaire de la peur",
  "titre": "Le Salaire de la peur",
  "extrait": "Le Salaire de la peur est un film franco-italien d'Henri-Georges Clouzot, sorti en 1953. C'est l'adaptation du roman du même nom de l'auteur Georges Arnaud (1949).\nAvec dans les rôles principaux les acteurs Yves Montand, Charles Vanel, Folco Lulli et Peter van Eyck, le film raconte l'aventure périlleuse de quatre chauffeurs de camion devant convoyer un chargement dangereux et hautement instable de nitroglycérine afin d'éteindre l'incendie d'un puits de pétrole.\nLe Salaire de la peur est le seul ",
  "illustration": "https://upload.wikimedia.org/wikipedia/fr/5/59/Le_Salaire_de_la_peur_Logo.png",
  "lien": "https://fr.wikipedia.org/wiki/Le_Salaire_de_la_peur",
  "etape": "titre du CSV"
 },
 "classiques-du-cinema|Les Tontons flingueurs": {
  "slug": "classiques-du-cinema",
  "nom": "Les Tontons flingueurs",
  "titre": "Les Tontons flingueurs",
  "extrait": "Les Tontons flingueurs est un film de gangsters franco-ouest-allemand-italien réalisé par Georges Lautner, sorti en 1963.\nCette adaptation du roman Grisbi or not grisbi (1955) d'Albert Simonin représente le dernier volet de la trilogie consacrée au truand Max le Menteur, précédée par le livre Touchez pas au grisbi ! et Le cave se rebiffe, tous deux également portés à l'écran en 1954 pour Touchez pas au grisbi et en 1961 pour Le cave se rebiffe. Toutefois, les adaptations cinématographiques sont ",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Les_Tontons_flingueurs",
  "etape": "titre du CSV"
 },
 "cinema-moderne|Cinema Paradiso": {
  "slug": "cinema-moderne",
  "nom": "Cinema Paradiso",
  "titre": "Cinema Paradiso",
  "extrait": "Cinema Paradiso (Nuovo Cinema Paradiso) est un drame italo-français co-écrit et réalisé par Giuseppe Tornatore, sorti en 1988.\nÀ Rome, à la fin des années 1980, Salvatore vient d'apprendre la mort de son vieil ami Alfredo. Par cette nouvelle, c'est toute son enfance qui remonte à la surface : son village natal, en Sicile, quand on l'appelait Totò et qu'il partageait son temps libre entre l'église (où il était enfant de chœur) et la salle de cinéma paroissiale, où régnait Alfredo, le projectionni",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/0e/%28c%29_Mondevane_%2851403421542%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Cinema_Paradiso",
