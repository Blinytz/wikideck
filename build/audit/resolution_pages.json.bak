  "etape": "titre du CSV"
 },
 "jeu-video-moderne|Vampire Survivors": {
  "slug": "jeu-video-moderne",
  "nom": "Vampire Survivors",
  "titre": "Vampire Survivors",
  "extrait": "Vampire Survivors est un jeu vidéo indépendant créé par Luca Galante. Le jeu inclut des éléments de jeu incrémental et de roguelike. Il est publié sur la plateforme Steam en 2021, où il est en accès anticipé jusqu'à la sortie de la version 1.0 le 20 octobre 2022. Le jeu sort également sur les consoles Xbox One et Xbox Series de Microsoft le 10 novembre 2022, ainsi que sur les téléphones Android et iOS depuis le 9 décembre 2022.\nIl remporte plusieurs prix relatifs à la qualité de son game design,",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/66/Garlic-filled_skeleton_at_Vampire_Survivors_booth_at_the_WASD_Gaming_Expo%2C_London_-_March_2023.jpg",
