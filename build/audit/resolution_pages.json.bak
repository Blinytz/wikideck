 "mythologies-oceanie-ameriques|Tangaroa": {
  "slug": "mythologies-oceanie-ameriques",
  "nom": "Tangaroa",
  "titre": "Tangaroa (mythologie)",
  "extrait": "Tangaroa (également appelé Ta'aroa, Tagaroa ou encore Tagaloa) est l'atua de la mer et des poissons dans la mythologie océanienne.\nSouvent vénéré comme un dieu de la mer, il représente, à Tahiti et sur d'autres archipels comme ceux de Samoa, des Tonga et des Tuvalu, le créateur de l'univers et de tous ses habitants. Selon la tradition maorie la plus courante, il serait le fils des divinités primordiales Rangi et Papa, respectivement le ciel père et la terre mère. Ailleurs, comme aux îles Cook, i",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/6a/Stone_sculpture%2C_Rarotonga%2C_Cook_Islands.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Tangaroa_%28mythologie%29",
  "etape": "titre qualifié"
 },
 "personnages-litterature|Hamlet": {
  "slug": "personnages-litterature",
  "nom": "Hamlet",
  "titre": "Hamlet (personnage)",
  "extrait": "Hamlet est un protagoniste et le rôle-titre de la tragédie de William Shakespeare Hamlet. Il est Prince de Danemark, neveu de Claudius et fils du Roi Hamlet (en) précédent roi de Danemark.\nAu début de la pièce, Hamlet lutte intérieurement pour savoir s'il doit, et de quelle manière, venger le meurtre de son père, ce qui met à l'épreuve sa propre santé mentale. À la fin de la tragédie, Hamlet a causé la mort de Polonius, de Laërte, de Claudius ainsi que de Rosencrantz et Guildenstern. Il est égal",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c2/Pedro_Am%C3%A9rico_-_Vis%C3%A3o_de_Hamlet.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Hamlet_%28personnage%29",
  "etape": "titre qualifié"
 },
 "personnages-cinema-serie|John Rambo": {
  "slug": "personnages-cinema-serie",
  "nom": "John Rambo",
  "titre": "John Rambo (personnage)",
  "extrait": "John James H. Rambo est un personnage de fiction créé par David Morrell dans le roman Rambo en 1972. Il est interprété au cinéma par Sylvester Stallone dans une série de cinq films. Noah Centineo reprend le rôle dans le film préquelle John Rambo.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/a0/John_Rambo.jpg",
  "lien": "https://fr.wikipedia.org/wiki/John_Rambo_%28personnage%29",
