 "auteurs-classiques|Henry Fielding": {
  "slug": "auteurs-classiques",
  "nom": "Henry Fielding",
  "titre": "Henry Fielding",
  "extrait": "Henry Fielding, né le 22 avril 1707 à Sharpham Park près de Glastonbury, dans le Somerset (Angleterre), et mort le 8 octobre 1754 à Lisbonne, est un dramaturge, poète, essayiste et romancier anglais.\nFielding fréquente le Collège d'Eton puis l'université de Leyde aux Pays-Bas comme étudiant en lettres.\nPendant de longues années, il se consacre au théâtre et ses pièces font bientôt de lui l'un des dramaturges les plus célèbres de la capitale britannique. C'est seulement en 1741 qu'il entre en fic",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/b/b9/Fielding.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Henry_Fielding",
  "etape": "titre du CSV"
 },
 "auteurs-classiques|Laurence Sterne": {
  "slug": "auteurs-classiques",
  "nom": "Laurence Sterne",
  "titre": "Laurence Sterne",
  "extrait": "Laurence Sterne (24 novembre 1713 Clonmel, Irlande - 18 mars 1768 Londres) est un écrivain et membre du clergé britannique. Ses œuvres les plus célèbres sont Vie et Opinions de Tristram Shandy, gentilhomme (The Life and Opinions of Tristram Shandy, Gentleman), et le Voyage sentimental à travers la France et l'Italie (A Sentimental Journey Through France and Italy). Sterne a également publié des sermons, écrit des mémoires et pris part à la vie politique locale. Il meurt à Londres après avoir lut",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/16/Laurence_Sterne_by_Sir_Joshua_Reynolds.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Laurence_Sterne",
  "etape": "titre du CSV"
 },
 "auteurs-classiques|Alphonse de Lamartine": {
  "slug": "auteurs-classiques",
  "nom": "Alphonse de Lamartine",
  "titre": "Alphonse de Lamartine",
  "extrait": "Alphonse de Lamartine, de son nom complet Alphonse Marie Louis de Prat de Lamartine, né le 21 octobre 1790 à Mâcon et mort le 28 février 1869 à Paris, est un poète, romancier, dramaturge, historien et homme politique français. Il est l'une des grandes figures du romantisme français. Il participe également à la révolution de 1848 et proclame la Deuxième République.\nIl passe son enfance en Bourgogne du sud, en particulier à Milly, qui nourrira son inspiration poétique, et étudie au collège à Lyon ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/db/Alphonse_de_Lamartine.PNG",
  "lien": "https://fr.wikipedia.org/wiki/Alphonse_de_Lamartine",
  "etape": "titre du CSV"
 },
 "auteurs-classiques|Alfred de Musset": {
  "slug": "auteurs-classiques",
  "nom": "Alfred de Musset",
  "titre": "Alfred de Musset",
  "extrait": "Alfred de Musset est un poète, dramaturge et écrivain français de la période romantique, né le 11 décembre 1810 à Paris, où il meurt le 2 mai 1857.\nIl fréquente les poètes du Cénacle de Charles Nodier et publie à 19 ans Contes d'Espagne et d'Italie, son premier recueil poétique. Il commence alors à mener une vie de « dandy débauché », marquée par sa liaison avec George Sand, tout en écrivant des pièces de théâtre : À quoi rêvent les jeunes filles en 1832, Les Caprices de Marianne en 1833, puis l",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/29/Landelle%2C_Charles_-_Alfred_de_Musset_-_Mus%C3%A9e_d%27Orsay.png",
  "lien": "https://fr.wikipedia.org/wiki/Alfred_de_Musset",
  "etape": "titre du CSV"
 },
 "auteurs-classiques|Alfred de Vigny": {
  "slug": "auteurs-classiques",
  "nom": "Alfred de Vigny",
  "titre": "Alfred de Vigny",
  "extrait": "Alfred Victor de Vigny, ou comte de Vigny, né le 27 mars 1797 à Loches et mort le 17 septembre 1863 à Paris 8e, est un écrivain, romancier, dramaturge et poète français.\nFigure influente du romantisme français, il écrit parallèlement à une carrière militaire entamée en 1814 et publie ses premiers poèmes en 1822. Avec la publication de Cinq-Mars en 1826, il contribue au développement du roman historique français. Ses traductions versifiées de Shakespeare s'inscrivent dans le drame romantique, de ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/1d/F%C3%A9lix_Nadar_1820-1910_Alfred_de_Vigny.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Alfred_de_Vigny",
  "etape": "titre du CSV"
 },
 "auteurs-classiques|Théophile Gautier": {
  "slug": "auteurs-classiques",
  "nom": "Théophile Gautier",
  "titre": "Théophile Gautier",
  "extrait": "Jules Pierre Théophile Gautier, né à Tarbes le 30 août 1811 et mort à Neuilly-sur-Seine le 23 octobre 1872, est un poète, romancier et critique d'art français.\nMembre actif de l'école littéraire dite du Parnasse, il est notamment l'auteur d’Émaux et Camées, de Mademoiselle de Maupin, du Roman de la momie et du Capitaine Fracasse.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/9/9c/Th%C3%A9ophile_Gautier_by_Nadar.png",
