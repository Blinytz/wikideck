 },
 "creatures-prehistoriques|Quetzalcoatlus": {
  "slug": "creatures-prehistoriques",
  "nom": "Quetzalcoatlus",
  "titre": "Quetzalcoatlus",
  "extrait": "Quetzalcoatlus est un genre fossile de ptérosaures de la famille des azhdarchidés. Il vivait à la fin du  Crétacé supérieur (Maastrichtien supérieur) en Amérique du Nord (Montana, Texas), il y a environ entre 70 et 66 Ma (millions d'années).\nL'espèce type décrite simultanément est Quetzalcoatlus northropi. Une seconde espèce, de plus petite taille, découverte au Texas, est décrite sous le nom Quetzalcoatlus lawsoni.\n\n",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/60/Gfp-quetzalcaotlus.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Quetzalcoatlus",
  "etape": "recherche"
 },
 "creatures-prehistoriques|Rhamphorhynchus": {
  "slug": "creatures-prehistoriques",
  "nom": "Rhamphorhynchus",
