 },
 "scientifiques-celebres|Alfred Russel Wallace": {
  "slug": "scientifiques-celebres",
  "nom": "Alfred Russel Wallace",
  "titre": "Alfred Russel Wallace",
  "extrait": "Alfred Russel Wallace (8 janvier 1823 – 7 novembre 1913) est un naturaliste, géographe, explorateur, anthropologue et biologiste britannique. Il a mis au point la théorie de l'évolution par la sélection naturelle au même moment que Charles Darwin.\nIl fit tout d'abord d'amples recherches sur le bassin fluvial de l'Amazone, puis dans l'archipel malais, où il identifia la ligne séparant la faune australienne de celle de l'Asie, qui fut appelée « ligne Wallace » en sa mémoire. Cependant il est plus ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/d4/Alfred-Russel-Wallace-c1895.jpg",
