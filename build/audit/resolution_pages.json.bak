 "aviateurs-celebres|Hubert Latham": {
  "slug": "aviateurs-celebres",
  "nom": "Hubert Latham",
  "titre": "Hubert Latham",
  "extrait": "Hubert Latham (Arthur Charles Hubert Latham) est un pionnier de l'aviation, titulaire du brevet de pilote no 9 en 1909, né à Paris 8e le 10 janvier 1883 et mort près de Fort-Archambault, actuel Sarh (Tchad), le 25 juin 1912.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/b/b6/Latham1large.jpg",
