 },
 "cinema-moderne|Avatar": {
  "slug": "cinema-moderne",
  "nom": "Avatar",
  "titre": "Avatar (film, 2009)",
  "extrait": "Avatar est un film de science-fiction américain réalisé par James Cameron, sorti en 2009. Il s'agit du premier film de la franchise cinématographique Avatar.\nL’action se déroule en 2154 sur Pandora, une des lunes de Polyphème, une planète géante gazeuse en orbite autour d'Alpha Centauri A dans le système stellaire le plus proche de la Terre. L’exolune, recouverte d’une jungle luxuriante, est le théâtre du choc entre les autochtones Na'vis et les Terriens. Les premiers vivent en parfaite symbiose",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f5/Avatar-Logo-avatar.svg",
