 },
 "personnages-animation|Rémy": {
  "slug": "personnages-animation",
  "nom": "Rémy",
  "titre": "Rémy (Ratatouille)",
  "extrait": "Rémy est un personnage de fiction, un rat d'égout apparaissant dans le film Ratatouille. Il est également le héros des jeux vidéo dérivés du film, comme Ratatouille ou Ratatouille : Cuisine en délire.\nRémy est interprété dans la version originale par Patton Oswalt, dans la version française par Guillaume Lebon et dans la version québécoise par Benoit Éthier.\nC'est un très jeune petit rat qui rêve de devenir un grand chef cuisinier, rêve difficile pour un animal de son espèce. Pourtant, son odora",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/cd/Remy_con_una_cuchara%2C_Greg_Dykstra.jpg",
  "lien": "https://fr.wikipedia.org/wiki/R%C3%A9my_%28Ratatouille%29",
  "etape": "titre qualifié"
 },
 "personnages-animation|Raiponce": {
  "slug": "personnages-animation",
  "nom": "Raiponce",
  "titre": "Raiponce (Disney)",
  "extrait": "La princesse Raiponce (Rapunzel en anglais et allemand) est un personnage de fiction inspiré par le personnage du conte Raiponce des frères Grimm. Elle apparut pour la première fois dans le long métrage d'animation Raiponce (Tangled), en 2010. Elle fait partie de la franchise Princesses Disney.\nLe prénom de la princesse vient de la fleur de la raiponce, tandis que ses grands yeux verts évoquent la curiosité.\nRaiponce possède des animaux dans Palace Pets.\nElle est présente dans un épisode de Prin",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/42/Raiponce_-_20150803_16h45_%2810812%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Raiponce_%28Disney%29",
