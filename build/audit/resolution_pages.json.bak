 "grands-peintres|John Singer Sargent": {
  "slug": "grands-peintres",
  "nom": "John Singer Sargent",
  "titre": "John Singer Sargent",
  "extrait": "John Singer Sargent, né le 12 janvier 1856 à Florence (grand-duché de Toscane), et mort le 14 avril 1925 à Londres (Royaume-Uni), est un peintre américain qui vécut essentiellement en Europe.\nÉlève de Carolus-Duran, de Léon Bonnat et d'Adolphe Yvon, il étudie à l'École des beaux-arts de Paris. Il est ami ou proche de grands artistes de l'époque, comme Claude Monet, Paul Helleu, Albert Besnard, Gabriel Fauré ou encore Edmund Gosse. Sargent est particulièrement connu pour son habileté dans les por",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/a5/John_Singer_Sargent_1903.jpg",
  "lien": "https://fr.wikipedia.org/wiki/John_Singer_Sargent",
  "etape": "titre du CSV"
 },
 "grands-peintres|Winslow Homer": {
  "slug": "grands-peintres",
  "nom": "Winslow Homer",
  "titre": "Winslow Homer",
  "extrait": "Winslow Homer (24 février 1836 - 29 septembre 1910) est un dessinateur, peintre, graveur et illustrateur américain, réputé pour ses marines et comme témoin objectif de son temps. En grande partie autodidacte, il est considéré comme l'un des principaux peintres du XIXe siècle américain et l'une des figures prééminentes du réalisme américain.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/8/8a/Winslow_Homer_by_Sarony.jpeg",
  "lien": "https://fr.wikipedia.org/wiki/Winslow_Homer",
  "etape": "titre du CSV"
 },
 "grands-peintres|Ilia Répine": {
  "slug": "grands-peintres",
  "nom": "Ilia Répine",
  "titre": "Ilia Répine",
  "extrait": "Ilia Iefimovitch Répine (en russe : Илья́ Ефи́мович Ре́пин, en ukrainien : Ілля Юхимович Рєпін) est un peintre russe d'origine ukrainienne né à Tchougouïev (en actuelle Ukraine) dans le gouvernement de Kharkov (Empire russe) le 24 juillet 1844 (5 août dans le calendrier grégorien) et mort le 29 septembre 1930 à Kuokkala (Finlande).\nIl travaille dans sa jeunesse comme peintre d'icônes, étudie le dessin avec Ivan Kramskoï, et poursuit sa formation à l'Académie impériale des beaux-arts à Saint-Péte",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/8/86/Ilya_Repin_%281909%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Ilia_R%C3%A9pine",
  "etape": "titre du CSV"
 },
 "grands-peintres|Ivan Aïvazovski": {
  "slug": "grands-peintres",
  "nom": "Ivan Aïvazovski",
  "titre": "Ivan Aïvazovski",
  "extrait": "Ivan Konstantinovitch Aïvazovski (en russe : Иван Константинович Айвазовский ; en arménien : Հովհաննես Այվազովսկի), né à Théodosie (gouvernement de Tauride) le 17 juillet 1817 (29 juillet dans le calendrier grégorien) et mort dans cette même ville le 5 mai 1900, est un peintre russe d'origine arménienne. C'est un des maîtres de la peinture de marine qui a marqué l'histoire et les périodes romantique et réaliste de l'art russe.\nDepuis 2018, l’aéroport international de Simferopol porte son nom.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c6/Aivazovsky_-_Self-portrait_1874.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Ivan_A%C3%AFvazovski",
  "etape": "titre du CSV"
 },
 "grands-peintres|Joaquín Sorolla": {
  "slug": "grands-peintres",
  "nom": "Joaquín Sorolla",
  "titre": "Joaquín Sorolla",
  "extrait": "Joaquín Sorolla y Bastida, né le 27 février 1863 à Valence et mort le 10 août 1923 à Cercedilla, est un peintre espagnol.\nSorolla est connu pour ses scènes de genre alliant réalisme et lyrisme ainsi que pour ses scènes de plage et sa maîtrise de la couleur blanche dont il use avec brio dans de nombreux tableaux. Son style a été qualifié d'impressionniste, de post-impressionniste ou encore de luministe.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/e8/Joaquin_Sorolla_by_Gertrude_K%C3%A4sebier%2C_1908.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Joaqu%C3%ADn_Sorolla",
  "etape": "titre du CSV"
 },
 "grands-peintres|Kazimir Malevitch": {
  "slug": "grands-peintres",
  "nom": "Kazimir Malevitch",
  "titre": "Kasimir Malevitch",
  "extrait": "Kasimir Severinovitch Malevitch (en ukrainien et russe : Казимир Северинович Малевич ; en polonais : Kazimierz Malewicz), né le 11 février 1879 (23 février dans le calendrier grégorien) à Kiev (Empire russe), de parents polonais, et mort le 15 mai 1935 à Léningrad, à l'âge de 56 ans, d'un cancer, est un des premiers artistes abstraits du XXe siècle. Peintre, dessinateur, sculpteur et théoricien, Malevitch est le créateur d'un courant artistique qu'il dénomma « suprématisme ».",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/63/Casimir_Malevich_photo.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Kasimir_Malevitch",
  "etape": "titre du CSV"
 },
 "grands-peintres|Giorgio de Chirico": {
  "slug": "grands-peintres",
  "nom": "Giorgio de Chirico",
  "titre": "Giorgio de Chirico",
  "extrait": "Giorgio de Chirico (prononcé : /ˈdʒɔr.dʒo de ki.ˈri.ko/), né le 10 juillet 1888 à Vólos en Thessalie (Grèce), et mort le 20 novembre 1978 à Rome (Italie), est un peintre, sculpteur et écrivain italien dont les œuvres, unanimement admirées des surréalistes jusqu'en 1925, ont ensuite été rejetées tout aussi unanimement. Il est l'un des fondateurs du mouvement de la peinture métaphysique.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/e4/Giorgio_de_Chirico_%28portrait%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Giorgio_de_Chirico",
  "etape": "titre du CSV"
 },
 "grands-peintres|Max Ernst": {
  "slug": "grands-peintres",
  "nom": "Max Ernst",
  "titre": "Max Ernst",
  "extrait": "Maximilian Maria Ernst, dit Max Ernst, né le 2 avril 1891 à Brühl dans l'Empire allemand et mort le 1er avril 1976 à Paris, est un peintre et sculpteur germano-américano-français dont l'œuvre se rattache aux mouvements dadaïste et surréaliste. Allemand de naissance, il acquiert la nationalité américaine en 1948 puis française en 1958.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/8/87/Max_Ernst_1968.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Max_Ernst",
  "etape": "titre du CSV"
 },
 "grands-peintres|Otto Dix": {
  "slug": "grands-peintres",
  "nom": "Otto Dix",
  "titre": "Otto Dix",
  "extrait": "Otto Dix [ˈɔto ˈdɪks] (Untermhaus, près de Gera, 2 décembre 1891 – Singen, 25 juillet 1969) est un peintre et graveur allemand associé aux mouvements de l'expressionnisme et la nouvelle objectivité, dont il est un des fondateurs.\n\n",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/20/Otto_Dix_by_Hugo_Erfurth%2C_c._1929.jpg",
