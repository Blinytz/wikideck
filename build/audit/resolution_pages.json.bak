 "personnages-jeu-video|Pac-Man": {
  "slug": "personnages-jeu-video",
  "nom": "Pac-Man",
  "titre": "Pac-Man",
  "extrait": "Pac-Man (パックマン, Pakkuman) (initialement intitulé Puckman) est un jeu vidéo créé par Tōru Iwatani pour l’entreprise japonaise Namco, sorti au Japon le 22 mai 1980. Le jeu consiste à déplacer Pac-Man, un personnage qui, vu de profil, ressemble à un diagramme circulaire à l’intérieur d’un labyrinthe, afin de lui faire manger toutes les pac-gommes qui s’y trouvent en évitant d’être touché par des fantômes.\nLorsque Pac-Man est sorti, les jeux vidéo d'arcade les plus populaires étaient les jeux de tir",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c0/Pac-Man_gameplay_%281x_pixel-perfect_recreation%29.png",
  "lien": "https://fr.wikipedia.org/wiki/Pac-Man",
  "etape": "titre du CSV"
 },
 "personnages-jeu-video|Sub-Zero": {
  "slug": "personnages-jeu-video",
  "nom": "Sub-Zero",
  "titre": "Sub-Zero",
  "extrait": "Sub-Zero est un personnage fictif de la série de jeu de combat Mortal Kombat. C'est en fait le nom de code pour deux personnages. Il s'agit tout d'abord de Bi-Han qui apparaît dans le premier Mortal Kombat sorti en 1992, et qui devient ensuite un mort-vivant sous le nom de Noob Saibot. Puis son frère, Kuai Liang, prend sa place à partir de Mortal Kombat II sorti en 1993. Sub-Zero est un combattant possédant la capacité de contrôler la glace sous de nombreuses formes.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/3/38/Sub-Zero_-_Sonya_Blade_-_X-23_%28cropped_Sub-Zero%29.jpg",
