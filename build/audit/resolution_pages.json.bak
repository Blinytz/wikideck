 "grands-peintres|Fernand Léger": {
  "slug": "grands-peintres",
  "nom": "Fernand Léger",
  "titre": "Fernand Léger",
  "extrait": "Fernand Léger, né le 4 février 1881 à Argentan (Orne) et mort le 17 août 1955 à Gif-sur-Yvette (Essonne), est un peintre français, aussi créateur de cartons de tapisseries et de vitraux, décorateur, céramiste, sculpteur, dessinateur et illustrateur.\nIl a été l’un des premiers à exposer publiquement des travaux d’orientation cubiste, même si on a parfois qualifié son style de « tubiste ».",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/06/Fernand_L%C3%A9ger.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Fernand_L%C3%A9ger",
  "etape": "titre du CSV"
 },
 "grands-peintres|Robert Delaunay": {
  "slug": "grands-peintres",
  "nom": "Robert Delaunay",
  "titre": "Robert Delaunay",
  "extrait": "Robert Delaunay est un peintre français né le 12 avril 1885 à Paris et mort le 25 octobre 1941 à Montpellier. Avec sa femme Sonia Delaunay et quelques autres moins impliqués, tels que František Kupka, Francis Picabia, Fernand Léger et Vassily Kandinsky, il est le fondateur et le principal artisan du mouvement  orphiste, nom inventé par Apollinaire et branche du cubisme, au début du XXe siècle. Ses travaux sur la couleur prennent pour origine plusieurs théories de la loi du contraste simultané de",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/fc/Robert_Delaunay%2C_Autoportrait_1905-1906.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Robert_Delaunay",
  "etape": "titre du CSV"
 },
 "grands-peintres|Sonia Delaunay": {
  "slug": "grands-peintres",
  "nom": "Sonia Delaunay",
  "titre": "Sonia Delaunay",
  "extrait": "Sonia Delaunay, née Sophie Stern ou bien Sara Illinichtna Stern le 14 novembre 1885 à Gradizhsk dans l'Empire russe et morte le 5 décembre 1979 à Paris, est une artiste peintre française d'origine ukrainienne.\nAdoptée par un oncle maternel, Henri Terk, dont elle prend le nom, elle étudie assez peu les beaux-arts : le dessin à Karlsruhe pendant deux ans, puis à Paris à l'Académie de la Palette dans le quartier du Montparnasse. Elle a été naturalisée française grâce à un premier mariage (blanc) av",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/15/Sonia_Delaunay_portrait_photograph.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Sonia_Delaunay",
  "etape": "titre du CSV"
 },
 "grands-peintres|Hilma af Klint": {
  "slug": "grands-peintres",
  "nom": "Hilma af Klint",
  "titre": "Hilma af Klint",
  "extrait": "Hilma af Klint, née le 26 octobre 1862 à Solna et morte le 21 octobre 1944 à Danderyd, est une peintre suédoise, théosophe et pionnière dans l'art abstrait.\nSes œuvres, riches en séries de tableaux entremêlant des motifs géométriques, des figures organiques, des symboles mystiques et parfois des lettres  — art cryptique qui semble anticiper le surréalisme, voire le psychédélisme des années 1970 —, comptent parmi les premières œuvres abstraites occidentales. Mais elles sont longtemps restées inco",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/d0/Hilma-af-Klint-uncropped.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Hilma_af_Klint",
  "etape": "titre du CSV"
 },
 "grands-peintres|Alphonse Mucha": {
  "slug": "grands-peintres",
  "nom": "Alphonse Mucha",
  "titre": "Alfons Mucha",
  "extrait": "Alfons Mucha (prononcé en tchèque : /ˈalfɔns ˈmuxa/), aussi orthographié Alphonse Mucha et Alphons Mucha, né à Eibenschütz (actuelle Ivančice) le 24 juillet 1860 et mort à Prague le 14 juillet 1939, est un affichiste, illustrateur, graphiste, peintre, architecte d'intérieur, décorateur et professeur d'art tchécoslovaque. Il est un représentant majeur du style Art nouveau.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/8/85/Alfons_Mucha_1901.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Alfons_Mucha",
  "etape": "titre du CSV"
 },
 "grands-peintres|Grant Wood": {
  "slug": "grands-peintres",
  "nom": "Grant Wood",
  "titre": "Grant Wood",
  "extrait": "Grant DeVolson Wood, né le 13 février 1891 à Anamosa dans l'Iowa et mort le 12 février 1942 à Iowa City, est un peintre américain. Il est surtout connu pour ses peintures réalistes de la vie rurale du Midwest. C'est l'une des figures principales de l'école régionaliste américaine qui se développe dans les années 1930.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/02/Grant_Wood.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Grant_Wood",
  "etape": "titre du CSV"
