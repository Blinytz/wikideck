 },
 "aviateurs-celebres|Saburō Sakai": {
  "slug": "aviateurs-celebres",
  "nom": "Saburō Sakai",
  "titre": "Saburō Sakai",
  "extrait": "Saburō Sakai (坂井 三郎, Sakai Saburō, 1916-2000) était un pilote de chasse de la marine impériale japonaise pendant la Seconde Guerre mondiale. Il fut, au nombre de victoires, le quatrième plus grand as de l'aéronavale nippone et le deuxième à survivre au conflit (derrière Tetsuzō Iwamoto). Il fait partie du « Trio des nettoyeurs » avec Toshio Ōta et Hiroyoshi Nishizawa.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/4d/Saburo_Sakai_in_A5M_Signed_1939.png",
  "lien": "https://fr.wikipedia.org/wiki/Sabur%C5%8D_Sakai",
  "etape": "titre du CSV"
 },
 "aviateurs-celebres|Pierre Clostermann": {
  "slug": "aviateurs-celebres",
  "nom": "Pierre Clostermann",
  "titre": "Pierre Clostermann",
  "extrait": "Pierre Clostermann, né le 28 février 1921 à Curitiba (Brésil) et mort le 22 mars 2006 à Montesquieu-des-Albères (Pyrénées-Orientales), est un aviateur français qui s'est distingué au cours de la Seconde Guerre mondiale.\nSurnommé « Premier chasseur de France », il est le plus grand as français de la Seconde Guerre mondiale avec 33 victoires aériennes homologuées et 5 probables, la plupart remportées contre des chasseurs ennemis.\nIl est fait compagnon de la Libération avant de devenir une personna",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c8/Pierre_Clostermann.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Pierre_Clostermann",
  "etape": "titre du CSV"
 },
 "aviateurs-celebres|Henri Guillaumet": {
  "slug": "aviateurs-celebres",
  "nom": "Henri Guillaumet",
  "titre": "Henri Guillaumet",
  "extrait": "Henri, Jules, Constant, Guillaumet (né le 29 mai 1902 à Bouy près de Châlons-en-Champagne et mort le 27 novembre 1940 au-dessus de la Méditerranée) est un aviateur français, pilote des Lignes Latécoère, puis Aéropostale et Air France. Il fait partie des plus grands pilotes civils pionniers de l'aviation française. En Espagne, au-dessus du Sahara espagnol, dans les Andes, par-dessus l'Atlantique Sud, puis l'Atlantique Nord, il contribue à la gloire des Lignes de l’Aéropostale, ainsi qu'à l'ouvert",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/ab/Brevet_de_pilote_Guillaumet.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Henri_Guillaumet",
  "etape": "titre du CSV"
 },
