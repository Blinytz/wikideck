 },
 "legendes-du-football|Uwe Seeler": {
  "slug": "legendes-du-football",
  "nom": "Uwe Seeler",
  "titre": "Uwe Seeler",
  "extrait": "Uwe Seeler, né le 5 novembre 1936 à Hambourg en Allemagne et mort le 21 juillet 2022 à Norderstedt, est un footballeur international allemand, qui évolue au poste d'attaquant pour le Hambourg SV et l'équipe d'Allemagne des années 1950 à 1970.\nSeeler effectue toute sa carrière au Hambourg SV pour qui il inscrit plus de 400 buts, malgré les sollicitations de l’Inter Milan ou du Real Madrid, qui lui promettaient des sommes folles. Il finira par rester dans sa ville chérie, auprès des siens. S’il ét",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/7d/Uwe_Seeler_%E2%80%93_Tag_der_Legenden_2016_03.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Uwe_Seeler",
