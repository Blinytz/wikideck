  "nom": "Eugène Ionesco",
  "titre": "Eugène Ionesco",
  "extrait": "Eugène Ionesco, né Eugen Dimitri Ionescu () le 26 novembre 1909 à Slatina (Roumanie) et mort le 28 mars 1994 à Paris (France), est un dramaturge et écrivain de langue française roumano-français.\nIl passe une grande partie de sa vie à voyager entre la France et la Roumanie ; représentant majeur du théâtre de l'absurde en France, il écrit de nombreuses œuvres dont les plus connues sont La Cantatrice chauve (1950), La Leçon (1951), Les Chaises (1952), Rhinocéros (1959) et Le roi se meurt (1962).",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/8/89/Eugene_Ionesco_01.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Eug%C3%A8ne_Ionesco",
  "etape": "titre du CSV"
 },
 "auteurs-modernes|Jean Genet": {
  "slug": "auteurs-modernes",
  "nom": "Jean Genet",
  "titre": "Jean Genet",
  "extrait": "Jean Genet, né le 19 décembre 1910 à Paris VIe arrondissement et mort le 14 avril 1986 à Paris XIIIe arrondissement, est un écrivain, poète et auteur dramatique français. Genet aborde notamment dans ses ouvrages l'homosexualité et l'érotisme, à travers la célébration de personnages ambivalents évoluant dans des mondes interlopes.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/e3/JeanGenet-HansKoechler1983-cropped.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Jean_Genet",
  "etape": "titre du CSV"
 },
 "auteurs-modernes|Nathalie Sarraute": {
  "slug": "auteurs-modernes",
  "nom": "Nathalie Sarraute",
  "titre": "Nathalie Sarraute",
  "extrait": "Nathalie Sarraute, née Natalia Ilinitchna Tcherniak le 18 juillet 1900 à Ivanovo-Voznessensk (Russie) et morte le 19 octobre 1999 à Paris 16e (France), est une femme de lettres française d'origine russe. Elle est l'une des figures du Nouveau roman à partir de la publication de L'Ère du soupçon en 1956.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f6/Nathalie_Sarraute_-_portrait_de_Fernand_Michaud_-_btv1b103295272.jpg",
