  "etape": "recherche"
 },
 "creatures-prehistoriques|Andrewsarchus": {
  "slug": "creatures-prehistoriques",
  "nom": "Andrewsarchus",
  "titre": "Andrewsarchus",
  "extrait": "Andrewsarchus est un genre fossile de mammifères artiodactyles, de la famille des Andrewsarchidae, rattachés au clade des Cetacodontamorpha, qui a vécu au cours de l’Éocène ( Luténien à Priabonien), dans ce qui est aujourd'hui la Mongolie-Intérieure, en République populaire de Chine, il y'a entre 48,20 et 37,71 millions d'années; \nJusqu'en 1977, une seule espèce est rattachée au genre, Andrewsarchus mongoliensis, date de la description de la nouvelle seconde espèce Andrewsarchus crassum.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/9/93/Andrewsarchus09DB.jpg",
