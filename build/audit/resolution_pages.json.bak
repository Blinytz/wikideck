 "creatures-prehistoriques|Glyptodon": {
  "slug": "creatures-prehistoriques",
  "nom": "Glyptodon",
  "titre": "Glyptodon",
  "extrait": "Le glyptodon, dont le nom signifie dents gravées, est un genre de tatous géants pesant jusqu'à 1,4 tonne qui vivait durant le Néogène en Amérique du Sud, sur une aire de répartition qui comprend le Brésil, l'Argentine et la Bolivie. Ce genre fait partie du super-ordre des Xenarthra (ex-édentés) et de l'ordre des Cingulata, mammifères placentaires apparus en Amérique du Sud.\nOn estime que le genre Glyptodon est apparu il y a environ 30 millions d'années et a disparu il y a environ 11 000 ans, apr",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/16/Queue_glyptodon_museum_dijo.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Glyptodon",
  "etape": "recherche"
 },
 "creatures-prehistoriques|Rhinocéros laineux": {
  "slug": "creatures-prehistoriques",
  "nom": "Rhinocéros laineux",
  "titre": "Rhinocéros laineux",
  "extrait": "Le rhinocéros laineux (Coelodonta antiquitatis), également connu sous le nom de rhinocéros à narines cloisonnées, était une espèce de rhinocéros de grande taille caractérisée par une épaisse toison laineuse (d'où son nom) qui le protégeait du froid des régions où il habitait, et par la présence de deux cornes sur son museau. Il habitait les steppes froides qui couvraient au Pléistocène une grande partie de l'Eurasie. À son apogée, il y a moins de 30 000 ans, on le trouvait depuis le centre de l'",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/ea/Wooly_Rhino15.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Rhinoc%C3%A9ros_laineux",
