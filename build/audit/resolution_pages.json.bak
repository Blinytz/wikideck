 },
 "personnages-bd-comics|Judge Dredd": {
  "slug": "personnages-bd-comics",
  "nom": "Judge Dredd",
  "titre": "Judge Dredd (bande dessinée)",
  "extrait": "Judge Dredd est un personnage de fiction de bande dessinée créé par le scénariste John Wagner et le dessinateur Carlos Ezquerra. Les aventures du personnage débutent en 1977 dans la revue britannique de science-fiction pour adultes 2000 AD ; par la suite le personnage apparaît dans la revue Judge Dredd Megazine (1990), dans une série qui lui est entièrement consacrée.\nDans la bande dessinée, l'officier de police Joseph « Joe » Dredd fait partie des forces de l'ordre de Mega-City One (en), une mé",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/fb/Judge_Dredd.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Judge_Dredd_%28bande_dessin%C3%A9e%29",
  "etape": "titre qualifié"
 },
 "personnages-bd-comics|Spirou": {
  "slug": "personnages-bd-comics",
  "nom": "Spirou",
  "titre": "Spirou (personnage)",
  "extrait": "Spirou est un personnage de fiction imaginé par l'éditeur belge Jean Dupuis, créé graphiquement par Rob-Vel — avec la collaboration du peintre Luc Lafnet — et, pour les textes, par Blanche Dumoulin dans le magazine de bande dessinée le Journal de Spirou en avril 1938.\nIl est le personnage principal de la série Spirou et Fantasio et personnage secondaire dans la série dérivée Gaston. Spirou avait déjà été utilisé sur certaines affiches réalisées par le dessinateur.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/a2/Charleroi_-_gare_du_Sud_-_Spirou_et_Spip_-_01.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Spirou_%28personnage%29",
  "etape": "titre qualifié"
 },
 "personnages-bd-comics|Fantasio": {
  "slug": "personnages-bd-comics",
  "nom": "Fantasio",
  "titre": "Fantasio (personnage)",
  "extrait": "Fantasio est un personnage principal de la série de bande dessinée Spirou et Fantasio, ainsi que des débuts de la série Gaston. Créé par Jean Doisy, son nom apparait dans le Le Journal de Spirou en 1939 en tant que rédacteur fictif. Son apparence graphique est définie par Jijé en 1943, lorsque celui-ci l'intègre aux aventures de Spirou.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/e5/Charleroi_-_station_Janson_-_Fantasio_-_01.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Fantasio_%28personnage%29",
  "etape": "titre qualifié"
 },
 "personnages-bd-comics|Iznogoud": {
  "slug": "personnages-bd-comics",
  "nom": "Iznogoud",
  "titre": "Iznogoud (personnage)",
  "extrait": "Iznogoud est le protagoniste éponyme de la série de bande dessinée du même nom. Il constitue le cas typique du antihéros comique : plein de défauts, ridicule et motivé par des intentions malsaines, il demeure cependant sympathique au lecteur, justement pour ses défauts.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/dd/Parc_Galiffe-02-Iznogoud.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Iznogoud_%28personnage%29",
  "etape": "titre qualifié"
 },
 "personnages-bd-comics|Garfield": {
  "slug": "personnages-bd-comics",
  "nom": "Garfield",
  "titre": "Garfield (personnage)",
  "extrait": "Garfield est un chat fictif, protagoniste issu du comic strip homonyme Garfield créé par Jim Davis et publié pour la première fois le 19 juin 1978 par United Feature Syndicate en syndication dans 41 journaux.\nCe personnage adore manger, dormir, embêter son maître Jon et son camarade le chien Odie. Il parle à travers les bulles de pensée et, même si d'autres animaux peuvent le comprendre, Jon n'y arrive généralement pas (bien que Jon ait ce qui ressemble à une conversation avec Garfield). Raremen",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/9/97/Garfield_screaming_%28Jon%2C_1977-07-28%29_%28cropped%2C_transparent%29.png",
  "lien": "https://fr.wikipedia.org/wiki/Garfield_%28personnage%29",
  "etape": "titre qualifié"
 },
 "personnages-jeu-video|Rayman": {
  "slug": "personnages-jeu-video",
  "nom": "Rayman",
  "titre": "Rayman (personnage)",
  "extrait": "Rayman est un personnage de jeu vidéo créé par Michel Ancel et Frédéric Houde pour Ubisoft. Il est l'éponyme d'une série de jeux depuis ses débuts en 1995. À partir de 2007 (à la sortie du jeu Rayman contre les lapins crétins qui était accompagné de spots de l'UNICEF), il devient un messager de l'UNICEF.\nL'origine de son nom serait potentiellement un hommage à Estle Ray Mann, l'un des deux créateurs des jeux vidéo.",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Rayman_%28personnage%29",
  "etape": "titre qualifié"
 },
 "personnages-jeu-video|Mega Man": {
