  "etape": "titre du CSV"
 },
 "personnages-jeu-video|Leon S. Kennedy": {
  "slug": "personnages-jeu-video",
  "nom": "Leon S. Kennedy",
  "titre": "Leon S. Kennedy",
  "extrait": "Leon Scott Kennedy (レオン・S・ケネディ, Reon Sukotto Kenedi), plus communément abrégé en Leon S. Kennedy est un personnage américain des jeux vidéo de la saga Resident Evil (« Biohazard » au Japon). Il est, chronologiquement, l'un des deux personnages principaux de Resident Evil 2, le personnage principal de Resident Evil 4, l'un des deux personnages principaux de Resident Evil: Degeneration, le personnage principal de Resident Evil: Damnation, l'un des trois personnages principaux de Resident Evil 6, e",
