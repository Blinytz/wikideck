 "mythologies-oceanie-ameriques|Rangi et Papa": {
  "slug": "mythologies-oceanie-ameriques",
  "nom": "Rangi et Papa",
  "titre": "Rangi et Papa",
  "extrait": "Le couple premier Rangi et Papa (ou Rangi-nui et Papatūānuku) apparaît dans le mythe de la création, expliquant les origines du monde dans la mythologie māori. Dans des dialectes de l'île du Sud, Rangi est appelé Raki ou Rakinui.\nD'autres mythologies peuvent remplacer le nom de Rangi par un autre nom, tel que Atea, Wākea, et Vatea.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/d7/WahineTane.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Rangi_et_Papa",
  "etape": "recherche"
 },
 "mythologies-oceanie-ameriques|Kanaloa": {
  "slug": "mythologies-oceanie-ameriques",
  "nom": "Kanaloa",
  "titre": "Kanaloa (divinité)",
  "extrait": "Kanaloa (en hawaïen Kēnūalāoa / Kanaloa) est le dieu hawaïen de la destruction, de la guérison, de la mort et des ténèbres, de la mer et de l'océan, et de la terre et des vents dans la mythologie hawaïenne. Il est le frère jumeau du dieu Kāne. Il est également connu sous le nom de Tangaroa en Nouvelle-Zélande. Il est l'un des plus grands dieux de toute la Polynésie. Cependant, sa position d'autorité et ses rôles varient d'un groupe d'îles à l'autre. Il était même vénéré par les autres Polynésien",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Kanaloa_%28divinit%C3%A9%29",
