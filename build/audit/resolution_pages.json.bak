 },
 "tableaux-celebres|Les Mangeurs de pommes de terre": {
  "slug": "tableaux-celebres",
  "nom": "Les Mangeurs de pommes de terre",
  "titre": "Les Mangeurs de pommes de terre",
  "extrait": "Les Mangeurs de pommes de terre (en néerlandais, De Aardappeleters) est un tableau de Vincent van Gogh peint en avril 1885 à Nuenen, aux Pays-Bas.\nD'abord confiée à Théo Van Gogh pour une éventuelle vente, cette huile sur toile fait partie de l'exposition permanente du musée van Gogh à Amsterdam. Le peintre y a consacré de nombreuses études préliminaires. Bien qu'il n'ait rien laissé à ce sujet, il a cherché systématiquement à renouveler la composition et l'expression :\n\n« Je sens tellement bien",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c6/De_aardappeleters_-_s0005V1962_-_Van_Gogh_Museum.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Les_Mangeurs_de_pommes_de_terre",
  "etape": "titre du CSV"
 },
 "tableaux-celebres|Le Café de nuit": {
  "slug": "tableaux-celebres",
  "nom": "Le Café de nuit",
  "titre": "Le Café de nuit",
  "extrait": "Le Café de nuit est une peinture réalisée à Arles, en septembre 1888, par le peintre néerlandais Vincent van Gogh. Son titre est inscrit en bas à droite sous la signature. Après avoir été la propriété du collectionneur russe Ivan Morozov, ce tableau fait désormais partie des collections de la Yale University Art Gallery à New Haven aux États-Unis.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/5/5e/Vincent_Willem_van_Gogh_076.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Le_Caf%C3%A9_de_nuit",
  "etape": "titre du CSV"
 },
 "tableaux-celebres|D'où venons-nous ? Que sommes-nous ? Où allons-nous ?": {
  "slug": "tableaux-celebres",
  "nom": "D'où venons-nous ? Que sommes-nous ? Où allons-nous ?",
  "titre": "D'où venons-nous ? Que sommes-nous ? Où allons-nous ?",
  "extrait": "D'où venons-nous ? Que sommes-nous ? Où allons-nous ? est une des œuvres les plus connues de Paul Gauguin. Peinte à Tahiti en 1897-1898, elle est conservée au musée des Beaux-Arts de Boston (Massachusetts, États-Unis).",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/0a/Gauguin_-_Where_Do_We_Come_From%3F_What_Are_We%3F_Where_Are_We_Going%3F_%281897-98%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/D%27o%C3%B9_venons-nous_%3F_Que_sommes-nous_%3F_O%C3%B9_allons-nous_%3F",
  "etape": "titre du CSV"
 },
 "tableaux-celebres|Carré noir sur fond blanc": {
  "slug": "tableaux-celebres",
  "nom": "Carré noir sur fond blanc",
  "titre": "Carré noir sur fond blanc",
  "extrait": "Le Quadrangle, appelé aussi Quadrilatère, ou Carré noir sur fond blanc, est une huile sur toile peinte par Kasimir Malevitch en 1915, à ne pas confondre avec Carré noir, une huile sur plâtre peinte en 1923-1930.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/d9/%D0%A7%D1%91%D1%80%D0%BD%D1%8B%D0%B9_%D1%81%D1%83%D0%BF%D1%80%D0%B5%D0%BC%D0%B0%D1%82%D0%B8%D1%87%D0%B5%D1%81%D0%BA%D0%B8%D0%B9_%D0%BA%D0%B2%D0%B0%D0%B4%D1%80%D0%B0%D1%82._1915._%D0%93%D0%A2%D0%93.png",
  "lien": "https://fr.wikipedia.org/wiki/Carr%C3%A9_noir_sur_fond_blanc",
  "etape": "titre du CSV"
 },
 "tableaux-celebres|La Trahison des images": {
  "slug": "tableaux-celebres",
  "nom": "La Trahison des images",
  "titre": "La Trahison des images",
  "extrait": "La Trahison des images est une peinture à l'huile sur toile , réalisée par René Magritte en 1928–1929. Elle est conservée au musée d'Art du comté de Los Angeles. Le tableau de 60,3 × 81,12 cm représente une pipe, accompagnée de la légende suivante : « Ceci n’est pas une pipe. ». L'intention la plus évidente de Magritte est de montrer que, même peinte de la manière la plus réaliste qui soit, une pipe représentée dans un tableau n’est pas une pipe. Elle ne reste qu’une image de pipe qu'on ne peut ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/06/Magritte_treachery.jpg",
  "lien": "https://fr.wikipedia.org/wiki/La_Trahison_des_images",
  "etape": "titre du CSV"
 },
 "tableaux-celebres|Marilyn Diptych": {
  "slug": "tableaux-celebres",
  "nom": "Marilyn Diptych",
  "titre": "Diptyque Marilyn",
  "extrait": "Diptyque Marilyn (en anglais : Marilyn Diptych) est une sérigraphie de l'artiste américain Andy Warhol, réalisée en 1962 .",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/ec/Monroe_in_Niagara_%281953_publicity_photo%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Diptyque_Marilyn",
