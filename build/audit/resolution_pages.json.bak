 },
 "personnages-manga-anime|Cell": {
  "slug": "personnages-manga-anime",
  "nom": "Cell",
  "titre": "Cell (Dragon Ball)",
  "extrait": "Cell (セル, Seru) est un personnage de fiction créé par Akira Toriyama dans le manga Dragon Ball. Il est également le second des trois antagonistes principaux de Dragon Ball Z, après Freezer et avant Majin Boo.\nIl fait ses débuts au chapitre 361 Le mystérieux monstre, enfin apparait !! (Nazo no Kaibutsu, Tsui ni Shutsugen !! ) , publié pour la première fois dans l'hebdomadaire Shōnen Jump du 16 février 1992. Cell est une forme de vie artificielle et maléfique, créée à l'aide des cellules de plusie",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/04/Cosplay_de_Cell_de_Dragon_Ball_%28Gl%C3%A9nat%29_%C3%A0_Japan_Expo_2014_%2814712825853%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Cell_%28Dragon_Ball%29",
  "etape": "titre qualifié"
 },
 "dieux-et-figures-mythologiques-grecques|Antigone": {
  "slug": "dieux-et-figures-mythologiques-grecques",
  "nom": "Antigone",
  "titre": "Antigone (Montpellier)",
  "extrait": "Antigone est un quartier de Montpellier conçu par l'architecte catalan Ricardo Bofill dès 1978 sous l'impulsion du maire de Montpellier Georges Frêche et de son adjoint, le géographe Raymond Dugrand, et construit à partir de 1983. La majorité des immeubles a été construite sur un style très librement inspiré par les formes architecturales de la Grèce antique selon le projet de l'architecte suivant un axe qui se veut faire écho à l'est à celui qui a structuré la ville à l'ouest, avec la promenade",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/ab/Antigone_District_%28191768335%29.jpeg",
  "lien": "https://fr.wikipedia.org/wiki/Antigone_%28Montpellier%29",
