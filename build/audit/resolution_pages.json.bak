 },
 "mythologies-africaines|Tanit": {
  "slug": "mythologies-africaines",
  "nom": "Tanit",
  "titre": "Tanit",
  "extrait": "Tanit ou Tinnit est une déesse principale de Carthage chargée d'agir en tant qu'intermédiaire entre Baal Hammon et les hommes. Elle était la déesse de la sagesse, de la civilisation et de l'artisanat ; elle est la protectrice des villes et des maisons où elle est vénérée. Les Phéniciens avaient l'habitude de mettre son signe sur les pierres tombales et les maisons pour demander la protection de Baal par son intermédiaire. \nSes temples principaux se trouvaient à Thinissut (Bir Bouregba, Tunisie),",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/61/Carthago_-_350-250_BC_-_silver_tetradrachm_-_head_of_Tanit_-_head_of_horse_and_date_palm_-_M%C3%BCnchen_SMS.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Tanit",
  "etape": "titre du CSV"
 },
 "mythologies-africaines|Anzar": {
  "slug": "mythologies-africaines",
  "nom": "Anzar",
  "titre": "Anzar",
  "extrait": "Anẓaṛ (en berbère : ⴰⵏⵥⴰⵕ) est un personnage de la mythologie berbère d'Afrique du Nord, personnalisation de la pluie. Le terme est devenu la dénomination de la pluie, attestée dans tous les dialectes berbères actuels, à l'exception du Touareg.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/d7/Poup%C3%A9e_d%27Anzar.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Anzar",
  "etape": "titre du CSV"
 },
 "mythologies-oceanie-ameriques|Māui": {
  "slug": "mythologies-oceanie-ameriques",
  "nom": "Māui",
  "titre": "Maui (mythologie)",
  "extrait": "Māui est l'un des grands héros de la littérature orale polynésienne. Les récits de ses exploits se retrouvent dans pratiquement toutes les îles polynésiennes, avec peu de variations de nom. Maui est généralement considéré comme un « demi-dieu » (atua, ce qui se traduit par dieu). À d'autres endroits, il est considéré comme un « ancêtre ».",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/a6/M%C4%81ui_Performer_Merrie_Monarch_Parade_DSC9524.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Maui_%28mythologie%29",
  "etape": "titre du CSV"
 },
 "mythologies-oceanie-ameriques|Tāne": {
  "slug": "mythologies-oceanie-ameriques",
  "nom": "Tāne",
  "titre": "Tāne",
  "extrait": "Tāne (également appelé Tāne-mahuta, Tāne-nui-a-Rangi, Tāne-te-waiora et plusieurs autres noms) est l'atua des forêts et des oiseaux, et le fils de Rangi et Papa, dans la mythologie maorie. Il fait partie, avec Rongo et Tūmatauenga, du trio des plus importants êtres tutélaires départementaux du mythe maori.\nÀ Tahiti, Tāne était le dieu de la paix et de la beauté.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f3/Carving_of_Tane_nui_a_Rangi%2C_at_Auckland_Zoo.jpg",
  "lien": "https://fr.wikipedia.org/wiki/T%C4%81ne",
  "etape": "titre du CSV"
 },
 "mythologies-oceanie-ameriques|Kāne": {
  "slug": "mythologies-oceanie-ameriques",
  "nom": "Kāne",
  "titre": "Kāne",
  "extrait": "Kāne est le dieu de la création dans la mythologie hawaïenne, vénéré comme l'ancêtre des chefs et des roturiers. Kāne est le créateur et donne la vie. Associé à l'aube, au soleil et au ciel, il est la plus importante des quatre principales divinités hawaïennes, avec Kanaloa, Kū et Lono, bien qu'il soit plus étroitement associé à Kanaloa.",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/K%C4%81ne",
  "etape": "titre du CSV"
 },
 "mythologies-oceanie-ameriques|Lono": {
  "slug": "mythologies-oceanie-ameriques",
  "nom": "Lono",
  "titre": "Lono",
  "extrait": "Lono est le dieu hawaïen de la fertilité et de la pluie à Hawaï.\nOn attribue la mort de James Cook au rite encadrant les mythes de Lono.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/b/b9/Figure_of_Lono-71.1879.10.11-DSC00191-black.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Lono",
