 "legendes-du-football|Stanley Matthews": {
  "slug": "legendes-du-football",
  "nom": "Stanley Matthews",
  "titre": "Stanley Matthews",
  "extrait": "Sir Stanley Matthews, né le 1er février 1915 à Hanley (Staffordshire) et mort le 23 février 2000 à Stoke-on-Trent (Staffordshire), est un footballeur international anglais reconverti entraîneur, parmi les plus célèbres de l'histoire de son pays.\nÉvoluant au poste d'ailier droit, il réalise sa carrière dans deux clubs modestes, Stoke City, l'équipe de sa ville natale, et Blackpool, avec lequel il remporte la Coupe d'Angleterre en 1953, le seul trophée collectif à son palmarès. Il compte par aille",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/ed/Stanley_Matthews_1962_%28crop%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Stanley_Matthews",
  "etape": "titre du CSV"
 },
 "legendes-du-football|Bobby Moore": {
  "slug": "legendes-du-football",
  "nom": "Bobby Moore",
  "titre": "Bobby Moore",
  "extrait": "Bobby Moore, de son nom complet Robert Frederick Chelsea Moore, né le 12 avril 1941 à Barking (Borough de Londres, Angleterre) et mort le 24 février 1993 à Wandsworth (Grand Londres, Angleterre), est un footballeur anglais.\nIl est considéré, avec Franz Beckenbauer, Paolo Maldini et Franco Baresi comme l'un des meilleurs défenseurs centraux de l'histoire du football.\nMalgré un modeste palmarès avec West Ham United, club auquel il reste fidèle pendant la majeure partie de sa carrière, Moore est co",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c6/Bobby_moore_elgrafico_1970.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Bobby_Moore",
  "etape": "titre du CSV"
 },
 "legendes-du-football|Gordon Banks": {
  "slug": "legendes-du-football",
  "nom": "Gordon Banks",
  "titre": "Gordon Banks",
  "extrait": "Gordon Banks, né le 30 décembre 1937 à Sheffield (Angleterre) et mort le 12 février 2019 à Stoke-on-Trent (Angleterre), est un footballeur international anglais qui évoluait au poste de gardien de but.\nC'est à ce poste et au sein de l'équipe d'Angleterre qu'il est victorieux à domicile de la Coupe du monde de 1966, et c'est dans l'édition suivante au Mexique de la Coupe du monde qu'il entre définitivement dans la postérité footballistique lors d'une confrontation Angleterre-Brésil, où il est l'a",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/a3/Gordon_Banks_2007.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Gordon_Banks",
  "etape": "titre du CSV"
 },
 "legendes-du-football|George Best": {
  "slug": "legendes-du-football",
  "nom": "George Best",
  "titre": "George Best",
  "extrait": "George Best, né le 22 mai 1946 à Belfast (Irlande du Nord) et mort le 25 novembre 2005 à Londres (Angleterre), est un footballeur international nord-irlandais. Il est considéré comme l'un des plus grands attaquants de l'histoire.\nÉvoluant aux postes d'avant-centre et d'ailier, George Best fait preuve d'une technique, d'une vivacité et d'un sens du dribble exceptionnels, qui en ont fait l'un des sportifs ayant le plus marqué les esprits britanniques par son génie, par sa vie et par son tempéramen",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/a5/George_best_1976.jpg",
  "lien": "https://fr.wikipedia.org/wiki/George_Best",
  "etape": "titre du CSV"
 },
 "legendes-du-football|Denis Law": {
  "slug": "legendes-du-football",
  "nom": "Denis Law",
  "titre": "Denis Law",
  "extrait": "Denis Law, né le 24 février 1940 à Aberdeen (Écosse) et mort le 17 janvier 2025 dans cette même ville, est un footballeur international écossais qui évolue au poste d'attaquant. Il est fait Commander of the Order of the British Empire en 2016.\nDenis Law commence sa carrière de footballeur au Huddersfield Town FC, club de Second Division. avant de signer à Manchester City pour la somme de 55 000 £, un record dans le football anglais. Après une saison chez les Citizens, le Torino FC achète les ser",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/d8/Denis_Law.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Denis_Law",
  "etape": "titre du CSV"
 },
 "legendes-du-football|Jimmy Greaves": {
  "slug": "legendes-du-football",
  "nom": "Jimmy Greaves",
  "titre": "Jimmy Greaves",
  "extrait": "James Peter Greaves, dit Jimmy Greaves, né le 20 février 1940 à Manor Park et mort le 19 septembre 2021, est un footballeur international anglais. Il est le meilleur buteur de l'histoire du championnat d'Angleterre avec 357 buts.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/6e/Jimmy_Greaves_at_Cheslea_FC_December_2011_%28crop%29.jpg",
