 "dinosaures-celebres|Majungasaurus": {
  "slug": "dinosaures-celebres",
  "nom": "Majungasaurus",
  "titre": "Majungasaurus",
  "extrait": "Majungasaurus (« lézard de Mahajanga »), anciennement Majungatholus, est un genre fossile de dinosaures du sous-ordre des théropodes et de la famille des abélisauridés qui a vécu à la fin du Crétacé supérieur à Madagascar il y a entre 70 et 66 millions d'années. Ce genre est resté monotypique et la seule espèce fossile connue est Majungasaurus crenatissimus.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/44/MajungatholusAtopus.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Majungasaurus",
  "etape": "titre du CSV"
