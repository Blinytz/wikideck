 },
 "personnages-animation|Bob l'éponge": {
  "slug": "personnages-animation",
  "nom": "Bob l'éponge",
  "titre": "Bob l'éponge (personnage)",
  "extrait": "Bob l'éponge (SpongeBob SquarePants), communément appelé Bob, est un personnage de la série télévisée d'animation du même nom. Il apparaît pour la première fois dans l'épisode intitulé Bienvenue à bord ! diffusé aux États-Unis le 1er mai 1999. Il est doublé dans la version originale par Tom Kenny et par Sébastien Desjours en français. Bob l'éponge est conçu et réalisé par le biologiste et animateur Stephen Hillenburg peu après l'annulation à l'antenne de sa série Rocko's Modern Life en 1996. À c",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/7a/SpongeBob_SquarePants_character.png",
  "lien": "https://fr.wikipedia.org/wiki/Bob_l%27%C3%A9ponge_%28personnage%29",
  "etape": "titre qualifié"
 },
 "personnages-animation|Popeye": {
  "slug": "personnages-animation",
  "nom": "Popeye",
  "titre": "Popeye (personnage)",
  "extrait": "Popeye (prononciation américaine : ˈpɑːpaɪ, Mathurin dans d'anciennes traductions françaises) est un personnage de fiction créé par l'Américain Elzie Crisler Segar en 1929 pour son comic strip The Thimble Theatre. Sa première apparition est dans la bande quotidienne du 17 janvier 1929. Marin fruste et susceptible mais généreux et loyal, doué d'une force extraordinaire, il est devenu l'un des personnages emblématiques de la culture populaire américaine à la suite des adaptations en dessin animé à",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/28/Popeye_el_marino.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Popeye_%28personnage%29",
  "etape": "titre qualifié"
 },
 "personnages-manga-anime|Guts": {
  "slug": "personnages-manga-anime",
  "nom": "Guts",
  "titre": "Guts (Berserk)",
  "extrait": "Guts (ガッツ, Gattsu) est le personnage principal du manga et de la série animée Berserk.\n\nEn anglais, guts signifie « tripes », « entrailles ». Ce nom fait référence aux circonstances impitoyables de sa naissance : extirpé des entrailles du cadavre de sa mère pendue à un arbre pour venir s'échouer dans une mare de sang et de chair avant d'être recueilli par Sys, la femme du chef d'un groupe de mercenaires. Ce nom fait également référence à une expression anglaise (to have guts, littéralement « avo",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Guts_%28Berserk%29",
  "etape": "titre qualifié"
 },
 "personnages-manga-anime|Griffith": {
  "slug": "personnages-manga-anime",
  "nom": "Griffith",
  "titre": "Griffith (Berserk)",
  "extrait": "Griffith (グリフィス, Gurifisu) est le principal antagoniste du manga et de la série animée Berserk. Il est présenté au début de la série comme un personnage principal et il deviendra peu à peu le meilleur ami du protagoniste de la série. Physiquement il est décrit par les personnages comme un bel homme  (même Guts finira par lui dire qu'il a une belle gueule d'amour, avant que Griffith ne le batte et ne le fasse rejoindre la Brigade des Faucons, la troupe dont il est le chef) avec des cheveux longs ",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Griffith_%28Berserk%29",
  "etape": "titre qualifié"
 },
 "personnages-manga-anime|Piccolo": {
  "slug": "personnages-manga-anime",
  "nom": "Piccolo",
  "titre": "Piccolo (Dragon Ball)",
  "extrait": "Piccolo (ピッコロ, Pikkoro), également connu sous les noms de Satan junior, Petit-Cœur ou sous le pseudonyme de Daemon Junior (マジュニア, Majunia, littéralement « Démon Junior »), est un personnage de fiction créé par Akira Toriyama dans le manga Dragon Ball en 1984. Il apparaît pour la première fois le 9 février 1988 dans le Weekly Shōnen Jump.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/d4/Cosplayer_of_Piccolo_from_Dragon_Ball_20090816.jpg",
