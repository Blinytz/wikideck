 },
 "monuments-emblematiques|Bouddha de Leshan": {
  "slug": "monuments-emblematiques",
  "nom": "Bouddha de Leshan",
  "titre": "Grand Bouddha de Leshan",
  "extrait": "Le Grand Bouddha de Leshan (chinois simplifié : 乐山大佛 ; chinois traditionnel : 樂山大佛 ; pinyin : lèshān dàfó) est une statue monumentale de Bouddha taillée dans la falaise du mont Lingyun (凌云山, língyún shān, « la montagne qui monte dans les nuages »), sur la rive est de la rivière Min dans la région du mont Emei, au Sichuan. Édifié approximativement entre 713 et 803, il doit son existence — dit la légende — à un moine bouddhiste qui souhaitait protéger les marins empruntant le périlleux confluent d",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/3/38/Leshan_Buddha_Statue_View.JPG",
  "lien": "https://fr.wikipedia.org/wiki/Grand_Bouddha_de_Leshan",
  "etape": "titre du CSV"
 },
 "monuments-emblematiques|Petronas Towers": {
  "slug": "monuments-emblematiques",
  "nom": "Petronas Towers",
  "titre": "Tours Petronas",
  "extrait": "Les tours Petronas à Kuala Lumpur en Malaisie sont deux tours jumelles qui ont été conçues par l'architecte argentin César Pelli. Inaugurées en 1998, elles comportent 88 étages pour une hauteur totale de 452 mètres, ce qui en fait les plus hautes tours jumelles du monde.\nUne passerelle d’acier accessible aux visiteurs relie les deux tours à 170 mètres du sol au niveau des 41e et 42e étages.\nEn plus des bureaux du géant pétrolier malais Petronas, cet édifice contient 1,7 million de mètres carrés ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/b/bc/Petronas_Towers_Logo.svg",
  "lien": "https://fr.wikipedia.org/wiki/Tours_Petronas",
  "etape": "titre du CSV"
 },
 "monuments-emblematiques|Taipei 101": {
  "slug": "monuments-emblematiques",
  "nom": "Taipei 101",
  "titre": "Taipei 101",
  "extrait": "Taipei 101 (chinois traditionnel : 臺北101 ; chinois simplifié : 台北101 ; pinyin : Táiběi 101), anciennement Centre financier international de Taipei, est un gratte-ciel localisé dans le district de Xinyi, Taipei à Taïwan. Haut de 508 m, il était le plus grand gratte-ciel du monde de 2004 à 2010, jusqu'à l'inauguration du Burj Khalifa (828 m). En juillet 2011, la tour a reçu la certification LEED Platinum, le plus grand prix du système de standardisation Leadership in Energy and Environmental Desig",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/0b/Taipei_101_logo.svg",
