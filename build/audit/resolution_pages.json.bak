 "corps-celestes|(90377) Sedna": {
  "slug": "corps-celestes",
  "nom": "(90377) Sedna",
  "titre": "(90377) Sedna",
  "extrait": "(90377) Sedna est un objet transneptunien du Système solaire d'un diamètre d'environ 1 000 kilomètres, ce qui en fait un candidat au statut de planète naine. En novembre 2013, sa distance au Soleil était d’environ 86,4 unités astronomiques (~12,9 milliards de kilomètres), près de trois fois celle de Neptune. Cette position, cependant, est près de son périhélie ; son aphélie de 960 au (144 milliards de kilomètres) fait de Sedna, pendant la plus grande partie de son orbite, un des objets connus du",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/02/Sedna_PRC2004-14d.jpg",
  "lien": "https://fr.wikipedia.org/wiki/%2890377%29_Sedna",
  "etape": "recherche"
 },
 "dieux-et-figures-mythologiques-grecques|Les Muses": {
  "slug": "dieux-et-figures-mythologiques-grecques",
  "nom": "Les Muses",
  "titre": "Les Muses",
  "extrait": "Les Muses est un tableau du peintre français Maurice Denis réalisé en 1893. Cette huile sur toile représente les neuf Muses de la mythologie grecque vêtues de façon moderne, et sans leurs attributs habituels, alors qu'elles se livrent à plusieurs conversations dans un sous-bois. Précédée d'au moins une esquisse aujourd'hui conservée au musée Léon-Dierx de Saint-Denis, à La Réunion, l'œuvre est révélée au public au Salon des indépendants. Propriété d'Arthur Fontaine jusqu'à sa mort au début des a",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/ee/Les_Muses%2C_par_Maurice_Denis.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Les_Muses",
  "etape": "recherche"
 },
 "dieux-et-figures-mythologiques-grecques|Hélène de Troie": {
  "slug": "dieux-et-figures-mythologiques-grecques",
  "nom": "Hélène de Troie",
  "titre": "Hélène de Troie (Rossetti)",
  "extrait": "Hélène de Troie – en anglais Helen of Troy – est un tableau réalisé en 1863 par le peintre britannique Dante Gabriel Rossetti, un artiste préraphaélite. De format vertical, cette peinture à l'huile exécutée sur acajou est une peinture mythologique qui représente Hélène de Troie à la manière d'un portrait en buste. L'œuvre est conservée depuis 1921 à la Kunsthalle de Hambourg, à Hambourg, en Allemagne.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/65/Dante_Gabriel_Rossetti_-_Helen_of_Troy.jpg",
  "lien": "https://fr.wikipedia.org/wiki/H%C3%A9l%C3%A8ne_de_Troie_%28Rossetti%29",
  "etape": "recherche"
 },
 "dieux-et-figures-mythologiques-grecques|Sirène (mythologie grecque)": {
  "slug": "dieux-et-figures-mythologiques-grecques",
  "nom": "Sirène (mythologie grecque)",
  "titre": "Sirène (mythologie grecque)",
  "extrait": "Dans la mythologie grecque, les sirènes (en grec ancien : Σειρήν (Seirḗn), en latin : Sīrēn) sont des créatures fantastiques marines. Elles sont souvent dépeintes comme des chimères mi-femmes mi-oiseaux, à la différence des sirènes nordiques, créatures mi-femmes mi-poissons.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/9/99/Odysseus_Sirens_BM_E440_n2.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Sir%C3%A8ne_%28mythologie_grecque%29",
  "etape": "recherche"
 },
 "dirigeants-contemporains|Guillaume II": {
