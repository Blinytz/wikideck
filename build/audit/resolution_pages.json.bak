  "etape": "titre du CSV"
 },
 "aviateurs-celebres|Gabriel Voisin": {
  "slug": "aviateurs-celebres",
  "nom": "Gabriel Voisin",
  "titre": "Gabriel Voisin",
  "extrait": "Gabriel Voisin, né le 5 février 1880 à Belleville-sur-Saône et mort le 25 décembre 1973 à Ozenay, est l'un des plus célèbres pionniers français de l'aéronautique, tant civile que militaire, ainsi qu'un fabricant d'automobiles de luxe à la marque « Avions Voisin ».\nFils et petit-fils de fondeurs des côtés paternel et maternel, Gabriel Voisin fait ses études au lycée Ampère puis à l'école des Beaux-Arts de Lyon. Parallèlement à ses cours aux Beaux-Arts, il travaille comme dessinateur industriel da",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/68/GabrielVoisin.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Gabriel_Voisin",
  "etape": "titre du CSV"
 },
 "aviateurs-celebres|Adolphe Pégoud": {
  "slug": "aviateurs-celebres",
  "nom": "Adolphe Pégoud",
  "titre": "Adolphe Pégoud",
  "extrait": "Célestin Adolphe Pégoud, né à Montferrat (Isère) le 13 juin 1889 et mort à Petit-Croix (Territoire de Belfort) le 31 août 1915, est un aviateur français de la Première Guerre mondiale.",
