 },
 "souverains-et-conquerants|Marc Aurèle": {
  "slug": "souverains-et-conquerants",
  "nom": "Marc Aurèle",
  "titre": "Marc Aurèle",
  "extrait": "Marc Aurèle (en latin : Marcus Aurelius), né le 26 avril 121 à Rome et mort le 17 mars 180 à Sirmium ou à Vindobona, est un empereur et philosophe romain de la dynastie des Antonins, consul en 140, 145 et 161, régnant de 161 à 180.\nDernier des « cinq bons empereurs » selon Machiavel, il est aussi le dernier empereur de la période de la « paix romaine », période de relative stabilité commencée sous le règne d'Auguste (27 av. J.-C. à 14), succédant à la période des guerres civiles (49 à 30 av. J.-",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/8/80/MSR-ra-61-b-1-DM_%28cropped%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Marc_Aur%C3%A8le",
