  "etape": "titre du CSV"
 },
 "legendes-du-football|Nílton Santos": {
  "slug": "legendes-du-football",
  "nom": "Nílton Santos",
  "titre": "Nílton Santos",
  "extrait": "Nílton Reis dos Santos est un footballeur de nationalité brésilienne, né le 16 mai 1925 à Rio de Janeiro et mort le 27 novembre 2013 dans la même ville.\nSurnommé a Enciclopédia (en français : « l'Encyclopédie ») pour ses connaissances en football (dans le domaine de la tactique notamment), cet arrière gauche offensif remporte avec l'équipe du Brésil la coupe du monde de 1958 puis celle de 1962. Il révolutionne la position d'arrière latéral gauche, en utilisant sa polyvalence pour défendre et att",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/b/bb/Nilton_Santos_-_2004.jpg",
  "lien": "https://fr.wikipedia.org/wiki/N%C3%ADlton_Santos",
