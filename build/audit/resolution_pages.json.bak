 "corps-celestes|Aldébaran": {
  "slug": "corps-celestes",
  "nom": "Aldébaran",
  "titre": "Aldébaran",
  "extrait": "Aldébaran, ou Alpha Tauri (α Tauri / α Tau) dans la désignation de Bayer, est l'étoile la plus brillante de la constellation zodiacale du Taureau. Il s'agit d'une géante rouge, une étoile plus froide mais beaucoup plus grande et lumineuse que le Soleil, qui est située à environ 66 années-lumière du Soleil. Avec une magnitude apparente moyenne de +0,87, elle est la 13e étoile la plus brillante du ciel nocturne. Sa magnitude absolue est de −0,65.\nVisuellement, Aldébaran semble le membre le plus br",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/4c/Aldebaran.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Ald%C3%A9baran",
  "etape": "titre du CSV"
 },
 "corps-celestes|Arcturus": {
  "slug": "corps-celestes",
  "nom": "Arcturus",
  "titre": "Arcturus",
  "extrait": "Arcturus (α Bootis selon la désignation de Bayer) est l'étoile la plus brillante de la constellation du Bouvier. C'est une étoile de type géante rouge, en fin de vie.\n\nLe diamètre d'Arcturus est de 25 fois celui du Soleil, sa magnitude apparente est de -0,05 et sa distance au Soleil est de 36,7 années-lumière. En prolongeant la queue de la Grande Ourse, on repère facilement cette étoile brillante et orangée. Elle constitue avec Spica et Régulus le Triangle du printemps.\nArcturus est une étoile â",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/9/95/Redgiants_fr.svg",
  "lien": "https://fr.wikipedia.org/wiki/Arcturus",
  "etape": "titre du CSV"
 },
 "corps-celestes|Deneb": {
  "slug": "corps-celestes",
  "nom": "Deneb",
  "titre": "Deneb",
  "extrait": "Deneb ou Alpha Cygni (α Cyg) est une étoile supergéante blanche variable, l'étoile la plus brillante de la constellation du Cygne et la dix-neuvième étoile la plus brillante du ciel (magnitude apparente 1,25). Avec Véga et Altaïr, Deneb forme le triangle d'été, une formation d'étoiles très brillantes bien visibles en été dans le ciel nocturne. La nébuleuse de l'Amérique du Nord (NGC 7000) se trouve à proximité.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/cc/Cygnus_constellation_map.png",
  "lien": "https://fr.wikipedia.org/wiki/Deneb",
  "etape": "titre du CSV"
 },
 "corps-celestes|Altaïr": {
  "slug": "corps-celestes",
  "nom": "Altaïr",
  "titre": "Altaïr",
  "extrait": "Altaïr, également connue par sa désignation de Bayer Alpha Aquilae (α Aquilae / α Aql), est l'étoile la plus brillante de la constellation de l'Aigle. De magnitude apparente 0,76, elle est la douzième étoile la plus brillante de la voûte céleste. Située à environ 17 années-lumière de la Terre, elle est aussi l'une des étoiles les plus proches visibles à l'œil nu.\n\n",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/69/Altair.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Alta%C3%AFr",
  "etape": "titre du CSV"
