 "monuments-emblematiques|Capitole des États-Unis": {
  "slug": "monuments-emblematiques",
  "nom": "Capitole des États-Unis",
  "titre": "Capitole des États-Unis",
  "extrait": "Le Capitole des États-Unis (en anglais : United States Capitol) est le bâtiment qui sert de siège au Congrès, le pouvoir législatif des États-Unis. Il est situé dans la capitale fédérale, Washington, D.C. La construction de style néoclassique commence en 1793 et s'achève en 1812. Il est constitué d'un dôme et de deux ailes. L’aile nord est le siège du Sénat et l’aile sud est celle de la Chambre des représentants.\nLe bâtiment est dessiné à l'origine par William Thornton. Ses plans furent ensuite ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/a3/United_States_Capitol_west_front_edit2.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Capitole_des_%C3%89tats-Unis",
  "etape": "titre du CSV"
 },
 "monuments-emblematiques|Harbour Bridge": {
  "slug": "monuments-emblematiques",
  "nom": "Harbour Bridge",
  "titre": "Harbour Bridge",
  "extrait": "Le Harbour Bridge (littéralement le « pont du Port »), ou pont de Sydney, est un pont en arc métallique situé dans la ville de Sydney, en Australie. Il est le principal point de traversée de la baie de Sydney, permettant le passage des trains, automobiles, cyclistes et piétons entre le quartier des affaires et la rive nord de la baie. La vue du pont et de l’opéra, tout proche, est emblématique de la ville et de l’Australie entière. Il a été construit par John Bradfield et fut inauguré en 1932.\nL",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Harbour_Bridge",
  "etape": "titre du CSV"
 },
 "empires-et-civilisations|Sumer": {
  "slug": "empires-et-civilisations",
  "nom": "Sumer",
  "titre": "Sumer",
  "extrait": "Sumer est une région antique, située à l'extrême sud de la Mésopotamie antique (actuel Irak), couvrant une vaste plaine parcourue par le Tigre et l'Euphrate, bordée, au sud-est, par le golfe Persique. Il s'y est développé une importante civilisation de l'Antiquité, à compter de la fin du IVe millénaire av. J.-C. et durant le IIIe millénaire av. J.-C.\nLa langue dominante y était le sumérien, langue d'origine indéterminée qui n'a aucune parenté connue. Les locuteurs de cette langue, majoritairemen",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/da/Basse_Mesopotamie_DA.PNG",
  "lien": "https://fr.wikipedia.org/wiki/Sumer",
  "etape": "titre du CSV"
 },
 "empires-et-civilisations|Empire d'Akkad": {
  "slug": "empires-et-civilisations",
  "nom": "Empire d'Akkad",
  "titre": "Empire d'Akkad",
  "extrait": "L’empire d'Akkad, parfois appelé Empire akkadien ou royaume d'Akkad (on trouve aussi Agadé), est un État fondé par Sargon d'Akkad et qui domina la Mésopotamie de la fin du XXIVe au début du XXIIe siècle av. J.-C., selon la chronologie la plus couramment retenue, même s'il est possible qu'il se soit épanoui environ un siècle plus tard, les datations étant incertaines pour une période aussi lointaine.\nPrenant le pouvoir à Kish, Sargon parvient rapidement à dominer le Sud mésopotamien, qu'il dirige",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/3/37/Empire_akkad.svg",
