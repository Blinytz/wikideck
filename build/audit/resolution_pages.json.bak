 },
 "grands-peintres|Camille Corot": {
  "slug": "grands-peintres",
  "nom": "Camille Corot",
  "titre": "Camille Corot",
  "extrait": "Jean-Baptiste Camille Corot, également appelé Camille Corot, né le 16 juillet 1796 à Paris où il est mort le 22 février 1875, est un peintre et graveur français, un des fondateurs de l'école de Barbizon.\nIssu d'une famille de commerçants aisés, il est autorisé en 1822 à embrasser la carrière de peintre, bénéficiant d'une rente familiale qui lui permet jusqu'à la mort de ses parents de vivre sans contrainte économique et de voyager en France et en Italie, où il séjourne à trois reprises. Il passe",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/ed/Camille_Corot-Nadar_corrected.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Camille_Corot",
  "etape": "titre du CSV"
 },
 "grands-peintres|Jean-François Millet": {
  "slug": "grands-peintres",
  "nom": "Jean-François Millet",
  "titre": "Jean-François Millet",
  "extrait": "Jean-François Millet (prononcé [mi'lɛ], Mi-lè), né le 4 octobre 1814 au hameau de Gruchy et mort le 20 janvier 1875 à Barbizon, est un artiste-peintre réaliste, pastelliste, graveur et dessinateur français du XIXe siècle, l’un des fondateurs de l’école de Barbizon. Il est célèbre notamment pour ses scènes champêtres et paysannes.\n\n",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/47/Jean-FrancoisMillet%28Nadar%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Jean-Fran%C3%A7ois_Millet",
