 },
 "mythologie-nordique|Ratatosk": {
  "slug": "mythologie-nordique",
  "nom": "Ratatosk",
  "titre": "Ratatosk",
  "extrait": "Dans le mythe scandinave du frêne Yggdrasil de la mythologie nordique, l'écureuil Ratatosk va et vient sans cesse entre le serpent Nídhögg, qui dévore la racine de l'arbre cosmique et Veðrfölnir  qui survole celui-ci. Il rapporte les paroles haineuses du serpent à l'aigle, et vice-versa. Car, du temps qu'il entretiendra la haine entre Nídhögg et Veðrfölnir, il ne les craindra plus jamais.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/b/ba/AM_738_4to_Ratatoskr.png",
  "lien": "https://fr.wikipedia.org/wiki/Ratatosk",
  "etape": "titre du CSV"
 },
 "mythologie-egyptienne|Nout": {
  "slug": "mythologie-egyptienne",
  "nom": "Nout",
  "titre": "Nout",
  "extrait": "Nout est une déesse de la mythologie égyptienne qui fait partie de la grande Ennéade d'Héliopolis. Déesse du ciel, Nout symbolise le firmament et fut considérée comme la mère de tous les astres.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/fb/Geb_end_Nut01.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Nout",
  "etape": "titre du CSV"
 },
 "mythologie-egyptienne|Geb": {
  "slug": "mythologie-egyptienne",
  "nom": "Geb",
  "titre": "Geb",
  "extrait": "Geb est le dieu de la Terre dans la mythologie égyptienne qui fait partie de la grande Ennéade d'Héliopolis. Il est le fils de Shou (dieu de l'air) et de Tefnout (déesse de l'eau), mais aussi le frère et l'époux de Nout (la déesse du ciel).",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/04/Djedkhonsuifeankh.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Geb",
  "etape": "titre du CSV"
 },
 "mythologie-egyptienne|Shou": {
  "slug": "mythologie-egyptienne",
  "nom": "Shou",
  "titre": "Shou",
  "extrait": "Shou (en grec ancien Σῶς / Sỗs ou Σῶσις / Sỗsis) est un dieu de la mythologie égyptienne qui fait partie de la grande Ennéade d'Héliopolis.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/e1/Shu_with_feather.svg",
