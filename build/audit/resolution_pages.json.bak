 },
 "tableaux-celebres|Whaam!": {
  "slug": "tableaux-celebres",
  "nom": "Whaam!",
  "titre": "Whaam!",
  "extrait": "Whaam! (littéralement « vlan ! » en français) est un tableau de l'artiste américain Roy Lichtenstein.\nCe maître du pop art est devenu célèbre grâce à des publicités ou images populaires qu'il a repeintes ou redessinées. C'est le cas de Whaam! qui est une adaptation du comic-book All American Men of War (datant de 1962). Le double tableau reprend les codes de la bande dessinée, avec la présence d'une bulle, d'aplats et d'une trame pointilliste. Lichtenstein a utilisé le magna, une sorte de peintu",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c3/Roy_Lichtenstein_%281967%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Whaam%21",
  "etape": "titre du CSV"
 },
 "tableaux-celebres|Drowning Girl": {
  "slug": "tableaux-celebres",
  "nom": "Drowning Girl",
  "titre": "Drowning Girl",
  "extrait": "Drowning Girl (aussi connu sous le nom de I Don't Care! I'd Rather Sink) est un tableau de Roy Lichtenstein de 1963, basé sur une œuvre originale de Tony Abruzzo. Le tableau est considéré comme l'une des principales œuvres de Roy Lichtenstein avec Look Mickey et Whaam!. Peinture représentative du mouvement pop art, Drowning Girl est acquise par le Museum of Modern Art de New York en 1971.\nUtilisant la peinture à l'huile et la peinture acrylique sur toile, le tableau s'inspire d'une case d'une ba",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Drowning_Girl",
  "etape": "titre du CSV"
 },
 "tableaux-celebres|Autoportrait au collier d'épines": {
  "slug": "tableaux-celebres",
  "nom": "Autoportrait au collier d'épines",
  "titre": "Autoportrait au collier d'épines et colibri",
  "extrait": "Autoportrait au collier d'épines et colibri (espagnol : Autorretrato con collar de espinas y colibrí) est une peinture à l'huile sur toile de 61,25 × 47 cm réalisée en 1940 par Frida Kahlo.",
