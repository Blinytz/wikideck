 },
 "legendes-du-football|Rivelino": {
  "slug": "legendes-du-football",
  "nom": "Rivelino",
  "titre": "Rivelino",
  "extrait": "Roberto Rivelino , né le 1er janvier 1946 à São Paulo (Brésil), est un footballeur international brésilien. Il évolue comme meneur de jeu du milieu des années 1960 au début des années 1980. On le reconnait facilement grâce à sa moustache caractéristique. Considéré comme l'un des meilleurs joueurs brésiliens de l'histoire, il bénéficie d'une notoriété moindre en Europe, n'y jouant que quelques matchs internationaux.\nDoté d'une technique supérieure à la moyenne avec son pied gauche, Rivelino est c",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/5/53/Roberto_Rivelino_1974b.jpg",
