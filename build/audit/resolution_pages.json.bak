 "personnages-bd-comics|Silver Surfer": {
  "slug": "personnages-bd-comics",
  "nom": "Silver Surfer",
  "titre": "Surfer d'argent",
  "extrait": "Norrin Radd, alias le Surfer d’argent (« The Silver Surfer » en version originale) est un super-héros évoluant dans l'univers Marvel de la maison d'édition Marvel Comics. Créé par le dessinateur Jack Kirby, le personnage de fiction apparaît pour la première fois dans le comic book Fantastic Four #48 en mars 1966.\nLe Surfer d’argent est un humanoïde à la peau métallique argentée qui peut voyager dans l'espace à l'aide de son engin semblable à une planche de surf. À l'origine, jeune astronome nomm",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/b/b7/SilverSurferCosplaySDComicConJuly2014.JPG",
  "lien": "https://fr.wikipedia.org/wiki/Surfer_d%27argent",
  "etape": "titre du CSV"
 },
 "personnages-bd-comics|Galactus": {
  "slug": "personnages-bd-comics",
  "nom": "Galactus",
  "titre": "Galactus",
  "extrait": "Galactus est une entité cosmique évoluant dans l'univers Marvel de la maison d'édition Marvel Comics. Créé par le scénariste Stan Lee et le dessinateur Jack Kirby, le personnage de fiction apparaît pour la première fois dans le comic book Fantastic Four #48 en mars 1966.\nLors de sa première apparition dans Les Quatre Fantastiques, Galactus est dépeint comme un personnage semblable à un dieu qui se nourrit en drainant l'énergie des planètes vivantes. Après être apparu dans l'Âge d'argent des comi",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/a9/SDCC_2012_-_Galactus_arrives_%287580532742%29.jpg",
