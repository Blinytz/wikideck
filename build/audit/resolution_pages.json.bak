  "etape": "recherche"
 },
 "creatures-prehistoriques|Dunkleosteus": {
  "slug": "creatures-prehistoriques",
  "nom": "Dunkleosteus",
  "titre": "Dunkleosteus",
  "extrait": "Dunkleosteus (littéralement, « os de Dunkle (en) ») est un genre fossile de grands Placodermes arthrodires ayant vécu durant le Dévonien supérieur (382-358 millions d'années). De nombreux fossiles ont été découverts en Amérique du Nord, en Pologne, en Belgique et au Maroc.\nLe genre comprend une dizaine d'espèces, dont certaines figurent parmi les plus grands Placodermes connus. La taille de D. terrelli a longtemps été surestimée avec une taille maximale estimée à 9 m de long pour un poids de 4 t",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/20/Dunkleosteus_%2815677042802%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Dunkleosteus",
  "etape": "recherche"
 },
 "creatures-prehistoriques|Helicoprion": {
  "slug": "creatures-prehistoriques",
  "nom": "Helicoprion",
  "titre": "Helicoprion",
  "extrait": "Helicoprion est un genre fossile de grands poissons cartilagineux ayant vécu durant une importante partie du Permien, de l'Artinskien jusqu'au Roadien, entre 290 et 270 millions d'années avant notre ère. Souvent présenté à tort comme un requin, Helicoprion appartient en réalité aux eugénéodontes, un ordre éteint de poissons cartilagineux rattaché au clade des holocéphales, groupe aujourd’hui uniquement représenté par les chimères. Il s'agit également du genre type des Helicoprionidae, une famill",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/b/be/Helicoprion_tooth_whorl.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Helicoprion",
  "etape": "recherche"
 },
