 },
 "monuments-emblematiques|Grand-Place de Bruxelles": {
  "slug": "monuments-emblematiques",
  "nom": "Grand-Place de Bruxelles",
  "titre": "Grand-Place de Bruxelles",
  "extrait": "La Grand-Place, Grand Place ou Grand'Place est la place centrale de la ville belge de Bruxelles. Elle est également appelée Grote Markt en néerlandais et Gruute Met en bruxellois.\nMondialement renommée pour sa richesse ornementale, elle est bordée par les Maisons des Corporations, l'hôtel de ville et la Maison du Roi (Broodhuis en néerlandais). Victor Hugo la considérait comme l'une des plus belles places du monde. Elle a été inscrite en 1998 sur la liste du patrimoine mondial de l'UNESCO.\nLieu ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/ae/Grand_Place_Bruselas_2.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Grand-Place_de_Bruxelles",
