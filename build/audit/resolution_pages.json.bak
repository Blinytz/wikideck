 },
 "auteurs-modernes|Boris Pasternak": {
  "slug": "auteurs-modernes",
  "nom": "Boris Pasternak",
  "titre": "Boris Pasternak",
  "extrait": "Boris Leonidovitch Pasternak (en russe : Борис Леонидович Пастернак, /bɐˈrʲis lʲɪɐˈnʲidəvʲɪtɕ pəstɨrˈnak/ ), né le 10 février 1890 (22 février dans le calendrier grégorien) à Moscou et mort le 30 mai 1960 à Peredelkino, près de Moscou, est un poète, traducteur et romancier russe, lauréat du prix Nobel de littérature en 1958, prix qu'il est contraint de décliner.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/5/55/Boris_Pasternak_1958_photo.jpg",
