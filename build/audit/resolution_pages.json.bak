 "empires-et-civilisations|Empire carolingien": {
  "slug": "empires-et-civilisations",
  "nom": "Empire carolingien",
  "titre": "Empire carolingien",
  "extrait": "L'Empire carolingien est le résultat de l'expansion territoriale du royaume franc sous l'influence de la dynastie carolingienne pendant le haut Moyen Âge. Il s'étend de l'Europe occidentale à l'Europe centrale.\nAmorcé par Pépin le Bref, premier souverain de cette deuxième dynastie des rois de France (la première étant celle des Mérovingiens), il doit cependant son nom à son fils, Carolus Magnus ou Charlemagne, couronné empereur par le pape Léon III en 800.\nCet Empire franc est partagé entre les ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/66/Francia_814.svg",
  "lien": "https://fr.wikipedia.org/wiki/Empire_carolingien",
  "etape": "titre du CSV"
 },
 "empires-et-civilisations|Rus' de Kiev": {
