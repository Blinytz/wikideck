 "grands-peintres|Piero della Francesca": {
  "slug": "grands-peintres",
  "nom": "Piero della Francesca",
  "titre": "Piero della Francesca",
  "extrait": "Piero della Francesca, de son nom complet Piero di Benedetto de Franceschi ou encore Pietro Borghese, né entre 1412 et 1420 à Borgo San Sepolcro (aujourd'hui Sansepolcro) dans la haute vallée du Tibre en république de Florence et mort dans la même ville le 12 octobre 1492, est un artiste peintre et un mathématicien florentin du Quattrocento (XVe siècle italien).\nIl est vu surtout comme un peintre, mais à son époque il était aussi connu comme géomètre et mathématicien, maître de la perspective et",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/7c/Piero_della_Francesca_The_Resurrection_detail_VlRan.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Piero_della_Francesca",
  "etape": "titre du CSV"
 },
 "grands-peintres|Andrea Mantegna": {
  "slug": "grands-peintres",
  "nom": "Andrea Mantegna",
  "titre": "Andrea Mantegna",
  "extrait": "Andrea Mantegna, né vers 1431 à l'Isola di Carturo et mort le 13 septembre 1506 à Mantoue, est un graveur et peintre italien de la Première Renaissance qui a rompu définitivement avec le style gothique en plein milieu du XVe siècle, sans se départir de cette attitude tout au long de sa vie.\nMarqué par l'héritage gréco-romain, exploitant la perspective par ses recherches sur le raccourci, il innove en matière d'architecture feinte, avec des décors muraux, des voûtes, créant des scènes d'une grand",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/42/Mantegna_Bronze_Bust_San_Andrea_Mantua.png",
  "lien": "https://fr.wikipedia.org/wiki/Andrea_Mantegna",
  "etape": "titre du CSV"
 },
 "grands-peintres|Giorgione": {
  "slug": "grands-peintres",
  "nom": "Giorgione",
  "titre": "Giorgione",
  "extrait": "Giorgio Barbarelli ou Zorzi da Vedelago ou da Castelfranco, dit Giorgione, né en 1477 à Vedelago ou Castelfranco Veneto et mort en 1510 à Venise, est le premier grand peintre vénitien du Cinquecento et de la Haute Renaissance.\nIl n'a vécu que 32 ans. Il était cependant l'un des peintres les plus célèbres à Venise, de son vivant. La plupart de ses tableaux ont été commandés par les premiers collectionneurs et le contexte intellectuel de ces personnalités cultivées, aujourd'hui mal connu, rend ces",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/4c/Giorgione_059.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Giorgione",
  "etape": "titre du CSV"
 },
 "grands-peintres|Le Tintoret": {
  "slug": "grands-peintres",
  "nom": "Le Tintoret",
  "titre": "Le Tintoret",
  "extrait": "Jacopo Robusti, dit Tintoretto, en français le Tintoret, né probablement en septembre-octobre 1518 à Venise (République de Venise) où il est mort le 31 mai 1594, est un peintre vénitien de la Renaissance italienne, que l'on associe au mouvement artistique du maniérisme de l'école vénitienne, qu'il a également influencée de manière significative.\nSes contemporains admiraient et critiquaient à la fois la rapidité avec laquelle il peignait et l'audace sans précédent de son coup de pinceau. Pour son",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f8/Jacopo_Tintoretto_-_Self-Portrait_-_WGA22672.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Le_Tintoret",
  "etape": "titre du CSV"
 },
 "grands-peintres|Véronèse": {
  "slug": "grands-peintres",
  "nom": "Véronèse",
  "titre": "Paul Véronèse",
  "extrait": "Paolo Caliari, dit Véronèse, né en 1528 à Vérone et mort le 19 avril 1588 à Venise, est un peintre vénitien. \nBien qu'il ait joui d'une réelle popularité de son vivant, notamment à Venise, il fut ignoré des critiques de son temps qui parlent de l’art vénitien, seul Francesco Sansovino parle de lui dans son Guide de 1556. Pourtant, Véronèse constituait avec Titien et le Tintoret le triumvirat des peintres vénitiens de la Renaissance tardive. \nVéronèse est connu comme un grand coloriste ainsi que ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c8/Paolo_Veronese%2C_avtoportret.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Paul_V%C3%A9ron%C3%A8se",
  "etape": "titre du CSV"
 },
 "grands-peintres|Georges de La Tour": {
  "slug": "grands-peintres",
  "nom": "Georges de La Tour",
  "titre": "Georges de La Tour",
  "extrait": "Georges de La Tour, né et baptisé le 14 mars 1593 à Vic-sur-Seille et mort le 30 janvier 1652 à Lunéville, est un peintre lorrain.\nArtiste au confluent des cultures nordique, italienne et française, contemporain de Jacques Callot et des frères Le Nain, La Tour est un observateur pénétrant de la réalité quotidienne. Son goût prononcé pour les jeux d'ombres et de lumières fait de lui l'un des continuateurs les plus originaux du Caravage.\nReconnu de son vivant, il est rapidement oublié après sa mor",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f3/Saint_Joseph_charpentier_%28La_Tour%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Georges_de_La_Tour",
  "etape": "titre du CSV"
 },
 "grands-peintres|Jean Siméon Chardin": {
  "slug": "grands-peintres",
  "nom": "Jean Siméon Chardin",
  "titre": "Jean Siméon Chardin",
  "extrait": "Jean Siméon Chardin, né le 2 novembre 1699 à Paris et mort dans la même ville le 6 décembre 1779, est considéré comme l'un des plus grands peintres français et européens du XVIIIe siècle. Il est surtout reconnu pour ses natures mortes, ses peintures de genre et ses pastels.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/7c/Chardin_pastel_selfportrait.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Jean_Sim%C3%A9on_Chardin",
