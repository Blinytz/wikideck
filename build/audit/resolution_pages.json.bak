  "etape": "titre du CSV"
 },
 "mythologies-africaines|Unkulunkulu": {
  "slug": "mythologies-africaines",
  "nom": "Unkulunkulu",
  "titre": "Unkulunkulu",
  "extrait": "Unkulunkulu (/uɲɠulun’ɠulu/) (qui signifie \"le très beau\" en Isizulu) est le dieu créateur des Zoulous.",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Unkulunkulu",
