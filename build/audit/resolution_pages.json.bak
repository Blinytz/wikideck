 },
 "mythologies-oceanie-ameriques|Kū": {
  "slug": "mythologies-oceanie-ameriques",
  "nom": "Kū",
  "titre": "Kū",
  "extrait": "Kū ou Kū-ka-ili-moku est le dieu de la guerre de la mythologie hawaïenne. Avec Kanaloa, Kāne et Lono, il fait partie des quatre divinités les plus importantes des Hawaïens. Il est l'époux de la déesse Hina.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/2a/Kuka%27ilimoku.jpg",
  "lien": "https://fr.wikipedia.org/wiki/K%C5%AB",
