 "auteurs-classiques|Lope de Vega": {
  "slug": "auteurs-classiques",
  "nom": "Lope de Vega",
  "titre": "Lope de Vega",
  "extrait": "Félix Lope de Vega Carpio, dit Lope de Vega , né le 25 novembre 1562 à Madrid et mort le 27 août 1635 dans la même ville, est un dramaturge et poète espagnol. Il est considéré comme l'un des écrivains majeurs du Siècle d'or espagnol.\nSurnommé par Miguel de Cervantes « le Phénix, le monstre de la nature », il est le fondateur de la Comedia nueva ou tragi-comédie à l'espagnole à un moment où le théâtre devenait un phénomène culturel de masse.\nLope de Vega a été un auteur extrêmement prolifique : i",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/79/LopedeVega.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Lope_de_Vega",
  "etape": "titre du CSV"
 },
 "auteurs-classiques|Calderón de la Barca": {
  "slug": "auteurs-classiques",
  "nom": "Calderón de la Barca",
  "titre": "Pedro Calderón de la Barca",
  "extrait": "Pedro Calderón de la Barca, né à Madrid le 17 janvier 1600 et mort à Madrid le 25 mai 1681, est un poète et dramaturge espagnol. Auteur de plus de deux cents textes dramatiques, il est en particulier connu pour sa pièce La vie est un songe (1635).",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/fa/Las_Glorias_Nacionales%2C_1852_%22D._Pedro_Calder%C3%B3n_de_la_Barca%22_%284013195639%29.jpg",
