 },
 "personnages-animation|Bambi": {
  "slug": "personnages-animation",
  "nom": "Bambi",
  "titre": "Bambi (personnage)",
  "extrait": "Bambi est un faon de fiction créé par le romancier Felix Salten dans Bambi, l'histoire d'une vie dans les bois, paru en 1923. Le roman a été adapté au cinéma en 1942 par les studios Disney sous la forme d'un long métrage d'animation : Bambi.",
