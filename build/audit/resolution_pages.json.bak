 "souverains-et-conquerants|Xerxès Ier": {
  "slug": "souverains-et-conquerants",
  "nom": "Xerxès Ier",
  "titre": "Xerxès Ier",
  "extrait": "Xerxès Ier (en vieux perse : 𐎧𐏁𐎹𐎠𐎼𐏁𐎠 / Xšayāršā ; en persan : خشایارشا / Xašâyâršâ, en égyptien ancien  / Ḫašayaruša), né vers 519 et mort en 465 av. J.-C., est un grand roi perse, membre de la dynastie des Achéménides et fils de Darius Ier, qui a régné de 486 à 465 av. J.-C. Manéthon l’appelle Xerxès le Grand. Il est vaincu par les Grecs à l'issue de la seconde guerre médique.\nIl est assimilé par les historiens modernes à l'Assuérus de la Bible où il apparaît dans les livres d'Esther et d'Esdra",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/43/National_Museum_of_Iran_Darafsh_%28784%29.JPG",
  "lien": "https://fr.wikipedia.org/wiki/Xerx%C3%A8s_Ier",
  "etape": "titre du CSV"
 },
 "souverains-et-conquerants|Léonidas Ier": {
  "slug": "souverains-et-conquerants",
  "nom": "Léonidas Ier",
  "titre": "Léonidas Ier de Sparte",
  "extrait": "Léonidas Ier (en grec ancien : Λεωνίδας / Leōnídas), né vers 540 et mort en 480 av. J.-C., est le roi agiade de Sparte de 489 à 480. Il est resté célèbre pour son opposition héroïque face aux Persans lors de la bataille des Thermopyles, durant laquelle il trouve la mort.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/1c/Statue_of_a_hoplite%2C_known_as_%E2%80%9CLeonidas.%E2%80%9D_5th_cent._B.C.jpg",
