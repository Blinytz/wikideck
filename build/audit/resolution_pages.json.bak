 "auteurs-modernes|James Baldwin": {
  "slug": "auteurs-modernes",
  "nom": "James Baldwin",
  "titre": "James Baldwin (écrivain)",
  "extrait": "James Arthur Baldwin [ d͡ʒeɪmz ˈɑɹθɚ ˈbɒldwən], né le 2 août 1924 dans le quartier de Harlem, à New York, et mort le 1er décembre 1987 à Saint-Paul-de-Vence, dans les Alpes-Maritimes, en France, est un écrivain américain, auteur de romans, de poésies, de nouvelles, de pièces de théâtre et d’essais. Son œuvre la plus connue est son premier roman, semi-autobiographique, intitulé La Conversion (Go Tell It on the Mountain), paru en 1953, et sa nouvelle Blues pour Sonny (Sonny's Blues) incluse dans l",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f3/James_Baldwin_37_Allan_Warren_%28cropped%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/James_Baldwin_%28%C3%A9crivain%29",
  "etape": "titre qualifié"
 },
 "tableaux-celebres|Le Printemps": {
  "slug": "tableaux-celebres",
  "nom": "Le Printemps",
  "titre": "Le Printemps (Botticelli)",
  "extrait": "Le Printemps (Primavera en italien prononcé : [ˌprimaˈveːra]) est une peinture allégorique de Sandro Botticelli, exécutée a  tempera sur panneau de bois entre 1478 et 1482, période de la Première Renaissance.\nElle a été décrite comme « l'une des peintures les plus commentées et les plus controversées au monde », et aussi « l'une des peintures les plus populaires de l'art occidental » .\nLe tableau représente un groupe de personnages de la mythologie classique dans un jardin, mais aucune histoire ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/25/Sandro_Botticelli_-_La_Primavera_-_Google_Art_Project.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Le_Printemps_%28Botticelli%29",
  "etape": "titre qualifié"
 },
 "tableaux-celebres|La Tempête": {
  "slug": "tableaux-celebres",
  "nom": "La Tempête",
  "titre": "La Tempête (Giorgione)",
  "extrait": "La Tempête (italien : La Tempesta) est un tableau de Giorgione daté entre 1506 et 1508.\nIl est parfois mentionné comme étant la première peinture de paysage.\nL'œuvre est conservée aux Gallerie dell'Accademia de Venise en Italie.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/a8/6%2C99Mo-Giorgione_019.jpg",
  "lien": "https://fr.wikipedia.org/wiki/La_Temp%C3%AAte_%28Giorgione%29",
  "etape": "titre qualifié"
 },
 "tableaux-celebres|Les Noces de Cana": {
  "slug": "tableaux-celebres",
  "nom": "Les Noces de Cana",
  "titre": "Les Noces de Cana (Véronèse)",
  "extrait": "Les Noces de Cana est un tableau réalisé par le peintre vénitien Paul Véronèse en 1563 sur le thème iconographique des Noces de Cana, il est exposé au musée du Louvre, à Paris.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/e0/Paolo_Veronese_008.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Les_Noces_de_Cana_%28V%C3%A9ron%C3%A8se%29",
  "etape": "titre qualifié"
 },
 "tableaux-celebres|Les Trois Grâces": {
  "slug": "tableaux-celebres",
  "nom": "Les Trois Grâces",
  "titre": "Les Trois Grâces (Rubens)",
  "extrait": "Les Trois Grâces est un tableau de Pierre Paul Rubens réalisé en 1639 représentant les Trois Grâces.\nL'œuvre fut conservée dans la collection personnelle de l'artiste jusqu'à sa mort, en 1640. Par la suite, elle fut acquis par Philippe IV qui ramena le tableau en Espagne en 1666 où il fut conservé à l'Alcázar royal de Madrid avant d'être accrochée au Musée du Prado.\nTrois autres variations ont été réalisées par Rubens sur le thème des Trois Grâces, dont une grisaille en 1620.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f5/The_Three_Graces%2C_by_Peter_Paul_Rubens%2C_from_Prado_in_Google_Earth.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Les_Trois_Gr%C3%A2ces_%28Rubens%29",
  "etape": "titre qualifié"
 },
 "tableaux-celebres|L'Enlèvement des Sabines": {
  "slug": "tableaux-celebres",
  "nom": "L'Enlèvement des Sabines",
  "titre": "L'Enlèvement des Sabines (Poussin)",
  "extrait": "L'Enlèvement des Sabines est le sujet de deux tableaux de Nicolas Poussin. Il est tiré de l'œuvre de Plutarque Vie de Romulus, et illustre le moment où les Romains s'emparèrent des Sabines, afin de les prendre pour épouses. Le premier, peint en 1634-1635 est conservé au Metropolitan Museum of Art de New York et a été peint à Rome. La deuxième version, peinte en 1637-1638 et exposée au musée du Louvre, montre qu’il n’a pas épuisé le sujet, même si certains personnages principaux sont identiques.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/a8/Nicolas_Poussin_-_L%27Enl%C3%A8vement_des_Sabines_%281634-5%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/L%27Enl%C3%A8vement_des_Sabines_%28Poussin%29",
  "etape": "titre qualifié"
 },
 "tableaux-celebres|Le Bain turc": {
  "slug": "tableaux-celebres",
  "nom": "Le Bain turc",
  "titre": "Le Bain turc (Ingres)",
  "extrait": "Le Bain turc est un tableau de Jean-Auguste-Dominique Ingres conservé au musée du Louvre à Paris. Cette œuvre présente un groupe de femmes nues dans un harem.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c9/Le_Bain_Turc%2C_by_Jean_Auguste_Dominique_Ingres%2C_from_C2RMF_retouched.jpg",
