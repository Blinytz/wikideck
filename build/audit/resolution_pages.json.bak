 "auteurs-classiques|Eschyle": {
  "slug": "auteurs-classiques",
  "nom": "Eschyle",
  "titre": "Eschyle",
  "extrait": "Eschyle (en grec ancien Αἰσχύλος / Aiskhúlos), né à Éleusis (Attique) vers 525 av. J.-C., mort à Géla (Sicile) en 456 av. J.-C., est le plus ancien des trois grands tragiques grecs. Précédé par d'autres dramaturges, il participe à la naissance du genre tragique grâce à certaines innovations, comme le nombre d'acteurs qu'il porte à deux selon Aristote. Treize fois vainqueur du concours tragique, il est l'auteur d'environ 110 pièces dont sept seulement nous ont été transmises.\nLe théâtre d'Eschyle",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/de/Aischylos_B%C3%BCste.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Eschyle",
  "etape": "titre du CSV"
 },
 "auteurs-classiques|Aristophane": {
  "slug": "auteurs-classiques",
  "nom": "Aristophane",
  "titre": "Aristophane",
  "extrait": "Aristophane (en grec ancien Ἀριστοφάνης / Aristophánês) est un poète comique grec du Ve siècle av. J.-C., né dans le dème de Cydathénéon (quartier d’Athènes) vers 445 av. J.-C. et mort entre 385 et 375 av. J.-C.. Son œuvre à elle seule représente ce qui nous reste de l'Ancienne Comédie, et coïncide avec les années glorieuses d'Athènes sous l'administration de Périclès et la longue et sombre période de la guerre du Péloponnèse. Au tournant du Ve et du IVe siècle avant J-C, alors qu'Athènes voit é",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/8/83/Aristofanes.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Aristophane",
  "etape": "titre du CSV"
 },
 "auteurs-classiques|Hésiode": {
  "slug": "auteurs-classiques",
  "nom": "Hésiode",
  "titre": "Hésiode",
  "extrait": "Hésiode (en grec ancien Ἡσίοδος / Hêsíodos, en latin Hesiodus) est un poète grec qui vécut à la fin du VIIIe ou au début du VIIe siècle av. J.-C..",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/3/36/Pseudo-Seneca_BM_GR1962.8-24.1.jpg",
  "lien": "https://fr.wikipedia.org/wiki/H%C3%A9siode",
