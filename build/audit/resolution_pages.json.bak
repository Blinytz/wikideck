 },
 "personnages-litterature|Paul Atréides": {
  "slug": "personnages-litterature",
  "nom": "Paul Atréides",
  "titre": "Paul Atréides",
  "extrait": "Paul Atréides (Paul Atreides en version originale) est un personnage de fiction issu du cycle de Dune de l'écrivain Frank Herbert. Il est le personnage principal des deux premiers romans du cycle, Dune et Le Messie de Dune, et un personnage secondaire dans le troisième, Les Enfants de Dune. Son héritage continue à jouer un rôle crucial dans les tomes ultérieurs.\nHéritier de la Maison Atréides, Paul est âgé de quinze ans lorsque son père, le duc Leto Atréides, est tué par la Maison Harkonnen riva",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/8/87/Atreides_Hawk..svg",
  "lien": "https://fr.wikipedia.org/wiki/Paul_Atr%C3%A9ides",
  "etape": "titre du CSV"
 },
 "personnages-cinema-serie|Vito Corleone": {
  "slug": "personnages-cinema-serie",
  "nom": "Vito Corleone",
  "titre": "Vito Corleone",
  "extrait": "Vito « Corleone » Andolini, dit « Don Vito Corleone », « Don Corleone » ou encore « Le Don » est un personnage de fiction et protagoniste principal du roman de Mario Puzo « Le Parrain » ainsi que du film du même nom, réalisé par Francis Ford Coppola en 1972, où il est interprété par Marlon Brando. Il est le chef et parrain de la famille Corleone, l’une des plus puissantes mafia des États-Unis. Il a cinq enfants : Michael (son benjamin qui lui succédera à sa mort), Santino (son aîné, doté d’un fo",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/3/32/Marlon_Brando_as_Vito_Corleone_%28high_quality%29.png",
  "lien": "https://fr.wikipedia.org/wiki/Vito_Corleone",
  "etape": "titre du CSV"
 },
 "personnages-cinema-serie|Michael Corleone": {
  "slug": "personnages-cinema-serie",
  "nom": "Michael Corleone",
  "titre": "Michael Corleone",
  "extrait": "Michael Corleone est un personnage de fiction dans les romans de Mario Puzo et dans la trilogie de films Le Parrain réalisée par Francis Ford Coppola. Il est interprété au cinéma par Al Pacino. Michael est le plus jeune fils de Vito Corleone, le parrain d'une des cinq familles mafieuses régnant sur le crime organisé aux États-Unis. \nBien qu'il ait toujours voulu se tenir éloigné des activités illégales de sa famille, il devient, à la suite de la mort de son père et de son frère aîné, le nouveau ",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Michael_Corleone",
  "etape": "titre du CSV"
 },
 "personnages-cinema-serie|Tony Montana": {
