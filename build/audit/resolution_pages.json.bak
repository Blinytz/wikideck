 "aviateurs-celebres|René Fonck": {
  "slug": "aviateurs-celebres",
  "nom": "René Fonck",
  "titre": "René Fonck",
  "extrait": "René Fonck, né à Saulcy-sur-Meurthe (Vosges) le 26 mars 1894 et mort dans le 8e arrondissement de Paris le 18 juin 1953, est un aviateur et homme politique français.\nPilote de chasse pendant la Première Guerre mondiale, il est surnommé l'« as des as » français et alliés, avec 75 victoires officiellement homologuées, selon le système français d'homologation de victoires aériennes, plus strict que le système allemand car nécessitant deux témoins oculaires étrangers à l'escadrille victorieuse.\nAvec",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/3/31/Ren%C3%A9_Fonck_02.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Ren%C3%A9_Fonck",
  "etape": "titre du CSV"
 },
 "aviateurs-celebres|Eddie Rickenbacker": {
  "slug": "aviateurs-celebres",
  "nom": "Eddie Rickenbacker",
  "titre": "Edward Vernon Rickenbacker",
  "extrait": "Edward Vernon « Eddie » Rickenbacker (8 octobre 1890 à Columbus, Ohio, États-Unis; † 23 juillet 1973 à Zurich, Suisse) est un as de l'aviation américaine de la Première Guerre mondiale. Avec vingt-six victoires, il est le pilote de chasse américain ayant obtenu le plus de victoires durant ce conflit.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/ed/Eddie-rickenbacker.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Edward_Vernon_Rickenbacker",
  "etape": "titre du CSV"
 },
 "aviateurs-celebres|Adolf Galland": {
  "slug": "aviateurs-celebres",
  "nom": "Adolf Galland",
  "titre": "Adolf Galland",
  "extrait": "Adolf Galland, né le 19 mars 1912 à Westerholt, aujourd'hui Herten, en province de Westphalie, et mort le 9 février 1996 à Remagen-Oberwinter, en Rhénanie-Palatinat (Allemagne), est un aviateur allemand, as de l'aviation durant la Seconde Guerre mondiale. Pilote de chasse puis commandant de la chasse allemande à partir de 1942, il est titulaire de 104 victoires homologuées.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/a8/Bundesarchiv_Bild_146-2006-0123%2C_Adolf_Galland.jpg",
