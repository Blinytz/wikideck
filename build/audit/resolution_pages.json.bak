 },
 "mythologies-asie-est|Ōkuninushi": {
  "slug": "mythologies-asie-est",
  "nom": "Ōkuninushi",
  "titre": "Ōkuninushi",
  "extrait": "Ōkuninushi (大国主) est l’une des divinités kami les plus importantes du panthéon shintô. Il est avec Amaterasu et Susanoo l’une des rares divinités à porter le qualificatif de « Grand ». Il est la divinité tutélaire du sanctuaire d'Izumo (出雲大社) qui est, après celui d'Ise, le plus important du Japon. Et où chaque année, au mois d'octobre, toutes les divinités du pays sont censées se réunir.\nSon nom signifie : Grand maître du Pays (ou des provinces). Il a la lourde tâche de consolider le pays, ce qu",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/70/MET_DP137830.jpg",
  "lien": "https://fr.wikipedia.org/wiki/%C5%8Ckuninushi",
  "etape": "titre du CSV"
 },
 "mythologies-asie-est|Ryūjin": {
  "slug": "mythologies-asie-est",
  "nom": "Ryūjin",
  "titre": "Ryūjin",
  "extrait": "Ryūjin (龍神) est le dieu de la mer dans la mythologie japonaise. C'est un dragon, symbole de la puissance de l'océan, pourvu d'une large gueule et capable de prendre forme humaine. Il vit à Ryūgū-jō d'où il contrôle les marées grâce à des joyaux magiques. Les tortues marines, les poissons et les méduses sont souvent décrites comme étant ses serviteurs.\nRyūjin est le père de la magnifique déesse Otohime qui épousa le prince chasseur Hoori. Le premier empereur du Japon, Jimmu, étant présenté comme ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/15/The_Dragon_King_Ryujin_and_the_Tide-controlling_Jewels_beneath_the_sea.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Ry%C5%ABjin",
  "etape": "titre du CSV"
 },
 "mythologies-asie-est|Fuxi": {
  "slug": "mythologies-asie-est",
  "nom": "Fuxi",
  "titre": "Fuxi",
  "extrait": "Fuxi, Fo Hi ou Fu Hsi (sinogrammes : 伏羲 - 伏犧 pīnyīn : Fú xī) est un personnage mythique de la mythologie chinoise dont l’origine remonte à l’antiquité, héros civilisateur, chef du peuple Huaxia, fondateur de la médecine traditionnelle chinoise, créateur de caractères chinois, et le premier dieu des trois Augustes (三皇, sān huáng). Il apparait aussi sous les noms de Paoxi (庖犧-庖棲 Páo xī), Mixi (宓羲 Mì xī), Taihao (太昊-太皞 Tài hào), Baoxi(包牺 Bāo xī), Fuxi（伏戏 Fú xì)，Xihuang(牺皇 Xī huáng), Huangxi（皇羲 Huán",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/db/Ma-Lin-Fuxi-and-turtle.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Fuxi",
  "etape": "titre du CSV"
 },
 "mythologies-asie-est|Shennong": {
  "slug": "mythologies-asie-est",
  "nom": "Shennong",
  "titre": "Shennong",
  "extrait": "Shennong ou Shen Nong (c.t. : 神農 c.s. : 神农 pinyin : Shénnóng ; EFEO : Chen-Nung) est un héros civilisateur de la mythologie chinoise, l’un des trois Augustes. On lui prête l’invention de la houe, de l’araire et du champ, de la culture des Cinq Grains (attribuée aussi à Huangdi), la découverte du thé et des vertus médicinales des plantes, ainsi que le Shennong bencaojing des Han occidentaux, premier traité chinois de phytothérapie. Il est parfois confondu avec Yandi et présenté comme le frère de ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/7c/Xu_Jetian_-_Shennong.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Shennong",
  "etape": "titre du CSV"
 },
 "mythologies-asie-est|Xiwangmu": {
  "slug": "mythologies-asie-est",
  "nom": "Xiwangmu",
  "titre": "Xiwangmu",
  "extrait": "Xīwángmǔ 西王母, Xi Wangmu, Hsi Wang Mu, ou Reine-mère de l'Ouest, est un personnage de la mythologie chinoise antique devenu sous la dynastie Han une divinité taoïste. Elle réside dans un palais de jade situé sur le Kunlun (en) céleste, lieu magique où pousseraient les herbes d’immortalité et les pêches de longue vie qui mûrissent tous les 3000 ou 9000 ans. Chef des immortelles, toutes les femmes aspirant à obtenir le Dao sont considérées comme ses disciples.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/b/ba/HanWudi-Xiwangmu.JPG",
  "lien": "https://fr.wikipedia.org/wiki/Xiwangmu",
  "etape": "titre du CSV"
 },
 "mythologies-asie-est|Chang'e": {
  "slug": "mythologies-asie-est",
  "nom": "Chang'e",
  "titre": "Chang'e",
  "extrait": "Chang’e (chinois : 嫦娥 ; pinyin : cháng’é) est un personnage de la mythologie chinoise, femme de l’archer Houyi. Séparée de son mari et du reste des humains, elle réside éternellement sur la Lune, dans un palais de jade nommé Vaste froidure (廣寒宮, guǎnghángōng), avec pour seuls compagnons Wugang, un apprenti immortel exilé, occupé à abattre un cannelier qui repousse sans cesse, et un lapin (ou lièvre) apothicaire dit « lapin de jade » (玉兔, yùtù), assisté selon certains d’un crapaud.\nLe taoïsme la ",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Chang%27e",
  "etape": "titre du CSV"
 },
 "mythologies-asie-est|Sun Wukong": {
  "slug": "mythologies-asie-est",
  "nom": "Sun Wukong",
  "titre": "Sun Wukong",
  "extrait": "Sun Wukong (chinois simplifié : 孙悟空 ; chinois traditionnel : 孫悟空 ; pinyin : Sūn Wùkōng ; Wade : Sun¹ Wu⁴-k'ung¹ ; EFEO : Souen Wouk'ong ; cantonais Jyutping : Syun¹ Ng⁶hung¹), souvent traduit en français par le Roi des Singes ou Roi singe, est l'un des personnages fictifs les plus célèbres de la littérature chinoise classique. Ce singe, héros principal du roman de Wu Cheng'en, La Pérégrination vers l'Ouest, est le premier disciple du moine Tang Sanzang, qui est chargé de partir en Inde (à l'oues",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/75/Xiyou.PNG",
  "lien": "https://fr.wikipedia.org/wiki/Sun_Wukong",
  "etape": "titre du CSV"
 },
 "mythologies-asie-est|Nezha": {
  "slug": "mythologies-asie-est",
  "nom": "Nezha",
  "titre": "Nezha",
  "extrait": "Nezha (chinois : 哪吒) orthographié aussi Nazha, Nazhuo, Natuo, Nata, ou Nuozha, plus connu sous le nom de Nezha Santaizi ou de le Troisième Plus Haut Fils, est le troisième fils et l’assistant de Li Jing (李靖, lǐjìng), général de la dynastie Shang déifié et chef de l'armée céleste chargée de mettre à la raison les esprits malfaisants qui contrecarrent les volontés divines et tourmentent les hommes ; Nezha commande lui-même une section de l’armée.\nPersonnalité jeune et rebelle, il était l’un des ra",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/74/Nezhafamilyaltar.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Nezha",
  "etape": "titre du CSV"
 },
 "mythologies-asie-est|Qilin": {
  "slug": "mythologies-asie-est",
  "nom": "Qilin",
  "titre": "Qilin",
  "extrait": "Le qilin, k'ilin, kiling ou kirin (chinois : 麒麟, pinyin : qílín, EFEO : k'i-lin ; japonais : 麒麟, kirin ; coréen : 기린, kirin ; vietnamien : kì lân ou kỳ lân) est un animal composite fabuleux issu de la mythologie chinoise possédant plusieurs apparences. Il tient généralement un peu du cerf et du cheval, possède un pelage, des écailles ou les deux, et une paire de cornes semblables aux bois d'un cerf. Créature cosmogonique, symbole d'harmonie et roi des animaux à pelage, il ne réside que dans les ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/5/57/QingQilin.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Qilin",
  "etape": "titre du CSV"
 },
 "mythologies-asie-est|Fenghuang": {
  "slug": "mythologies-asie-est",
  "nom": "Fenghuang",
  "titre": "Fenghuang",
  "extrait": "Le fenghuang (chinois simplifié : 凤凰 ; chinois traditionnel : 鳳凰 ; pinyin : fènghuáng ; Wade : feng⁴huang² ; cantonais Yale : fung⁶wong⁴), est un oiseau mythique de la littérature, l’iconographie et du folklore asiatique largement transmis dans la sphère culturelle chinoise. Désigné en coréen sous le nom de  bonghwang (봉황), et en vietnamien : phượng hoàng ou phụng hoàng ;  cette créature a eu un impact plus important au Japon où elle était désignée sous le nom de hōō (鳳凰). Oiseau fantastique, no",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/67/Imperial_Encyclopaedia_-_Animal_Kingdom_-_pic001_-_%E9%B3%B3%E5%87%B0%E5%9C%96.svg",
  "lien": "https://fr.wikipedia.org/wiki/Fenghuang",
  "etape": "titre du CSV"
 },
 "mythologies-asie-est|Dangun": {
  "slug": "mythologies-asie-est",
  "nom": "Dangun",
  "titre": "Tangun",
  "extrait": "Tangun, aussi romanisé Dangun (hangeul : 단군 ; hanja : 檀君, /tan.gun/) est le fondateur légendaire de Gojoseon, le premier royaume coréen. Il est considéré comme le « petit-fils du ciel ». Le 3 octobre, le jour de la fondation de Ko-Chosŏn est un jour férié national en Corée du Sud. De 1945 à 1961, le calendrier de la Corée du Sud a officiellement compté les années à partir de cette date, soit 2333 av. J.-C.. La plus ancienne version connue de cette légende est celle du Samguk Yusa (XIIIe siècle) ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/b/b8/Portrait_of_Dangun.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Tangun",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Tezcatlipoca": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Tezcatlipoca",
  "titre": "Tezcatlipoca",
  "extrait": "Tezcatlipoca (nom nahuatl signifiant littéralement « Miroir fumant ») est le dieu aztèque de la providence, du temps, du pouvoir, de la guerre et des souvenirs. C'est la plus crainte de toutes les divinités aztèques. C'est le second des quatre fils d'Ometecuhtli et Omecihuatl, les parents des quatre Tezcatlipoca : Xipe Totec (le Tezcatlipoca rouge), Tezcatlipoca (le Tezcatlipoca noir), Quetzalcóatl (le Tezcatlipoca blanc) et Huitzilopochtli (le Tezcatlipoca bleu).\n\n",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/0e/Red_Tezcatlipoca.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Tezcatlipoca",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Xipe Totec": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Xipe Totec",
  "titre": "Xipe Totec",
  "extrait": "Xipe Totec (« notre seigneur l'écorché » en nahuatl) est, dans la mythologie aztèque, un dieu du renouveau de la nature, de l'agriculture et des pluies nocturnes fertiles. Il s'écorche lui-même pour nourrir l'humanité, symbolisant ainsi le grain de maïs perdant son enveloppe avant de germer. Il est également le patron des orfèvres.\nSes représentations suivent deux types : l'écorché dont la peau pend au bout des bras, et le Tezcatlipoca rouge, entièrement maculé de cette couleur, exception faite ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/76/CodexBorbonicus.JPG",
  "lien": "https://fr.wikipedia.org/wiki/Xipe_Totec",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Mictlantecuhtli": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Mictlantecuhtli",
  "titre": "Mictlantecuhtli",
  "extrait": "Dans la mythologie aztèque, Mictlantecuhtli est le dieu de la mort. Son nom signifie « seigneur du Mictlan », le domaine de la mort, le lieu le plus bas de l'inframonde. Selon un des mythes de la création du monde, c'est là que Tezcatlipoca et Quetzalcóatl l'ont enfermé en mettant en ordre les éléments. Comme principal dieu de la mort, le culte de Mictlantecuhtli était particulièrement important et impliquait des sacrifices humains et des actes de cannibalisme.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/73/Mictlantecuhtli.svg",
  "lien": "https://fr.wikipedia.org/wiki/Mictlantecuhtli",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Coatlicue": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Coatlicue",
  "titre": "Coatlicue",
  "extrait": "Coatlicue est la déesse de la fertilité, de la terre dans la mythologie aztèque. Elle est aussi connue sous le nom Teteoinan (ou Teteo Inan), « mère des dieux », Cihuacoatl «femme serpent» et Tlaltecuhtli «Terre-Mère» ayant donné naissance à la lune, aux étoiles et au dieu du soleil et de la guerre. Elle recevait aussi les noms de Toci (« notre grand-mère »), Tonantzin, et Cihuacóatl (« la dame aux serpents »), déesse des femmes mortes en couches.\nEn nahuatl, son nom signifie « Celle qui porte u",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/12/Monolito_de_Coatlicue.JPG",
  "lien": "https://fr.wikipedia.org/wiki/Coatlicue",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Chalchiuhtlicue": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Chalchiuhtlicue",
  "titre": "Chalchiuhtlicue",
  "extrait": "Chalchiutlicue (nom nahuatl signifiant « celle qui porte une jupe de jade » et orthographié également Chalciuhtlicue, Chalcihuitlicue ou Chalchiuhtilicue) est une déesse des rivières, des lacs, la protectrice des naissances et des rituels de la mythologie aztèque.\n\n",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/2e/Chalchiuhtlicue_copy.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Chalchiuhtlicue",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Xolotl": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Xolotl",
  "titre": "Xolotl",
  "extrait": "Xolotl, dont le nom signifie « jumeau », « chien » ou encore « esclave » en nahuatl, est, dans la mythologie aztèque, un dieu associé aux phénomènes doubles, et plus particulièrement aux jumeaux, à Vénus lors de la tombée du jour et au passage des défunts dans l'inframonde.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/27/Xolotl.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Xolotl",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Ehecatl": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Ehecatl",
  "titre": "Ehecatl",
  "extrait": "Ehecatl, appelé aussi Ehecatecuhtli dans la mythologie aztèque, est le dieu personnifiant le vent et une des représentations de Quetzalcóatl. Son souffle était censé déplacer le Soleil et laisser la place à la pluie. Son nom, signifiant « vent » en nahuatl, indique clairement sa place dans le panthéon aztèque.\nSes enfants sont :\n\nTlacoccayotl (dieu du vent de l'orient).\nMictlampachecatl (dieu du vent du nord).\nCihuaehccayotl (dieu du vent de l'occident).\nHuitztlampaehecatl (dieu du vent du sud).",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/0e/Ehecatl_2.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Ehecatl",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Coyolxauhqui": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Coyolxauhqui",
  "titre": "Coyolxauhqui",
  "extrait": "Coyolxauhqui ([kojoɬˈʃaːʍki], « celle qui a des grelots peints sur le visage » en nahuatl), est la déesse de la lune chez les Aztèques. Elle est la fille de Coatlicue, associée à la lune, elle était la sœur guerrière de Huitzilopochtli. On dit qu'elle avait dressé les étoiles contre sa mère en apprenant que celle-ci était enceinte.\nSelon Bernardino de Sahagun, un jour que la pieuse Coatlicue faisait pénitence en balayant dans un temple, une balle de plumes lui tomba sur la poitrine et quelque te",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/d3/Coyolx%C4%81uhqui.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Coyolxauhqui",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Tonatiuh": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Tonatiuh",
  "titre": "Tonatiuh",
  "extrait": "Tonatiuh (Nahuatl : Olīn Tōnatiuh, « ça se meut, ça va en émettant de la lumière et de la chaleur ») dans la mythologie aztèque désignait le dieu personnifiant le soleil. \nLes Aztèques le considéraient comme le chef de Tollan. Il était aussi connu comme le cinquième soleil, ayant pris selon les croyances aztèques la relève du quatrième soleil après que celui-ci fut expulsé du ciel. D'après la cosmogonie aztèque, chaque ère cosmique avait son propre dieu Soleil, et nous serions dans la cinquième,",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/e5/Tonatiuh.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Tonatiuh",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Itzamna": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Itzamna",
  "titre": "Itzamna",
  "extrait": "Itzamna était une importante divinité du panthéon Maya. Il était le fils d'Hunab, le créateur ; on le représentait sous les traits d'un aimable vieillard aux joues creuses, au nez busqué et proéminent.\nItzamma était le dieu du Ciel, de la Nuit et du Jour. Dans ces deux dernières fonctions, il était étroitement lié à Kinich Ahau, le dieu du soleil, \"le seigneur de l'Œil du Soleil\", que l'on adorait particulièrement à Izamal, au nord du Yucatan, et sur l'île de Cozumel lieu du sanctuaire Pan-maya ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/04/Maize_God_and_Itzamn%C3%A1.JPG",
  "lien": "https://fr.wikipedia.org/wiki/Itzamna",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Ixchel": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Ixchel",
  "titre": "Ixchel",
  "extrait": "Ixchel, ou Ix Chel, est une déesse maya associée à l'eau. Son nom signifie « Dame (ix) - Arc-en-ciel (chel) ». Dans les textes glyphiques, elle est appelée « Chak Chel ». C'est la Déesse O dans la classification de Paul Schellhas (de) révisée par Karl Taube.\nC'est la femme d'Itzamna et la mère des Bacabs (en). Elle était représentée par une vieille femme ridée aux ongles crochus.\nElle peut se présenter sous un aspect bienveillant ou malveillant. Contrairement aux Européens, pour qui l'arc-en-cie",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/7a/Ixchel_Dresden_Codex.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Ixchel",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Chaac": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Chaac",
  "titre": "Chac",
  "extrait": "Chac (également orthographié Chaac ou, en maya classique, Chaahk) est le dieu de la pluie des Mayas et des Toltèques. Avec sa hache de foudre, Chaac frappe les nuages et déclenche le tonnerre et la pluie. Chaac est l’équivalent du dieu Tlaloc chez les Aztèques.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/9/94/MyanRainGodChac0180Rot.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Chac",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Ah Puch": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Ah Puch",
  "titre": "Ah Puch",
  "extrait": "Ah Puch, également nommé Ah Cimi ou encore Ah Cizin, est, dans la religion maya, le dieu de la Mort et le roi de Metnal, le neuvième niveau du monde souterrain (Xibalba). Il est souvent dépeint comme un squelette ou comme un cadavre orné de cloches, avec parfois la tête d'un hibou. Cette dernière vision du dieu de la mort a donné lieu à la croyance encore partagée aujourd'hui par certains Méso-américains que le cri du hibou annonce un décès imminent… Un dicton local dit d'ailleurs : « Cuando el ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/76/AhPuch.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Ah_Puch",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Hunahpú": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Hunahpú",
  "titre": "Hunahpu et Ixbalanque",
  "extrait": "Les jumeaux Ixbalanque (« Jeune Jaguar du soleil ») et Hunahpu (« Utilisant une sarbacane ») sont les fils de Hun Hunahpu (jumeau lui aussi de Vucub Hunahpu, et tous deux décapités dans le monde souterrain des Mayas par les seigneurs de Xibalba) et d’une jeune princesse Xibalbienne : Ixquic (La Dame Sang). \nLa femme trouve la tête décapitée de Hun Hunahpu, la caresse mais se fait cracher dessus par celle-ci, elle tombe alors enceinte et est exilée sur Terre par les autres Xibalbien. Elle accouch",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Hunahpu_et_Ixbalanque",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Ixbalanqué": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Ixbalanqué",
  "titre": "Hunahpu et Ixbalanque",
  "extrait": "Les jumeaux Ixbalanque (« Jeune Jaguar du soleil ») et Hunahpu (« Utilisant une sarbacane ») sont les fils de Hun Hunahpu (jumeau lui aussi de Vucub Hunahpu, et tous deux décapités dans le monde souterrain des Mayas par les seigneurs de Xibalba) et d’une jeune princesse Xibalbienne : Ixquic (La Dame Sang). \nLa femme trouve la tête décapitée de Hun Hunahpu, la caresse mais se fait cracher dessus par celle-ci, elle tombe alors enceinte et est exilée sur Terre par les autres Xibalbien. Elle accouch",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Hunahpu_et_Ixbalanque",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Vucub Caquix": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Vucub Caquix",
  "titre": "Vucub Caquix",
  "extrait": "Vucub-Caquix (Quiché : Wuqub Kaqix, [ʋuˈquɓ kaˈqiʃ], signifiant peut-être sept-ara) est le nom d'un démon oiseau vaincu par les héros jumeaux d'un mythe quiché-maya conservé dans un document du XVIIIe siècle, intitulé Popol Vuh. L'épisode de la défaite du démon est déjà connu à la fin de la période préclassique, avant le IIIe siècle. Il est également le père de Zipacna, une divinité démoniaque de la pègre, et de Cabrakan, le dieu des tremblements de terre.",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Vucub_Caquix",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Camazotz": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Camazotz",
  "titre": "Camazotz",
  "extrait": "Dans la religion maya, Camazotz est un dieu chauve-souris. On le décrit comme une créature dotée d'un corps humain et d'une tête de chauve-souris, animal qui, dans la culture maya, est associé à la nuit, à la mort et au sacrifice. Le culte de ce dieu commence vers 100 av. J.-C. dans l'Oaxaca, chez les Zapotèques, avant de se propager chez les mayas Quiché, qui assimilent Camazotz à leur dieu du feu  Zotzilaha Chamalcan. \nDans le Popol Vuh, une des épreuves que les Seigneurs de Xibalba imposent a",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/e3/Mus%C3%A9um_d%27histoire_naturelle_de_Bourges_camazolz_dieu_maya.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Camazotz",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Viracocha": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Viracocha",
  "titre": "Viracocha",
  "extrait": "Viracocha est le principal dieu des civilisations de Tiwanaku, Huari et des Incas, dieu créateur, roi de la foudre et des tempêtes. Il est parfois représenté comme un vieil homme portant une barbe (symbole du dieu de l'eau), une longue robe et  transportant un sac. \nAussi orthographié Huiracocha, Wiracocha ou Wiraqocha, il était à l'origine adoré par les premiers habitants du Pérou et il fut intégré relativement tardivement au Panthéon inca, probablement sous l'empereur Viracocha Inca, qui prit ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/3/3c/2Wiener-Tintin-Dieu_Soleil.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Viracocha",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Inti": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Inti",
  "titre": "Inti",
  "extrait": "Inti est la manifestation inca/panandine du soleil. C'est une force divine reconnue par tous les peuples andins. Son origine n'est pas connue de manière certaine : selon certains, il pourrait avoir été un totem d'origine Quechua ou bien celui d'un dieu d'une autre tribu. Il est représenté par un disque solaire à face humaine et entouré de rayons lumineux.\nSelon la mythologie inca, il est le fils de Viracocha, dieu de la civilisation inca. Chaque jour, Inti parcourt le ciel vers l'ouest puis plon",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/9/9d/Sol_de_Mayo-Bandera_de_Argentina.svg",
  "lien": "https://fr.wikipedia.org/wiki/Inti",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Mama Quilla": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Mama Quilla",
  "titre": "Mama Quilla",
  "extrait": "Mama Quilla est la déesse Lune, des carnavals ainsi que la nuit étoilée dans la mythologie inca.",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Mama_Quilla",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Pachamama": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Pachamama",
  "titre": "Pachamama",
  "extrait": "La Pachamama (« Terre-Mère »), issue de dévotions à la fertilité dans la cosmogonie andine, est la déesse-Terre dans certaines cultures syncrétiques présentes essentiellement dans l'espace correspondant à l'ancien empire inca.\nLa figure de Pachamama est particulièrement forte chez les peuples Aymara et Quetchua, issue d'un culte majeur de la culture pré-inca Tiwanaku en Bolivie et plus ou moins mêlé de christianisme. Elle domine toutes les croyances et les religions naturistes et inspire tous le",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/d0/Colvin_Pachamama.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Pachamama",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Illapa": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Illapa",
  "titre": "Illapa",
  "extrait": "Illapa est une figure de la mythologie inca. Il est le dieu de la foudre, du tonnerre, de la pluie et de la guerre. La foudre était généralement vénérée comme une divinité de la hiérarchie suprême dans toute la région andine ; c'est pourquoi elle reçut différents noms, comme Yana Raman ou Libiac entre autres. Au cours de l'expansion de l'Empire inca, ces divinités deviendront des variantes régionales du dieu Illapa.\nIllapa était fortement lié à l'agriculture, car de sa main dépendait le climat p",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Illapa",
  "etape": "titre du CSV"
 },
 "mythologies-mesoamericaines|Manco Cápac": {
  "slug": "mythologies-mesoamericaines",
  "nom": "Manco Cápac",
  "titre": "Manco Cápac",
  "extrait": "Manco Cápac (du quechua Manqu Qhapaq) ou Ayar Manco est, selon certains chroniqueurs, le premier souverain du peuple inca à Cuzco, et l'ancêtre mythique des Incas, fondateur de leur dynastie et héros civilisateur quasi divinisé. Il est le principal protagoniste des deux légendes les plus connues sur l'origine des Incas : la Légende de Manco Cápac et Mama Ocllo et la Légende des frères Ayar.\nIl eut comme épouse principale sa sœur Mama Ocllo, avec laquelle il engendra son successeur Sinchi Roca, a",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/8/82/Ayarmanco1.JPG",
  "lien": "https://fr.wikipedia.org/wiki/Manco_C%C3%A1pac",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Marduk": {
  "slug": "mythologies-proche-orient",
  "nom": "Marduk",
  "titre": "Marduk",
  "extrait": "Marduk ou Mardouk (en akkadien, AMAR.UTU en sumérien), appelé aussi Bēl « le Seigneur », est une divinité de la Mésopotamie antique, le dieu protecteur de la cité et du royaume de Babylone.\nDivinité locale sans importance jusqu'au début du XVIIIe siècle av. J.-C., il prend de plus en plus de stature au fur et à mesure que la puissance politique et militaire de Babylone s'affirme, à partir du règne de Hammurabi. Il reprend notamment la personnalité du dieu Asalluhi, fils du grand dieu Ea et dieu ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/46/Marduk_and_pet.svg",
  "lien": "https://fr.wikipedia.org/wiki/Marduk",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Ishtar": {
  "slug": "mythologies-proche-orient",
  "nom": "Ishtar",
  "titre": "Ishtar",
  "extrait": "Ishtar (Ištar ; parfois Eshtar) est une déesse mésopotamienne d'origine sémitique, vénérée chez les Akkadiens, Babyloniens et Assyriens. Elle correspond à la déesse de la mythologie sumérienne Inana avec qui elle est confondue, une même déesse se trouvant manifestement derrière ces deux noms. Ses champs de compétences sont vastes et variés. C'est principalement une divinité astrale associée à la planète Vénus, une déesse de l'amour et de la guerre, et une divinité souveraine dont l'appui est néc",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/ca/Ishtar_Eshnunna_Louvre_AO12456.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Ishtar",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Enlil": {
  "slug": "mythologies-proche-orient",
  "nom": "Enlil",
  "titre": "Enlil",
  "extrait": "Enlil (en sumérien),  ʿĒllil (en akkadien), est l'un des dieux principaux de la religion mésopotamienne antique. Peut-être à l'origine une divinité liée au vent, il est considéré durant la seconde moitié du IIIe millénaire av. J.-C. et une majeure partie du IIe millénaire av. J.-C. comme le roi des dieux, divinité suprême du panthéon mésopotamien. C'est lui qui par ses décisions attribue la suprématie aux rois humains, qui lui accordent donc une place de choix dans leurs offrandes et leurs inscr",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f3/God_Enlil%2C_seated%2C_from_Nippur%2C_Iraq._1800-1600_BCE._Iraq_Museum.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Enlil",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Tiamat": {
  "slug": "mythologies-proche-orient",
  "nom": "Tiamat",
  "titre": "Tiamat",
  "extrait": "Tiamat est une déesse mésopotamienne, personnification des eaux primordiales (son nom est une forme du mot désignant la mer en babylonien). Elle apparaît avant tout dans l'Épopée de la Création babylonienne (Enūma Eliš) en tant que maîtresse des forces du chaos, et antagoniste principale du grand dieu Marduk.",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Tiamat",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Ereshkigal": {
  "slug": "mythologies-proche-orient",
  "nom": "Ereshkigal",
  "titre": "Ereshkigal",
  "extrait": "Ereshkigal, la « Dame de la Grande Terre » est la déesse du monde des morts, les Enfers mésopotamiens. Elle est présente dans des récits comme la Descente d'Inanna aux Enfers ou  Nergal et Ereshkigal ou dans les Hymnes aux temples. Jusqu'à son mariage avec le dieu Nergal, elle y règne seule, dans le palais du Ganzer, coupée de toutes relations avec les vivants et les dieux d'en haut et seulement assistée de quelques autres dieux infernaux. Même si elle est une déesse importante dans le panthéon ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/11/Relieve_Reina_de_la_Noche_%28ca._1800_a.C%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Ereshkigal",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Ninurta": {
  "slug": "mythologies-proche-orient",
  "nom": "Ninurta",
  "titre": "Ninurta",
  "extrait": "Ninurta est une divinité de la mythologie mésopotamienne. Fils du roi des dieux Enlil, c'est un dieu guerrier, associé au triomphe militaire contre les forces malfaisantes, ce que relatent plusieurs mythes, et aussi une divinité agraire garantissant la fertilité et la prospérité, plus largement un défenseur de l'ordre du monde. Son principal lieu de culte en Basse Mésopotamie est situé dans la cité de Nippur. Il est également populaire en Assyrie, où il sert de modèle pour les rois.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f7/Cropped_Image_of_Carving_Showing_the_Mesopotamian_God_Ninurta.png",
  "lien": "https://fr.wikipedia.org/wiki/Ninurta",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Nergal": {
  "slug": "mythologies-proche-orient",
  "nom": "Nergal",
  "titre": "Nergal",
  "extrait": "Nergal est un dieu des Enfers et de la guerre du panthéon mésopotamien. Il est considéré couramment comme une divinité d'origine sémitique, cohabitant avec la déesse infernale sumérienne, Ereshkigal, qui est à partir d'un certain moment de l'histoire religieuse mésopotamienne considérée comme sa parèdre, comme décrit dans le mythe de Nergal et Ereshkigal. Il est assimilé à une autre divinité infernale et destructrice, Erra.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/e5/Nergal.png",
  "lien": "https://fr.wikipedia.org/wiki/Nergal",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Shamash": {
  "slug": "mythologies-proche-orient",
  "nom": "Shamash",
  "titre": "Shamash",
  "extrait": "Shamash, aussi transcrit Šamaš, est le nom akkadien du dieu-Soleil dans le panthéon mésopotamien. Il correspond au sumérien Utu. Il occupe une petite position secondaire dans la hiérarchie divine par rapport au dieu Lune Sîn, considéré comme son père, et a un rôle effacé dans la mythologie, qui contraste avec la grande popularité dont il a bénéficié auprès des anciens Mésopotamiens comme l'atteste le fait que nombre d'entre eux ont porté un nom faisant référence à ce dieu.\nShamash était vu comme",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/9/99/Tablet_of_Shamash_relief.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Shamash",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Dumuzi": {
  "slug": "mythologies-proche-orient",
  "nom": "Dumuzi",
  "titre": "Dumuzi",
  "extrait": "Dumuzi (« Fils légitime » en sumérien), aussi appelé Dumuzid ou, en babylonien, Tammuz, est un dieu de l'abondance de la Mésopotamie antique dont les premières traces écrites et iconographiques apparaissent au IIIe millénaire av. J.-C.\nIl figure dans la Liste royale sumérienne comme « Dumuzi le berger », roi de Bad-Tibira, cinquième roi de la première dynastie archaïque sumérienne de la période légendaire d'avant le Déluge. Il est par ailleurs repris sous le nom de « Dumuzi le pêcheur », roi de ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f5/Dumuzi_aux_enfers.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Dumuzi",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Enkidu": {
  "slug": "mythologies-proche-orient",
  "nom": "Enkidu",
  "titre": "Enkidu",
  "extrait": "Enkidu ou Enkidou est un personnage légendaire de la Mésopotamie ancienne. Acolyte du héros Gilgamesh, il apparaît de ce fait à ses côtés dans ses aventures, en premier lieu l’Épopée de Gilgamesh, dont il est l'un des protagonistes principaux. Le personnage d'Enkidu incarne le passage de l'état de nature à la civilisation, thème central de l'épopée mésopotamienne.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/40/H%C3%A9ros_ma%C3%AEtrisant_un_lion_-_Mus%C3%A9e_du_Louvre_Antiquit%C3%A9s_orientales_AAO_19862_%3B_N_III_2861_%3B_LP_3487_%3B_N_8036.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Enkidu",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Humbaba": {
  "slug": "mythologies-proche-orient",
  "nom": "Humbaba",
  "titre": "Humbaba",
  "extrait": "Dans la mythologie mésopotamienne, Humbaba, ou Huwawa (en sumérien), est le géant démon gardien de la Forêt des Cèdres où vivent les dieux. Cette charge lui a été confiée par le dieu du vent et de la grande montagne Enlil. Son aspect effrayant et des armes surnaturelles, sept fulgurances dans la version ancienne de l’Épopée de Gilgamesh ou sept manteaux magiques dans la version ninivite, permettaient de faire fuir les autres démons.\n\n",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/cb/Humbaba_pal%C3%A9o-babylonien_.png",
  "lien": "https://fr.wikipedia.org/wiki/Humbaba",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Adad": {
  "slug": "mythologies-proche-orient",
  "nom": "Adad",
  "titre": "Adad",
  "extrait": "Adad, dans les textes sumériens Ishkur, est une divinité de l'Orage et de la Fertilité de la Mésopotamie ancienne. Il représente d'une manière générale les éléments climatiques, dont la pluie et, à ce titre, il apparaît également comme un dieu de la fertilité. Cet aspect est marqué par son animal-symbole, le taureau. \nIl est la variante mésopotamienne du dieu de l'Orage présent au Levant sous le nom de Hadad, Haddu, Addu ou Baal, mais contrairement à ces régions le dieu de l'Orage mésopotamien n",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/76/Stele_of_Adad_0234.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Adad",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Apsû": {
  "slug": "mythologies-proche-orient",
  "nom": "Apsû",
  "titre": "Apsû",
  "extrait": "L'apsû (ou abzu en sumérien), parfois traduit par Abîme, est le nom  de l'océan souterrain dans la mythologie mésopotamienne, composé d'eau douce. Selon cette croyance, les lacs, sources, rivières, puits et autres points d'eau douce découlent tous d'Apsû.\nLe dieu sumérien Enki (Éa en akkadien) commença à vivre dans les eaux d'Apsû avant même que les êtres humains voient le jour. Sa femme Ninhursag, sa mère Nammu et une variété de créatures subordonnées y résident également.\nÀ Eridu, le temple d'",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/0b/Babylon%27s_world_view.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Aps%C3%BB",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Lamashtu": {
  "slug": "mythologies-proche-orient",
  "nom": "Lamashtu",
  "titre": "Lamashtu",
  "extrait": "Lamashtu ou Labartu (Akkadien), ou encore Dimme (sumérien), fille du dieu An, est une démone, divinité secondaire de la mythologie mésopotamienne.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f2/Lamashtu_plaque_9161.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Lamashtu",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Ahura Mazda": {
  "slug": "mythologies-proche-orient",
  "nom": "Ahura Mazda",
  "titre": "Ahura Mazda",
  "extrait": "Ahura Mazdā (du vieux perse 𐏈 𐏉 / Auramazdâ, « Seigneur de la Sagesse », en persan اهورامزدا) est la divinité centrale de l'ancienne religion mazdéenne. Puis, il devient le dieu unique du zoroastrisme, tel qu'il fut enseigné et vénéré par Zoroastre.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/77/Faravahar.svg",
  "lien": "https://fr.wikipedia.org/wiki/Ahura_Mazda",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Angra Mainyu": {
  "slug": "mythologies-proche-orient",
  "nom": "Angra Mainyu",
  "titre": "Ahriman",
  "extrait": "Angra Mainyu ou Ahra Manyu (nom avestique), puis Ahriman (en moyen-perse 𐭠𐭧𐭫𐭬𐭭𐭩 / Ahreman) est l'esprit démoniaque opposé au dieu Ahura Mazda dans le zoroastrisme.\nInitialement, Ahura Mazdâ, en tant que Dieu suprême, crée deux esprits qui s'opposeront, Spenta Mainyu (l'esprit du Bien, l'esprit saint) et Angra Mainyu (l'esprit du Mal). Ultérieurement, Spenta Mainyu sera remplacé par Ahura Mazdâ (ou Ohrmazd en pehlevi) en tant qu'adversaire d'Ahriman. Par la suite encore, les mages zervanistes réi",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/d7/Shah_Namah%2C_the_Persian_Epic_of_the_Kings_Wellcome_L0035183.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Ahriman",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Mithra": {
  "slug": "mythologies-proche-orient",
  "nom": "Mithra",
  "titre": "Mithra",
  "extrait": "Mithra (Miθra en avestique, Mihr en pehlevi, Mehr dans le zoroastrisme contemporain) est un dieu vénéré durant l'Antiquité chez les peuples de langue perse, issu d'une divinité indo-perse, tout comme son équivalent dans les religions indiennes, Mitra. Mithra est le dieu garant des contrats, une divinité aux aspects solaires, maître du ciel diurne, qui présente également des aspects guerriers, et dans plusieurs pays est un garant de la royauté. Il est surtout connu par la description qu'en donne ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/e6/Mithra_%284684713252%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Mithra",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Anahita": {
  "slug": "mythologies-proche-orient",
  "nom": "Anahita",
  "titre": "Anahita",
  "extrait": "Anahita (en persan : آناهیتا), ou Anahid (en persan : ناهید, immaculée, non polluée) en persan moderne, est une ancienne divinité perse associée aux eaux célestes, à la fertilité et à la prospérité. Elle occupe une place majeure dans le panthéon zoroastrien et appartient au groupe des yazatas. Son culte est attesté dans les textes avestiques et dans les inscriptions royales achéménides, puis se prolonge durant les périodes parthe et sassanide. Comme l'a démontré Georges Dumézil, elle correspond ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f9/Anahita_vessel%2C_300-500_CE%2C_Sasanian%2C_Cleveland_Museum_of_Art.JPG",
  "lien": "https://fr.wikipedia.org/wiki/Anahita",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Zurvan": {
  "slug": "mythologies-proche-orient",
  "nom": "Zurvan",
  "titre": "Zervan",
  "extrait": "Zervan (ou Zurvan) est le dieu créateur du zervanisme, une forme du zoroastrisme. Personnifiant le temps et l'éternité, il est le père d'Ahura Mazda et de son adversaire Angra Mainyu.\nSon nom correspond au terme moyen perse zurwān (« Temps »), qui dérive de l'Avestan zruvā (« Temps »). On a retrouvé des inscriptions contenant les consonnes zrw(n) et zraovo qui laissent entendre que Zervan aurait été vénéré comme divinité suprême en Sogdiane et en Bactriane.\nAu 3e siècle, son nom est utilisé par ",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Zervan",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Verethragna": {
  "slug": "mythologies-proche-orient",
  "nom": "Verethragna",
  "titre": "Verethragna",
  "extrait": "Verethragna, ou Bahrām, est  une divinité guerrière du panthéon antique iranien. Pouvant prendre plusieurs formes, il combat et vainc le mal. Mentionné plusieurs fois dans l’Avesta, il y prend tantôt une forme immatérielle (vent violent), la forme humaine ou des formes animales telle un oiseau dont les plumes ont un effet protecteur magique, à l’instar du Simorgh, oiseau mythique du Shâh Nâmeh. Semblable au dieu hindouiste Indra, il est appelé wsγn par les Sogdiens, Orlagno par les  Bactriens, V",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/dc/Bistoon_Kermanshah.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Verethragna",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Simurgh": {
  "slug": "mythologies-proche-orient",
  "nom": "Simurgh",
  "titre": "Simorgh (mythologie)",
  "extrait": "Le Simorgh (en persan : سيمرغ / Simorġ), aussi transcrit Simurgh (en moyen perse : Sênmurw), connu aussi sous le nom de Sîna-Mrû (Pâzand), est un oiseau fabuleux de la mythologie perse.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/a8/Textile0001.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Simorgh_%28mythologie%29",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Rostam": {
  "slug": "mythologies-proche-orient",
  "nom": "Rostam",
  "titre": "Rostam",
  "extrait": "Rostam ou Roustem ou Rustam (en persan : رستم, Rostam) est un héros mythique de la Perse antique, fils de Zal et de Roudabeh. Par certains aspects, la position de Rostam dans la tradition historique est similaire à celle de Suréna, le héros de la bataille de Carrhes. Son personnage a été affublé de nombreuses caractéristiques de la personnalité historique de Rostam. Ce dernier était toujours présenté comme le plus fort des héros perses, et l'atmosphère des épisodes dans lesquels il intervient es",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/63/Rostam_killing_the_White_Demon.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Rostam",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Fereydoun": {
  "slug": "mythologies-proche-orient",
  "nom": "Fereydoun",
  "titre": "Fereydoun",
  "extrait": "Fereydoun est un roi iranien mythique et un héros symbole de victoire, de justice, et de générosité dans la littérature persane. D'après le Livre des Rois de Ferdowsi, Fereydoun était le fils d'Abtine et un des descendants de Djamchid. Fereydoun, avec Kaveh s'est révolté contre le roi tyrannique Zahhak et a pu le battre et l'arrêter dans les monts Elbourz. Après cela, Fereydoun est devenu roi d'après la légende, et régna sur le pays pendant près de 500 ans (d'après le Zend-Avesta).\nÀ la fin de s",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/22/King_Faridun%2C_Qajar_Persia%2C_mid-19th_Century_%28cropped%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Fereydoun",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Jamshid": {
  "slug": "mythologies-proche-orient",
  "nom": "Jamshid",
  "titre": "Djamchid",
  "extrait": "Djamchid ou  Jamshid (en persan : جمشید / Jamšid) est un prénom masculin iranien. Le nom tire sa popularité du légendaire Chah Djamchid, le 4e et plus grand des premiers chahs de l'humanité dans le Livre des Rois de Ferdowsi. Le nom fut aussi translittéré Jamshid.\nLe roi Djamchid de la mythologie perse est basé sur le personnage de Yima Xšaēta dans l'Avesta, texte sacré du zoroastrisme. Yima Xšaēta est lui-même basé sur un personnage héroïque proto-indo-iranien, *Yamas dont le Yama vedique dériv",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/b/b5/Jamshid_%28The_Shahnama_of_Shah_Tahmasp%29.png",
  "lien": "https://fr.wikipedia.org/wiki/Djamchid",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Baal": {
  "slug": "mythologies-proche-orient",
  "nom": "Baal",
  "titre": "Baal",
  "extrait": "Baal ou Ba'al (en hébreu : בָּעַל, Báʿal, qui signifie « supérieur, suprême » ; en akkadien : Bēl) est un nom divin pouvant désigner un ensemble de divinités des peuples de langues sémitiques du Proche-Orient ancien, en Syrie et au Levant (Ugarit, Phénicie, Canaan) et par dérivation dans les implantations phéniciennes de Méditerranée (Carthage). \nCe nom signifie « Seigneur » ou « Maître » et est couramment employé pour désigner une divinité majeure d'un panthéon local, souvent un dieu de l'Orage",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/04/Baal_Ugarit_Louvre_AO17329.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Baal",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Astarté": {
  "slug": "mythologies-proche-orient",
  "nom": "Astarté",
  "titre": "Astarté",
  "extrait": "Astarté (du grec Ἀστάρτη / Astártē, dérivé du phénicien ‘Aštart) est une déesse majeure du Proche-Orient ancien, vénérée dans plusieurs régions, notamment en Syrie (Ougarit) et en Phénicie. Elle est l'équivalent quasi identique de la déesse mésopotamienne Ishtar et présente les mêmes fonctions majeures qu'elle : c'est une incarnation de la planète Vénus, une déesse de l'amour et de la sexualité, des activités guerrières, une figure souveraine protégeant les monarques. Son culte a connu une grand",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/27/Astart%C3%A9_de_El_Carambolo%2C_Museo_Arqueol%C3%B3gico_de_Sevilla.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Astart%C3%A9",
  "etape": "titre du CSV"
 },
 "mythologies-proche-orient|Melqart": {
  "slug": "mythologies-proche-orient",
  "nom": "Melqart",
  "titre": "Melqart",
  "extrait": "Melqart est un dieu d'origine phénicienne, dieu tutélaire de la cité de Tyr. \n\n",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/17/Estatuillas_votivas_del_templo_de_H%C3%A9rcules_Gaditano.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Melqart",
  "etape": "titre du CSV"
 },
 "mythologies-slaves|Svarog": {
  "slug": "mythologies-slaves",
  "nom": "Svarog",
  "titre": "Svarog",
  "extrait": "Svarog (en polonais Swaróg /ˈsfa.ruk/, en russe Сварог ou Соварог) est le dieu du feu et de la métallurgie dans la mythologie slave.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/3/33/Svarog_by_Andrey_Shishkin.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Svarog",
  "etape": "titre du CSV"
 },
 "mythologies-slaves|Mokosh": {
  "slug": "mythologies-slaves",
  "nom": "Mokosh",
  "titre": "Mokoch",
  "extrait": "Mokoch, ou Mokocha (en russe : Мокошь, en polonais : Mokosz) était la déesse de la terre mère et nourricière dans la mythologie slave. Selon certains chercheurs (Łowmiański, Borovskij), qui ont essayé de rapprocher son nom de la racine slave mok- (mouillé, humide), elle représentait la déesse de la pluie et de la tempête.\nLe prince Vladimir lui avait érigé une statue à Kiev en compagnie de celles d'autres dieux, avant sa conversion au christianisme. C'est la seule divinité féminine slave général",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/47/Makosh-XIX_Lob.png",
  "lien": "https://fr.wikipedia.org/wiki/Mokoch",
  "etape": "titre du CSV"
 },
 "mythologies-slaves|Stribog": {
  "slug": "mythologies-slaves",
  "nom": "Stribog",
  "titre": "Stribog",
  "extrait": "Stribog est le divin slave suprême d'air et du ciel et du vent au seigneur des vents dans la mythologie slave « âpres et sifflants ». Après la christianisation, il est assimilé au souffle du Saint-Esprit. Les paysans slaves disent encore aujourd'hui : « Si le vent est calme, c'est que Stribog joue de la flûte ».\n\n Portail de la culture russe   Portail du monde slave   Portail de la mythologie",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f4/Stribog_%28SCHLEUSING%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Stribog",
  "etape": "titre du CSV"
 },
 "mythologies-slaves|Jarilo": {
  "slug": "mythologies-slaves",
  "nom": "Jarilo",
  "titre": "Yarilo",
  "extrait": "Yarilo (au russien Ярило) et les quelques noms : Jarilo et Jaryla et Yarylo et Yarovit et Iarilo et Gerovit est le divin slave russien de végétation et de fertilité et du printemps dans la mythologie slave.",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Yarilo",
  "etape": "titre du CSV"
 },
 "mythologies-slaves|Tchernobog": {
  "slug": "mythologies-slaves",
  "nom": "Tchernobog",
  "titre": "Tchernobog",
  "extrait": "Tchernobog (Crnobog, Czernobog, Černobog ou Zernebog) est le dieu de la nuit et de l'obscurité. Tchernobog est le dieu de la Lune de la mythologie slave, à l'opposé de Belobog, dieu du Soleil dans la même mythologie. Son nom signifie « Dieu noir » ou « Dieu des Ténèbres ».",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/3/39/The_Mythology_of_All_Races_Vol_3_%28Celtic_and_Slavic%29_441c.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Tchernobog",
  "etape": "titre du CSV"
 },
 "mythologies-slaves|Domovoï": {
  "slug": "mythologies-slaves",
  "nom": "Domovoï",
  "titre": "Domovoï",
  "extrait": "Le domovik ou domovoy (en russe : домово́й, dérivé du mot dom [дом], maison ; au pluriel : domoviye ou domovye) est un esprit protecteur du foyer et de la famille, ressortant de la « petite mythologie » chez les Slaves. Avec la christianisation il est devenu un personnage des contes populaires russes.\nIl est possible que la croyance slave en domovoï se soit perpétuée également chez les Serbes, dont chaque famille possède aujourd'hui un saint protecteur et auquel était consacrée annuellement une ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/8/82/Domovoi.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Domovo%C3%AF",
  "etape": "titre du CSV"
 },
 "mythologies-slaves|Leshy": {
  "slug": "mythologies-slaves",
  "nom": "Leshy",
  "titre": "Liéchi",
  "extrait": "Le Liéchi (ou lechiï, léchy, lesovik, en russe : леший, mot-à-mot sylvain ou homme des bois) est dans la mythologie slave un esprit de la forêt et des arbres. Il est le gardien de la forêt et de ses habitants.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/26/Leshy_%281906%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Li%C3%A9chi",
  "etape": "titre du CSV"
 },
 "mythologies-slaves|Vodianoï": {
  "slug": "mythologies-slaves",
  "nom": "Vodianoï",
  "titre": "Vodianoï",
  "extrait": "Un vodianoï, wodianoï, vodovik dedouchka (en russe : водяной / vodyanoy ; en ukrainien : водяник / vodyanyk ; en polonais : wodnik ; vodník en slovaque et tchèque, pluriel vodníci), povodnj, povodni mož (en slovène), vodnik (водник en bulgare) ou wodby muž ou wodnykus (en sorabe) est un personnage de la mythologie slave qui vit dans l’eau. Tous ces mots, ou presque, signifieraient « ondin, triton ».\nEn Russie, c’est un esprit malveillant dont la principale fonction est de noyer les gens et les a",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/d3/Vodyanoy.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Vodiano%C3%AF",
  "etape": "titre du CSV"
 },
 "mythologies-slaves|Bannik": {
  "slug": "mythologies-slaves",
  "nom": "Bannik",
  "titre": "Bannik",
  "extrait": "Le bannik (russe Банник) est l'esprit des banias (бaня « bain ») dans la mythologie slave. Il élisait domicile dans la maisonnette adjacente à l'isba où les habitants venaient prendre leur bain. La pièce qui lui servait de domicile était dénuée d'images chrétiennes. Il n'emménage toutefois dans un nouveau bâtiment qu'après qu'une femme y ait accouché et s'y soit lavée (dans le temps, les femmes donnaient naissance à l'enfant dans le bania). Bien que rarement aperçu, il lui arrive de sortir de sa",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/d/d1/Bannik.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Bannik",
  "etape": "titre du CSV"
 },
 "mythologies-slaves|Zmeï Gorynytch": {
  "slug": "mythologies-slaves",
  "nom": "Zmeï Gorynytch",
  "titre": "Zmeï",
  "extrait": "Les Zmeï (ou Żmij, Zmey, Zmej) sont des créatures légendaires, dragons de la mythologie slave, éternels ennemis des dieux célestes ; parmi eux, les Zmeï Gorynytch (en russe : Змей Горыныч) sont littéralement « les dragons de la montagne ». Dans le langage courant slave, zmeï est le nom commun d'un serpent.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/44/Dobrynya_Nikitich_rescues_Zabava_from_the_Gorynych%2C_1941.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Zme%C3%AF",
  "etape": "titre du CSV"
 },
 "mythologies-slaves|Alkonost": {
  "slug": "mythologies-slaves",
  "nom": "Alkonost",
  "titre": "Alkonost",
  "extrait": "L’Alkonost (en russe : Алконост) est une créature mythologique slave que l’on trouve plus particulièrement dans les légendes russes. Elle a la tête et le buste d’une très belle femme et le corps d’un oiseau. Elle est un des oiseaux prophétiques du folklore russe avec Sirin et Gamayun. Le nom Alkonost vient du demi-dieu grec Alcyone transformé par les dieux en martin-pêcheur. Elle est aussi associée au dieu du soleil Khors.\nL'Alkonost est magique. Par exemple, durant les 6 à 7 jours où elle couve",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/28/Bilibin_Alkonost.JPG",
  "lien": "https://fr.wikipedia.org/wiki/Alkonost",
  "etape": "titre du CSV"
 },
 "mythologies-slaves|Sirin": {
  "slug": "mythologies-slaves",
  "nom": "Sirin",
  "titre": "Sirin",
  "extrait": "Sirin ou Sirine (en russe : Сирин) est une créature mythologique slave que l’on trouve plus particulièrement dans les légendes russes. Elle a la tête et le buste d’une très belle femme et le corps d’un oiseau (habituellement un hibou). Elle est un des oiseaux prophétiques du folklore russe avec Alkonost et Gamayun. Selon la légende, elle vit dans les « terres indiennes » proche d’Éden ou autour du fleuve Euphrate. Sirin était aussi considérée comme une sirène ou l’équivalent de la Wila polonaise",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/5/55/Bilibin_sirin_bi.JPG",
  "lien": "https://fr.wikipedia.org/wiki/Sirin",
  "etape": "titre du CSV"
 },
 "mythologies-slaves|Oiseau de feu": {
  "slug": "mythologies-slaves",
  "nom": "Oiseau de feu",
  "titre": "Oiseau de feu",
  "extrait": "Un oiseau de feu (du russe : жар-птица, jar-ptitsa) est un oiseau légendaire issu du folklore des pays slaves (Russie, Pologne, Ukraine…). Paré de plumes rougeoyantes et venu d'une terre lointaine, il représente en même temps une bénédiction et une malédiction pour celui qui le capture.\nLa légende a été popularisée par le ballet L'Oiseau de feu, composé en 1909-1910 par Igor Stravinsky pour les Ballets russes de Serge Diaghilev.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/8/8a/Firebird.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Oiseau_de_feu",
  "etape": "titre du CSV"
 },
 "mythologies-slaves|Perkūnas": {
  "slug": "mythologies-slaves",
  "nom": "Perkūnas",
  "titre": "Perkūnas",
  "extrait": "Perkunas (au lituanien Perkūnas), lettonien Pērkons, est le dieu balte Lettonien et lituanien du tonnerre et le dieu le plus important du panthéon balte. Dans les mythologies lituanienne et lettone, il est aussi identifié comme le dieu de la pluie, des montagnes, des chênes et du ciel.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c0/Perkunas_of_Kernav%C4%97s.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Perk%C5%ABnas",
  "etape": "titre du CSV"
 },
 "mythologies-slaves|Laima": {
  "slug": "mythologies-slaves",
  "nom": "Laima",
  "titre": "Laima",
  "extrait": "Dans les mythologies lettone et lituanienne, Laima (nommée aussi Laime ou Laimas māte, où māte signifie « mère ») est la personnification du destin et de la bonne et mauvaise fortune.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/3/33/Likte%C5%86a_Dieviete_Laima_22.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Laima",
  "etape": "titre du CSV"
 },
 "mythologies-africaines|Olorun": {
  "slug": "mythologies-africaines",
  "nom": "Olorun",
  "titre": "Ọlọrun",
  "extrait": "Ọlọrun (en ede : ɔlɔrun) ou Olódùmarè est le dieu suprême du panthéon yoruba.\nIl a créé l'univers, mais pas directement la vie sur Terre. Pour cela, il a donné à Obàtálá, chef des orishas, les outils pour le faire.\nLe dieu ne s'intéressant pas aux affaires des Hommes, ces derniers s'adressent donc aux orishas, qui sont les divinités susceptibles d'intervenir dans le monde.",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/%E1%BB%8Cl%E1%BB%8Drun",
  "etape": "titre du CSV"
 },
 "mythologies-africaines|Shango": {
  "slug": "mythologies-africaines",
  "nom": "Shango",
  "titre": "Shangô",
  "extrait": "Shangô, Sàngó (également typographié Sango ou Shango), souvent désigné sous le nom de Xangô ou Changó dans l'Amérique latine et les Caraïbes, et connu également sous le nom de Jakuta, est, dans les religions afro-américaines d'origine yoruba, l'orisha de la foudre et du tonnerre. Il est également l'orisha de la justice. \n\nIl a trois femmes, elles-mêmes orishas, qui sont Oya, Oshun, et Oba.  \nAu Brésil, il est représenté par la couleur rouge et blanche ; il apprécie le Quiabo gombo (légume capsul",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/9/96/Sango%27s_Shrine.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Shang%C3%B4",
  "etape": "titre du CSV"
 },
 "mythologies-africaines|Ogoun": {
  "slug": "mythologies-africaines",
  "nom": "Ogoun",
  "titre": "Ogun (divinité)",
  "extrait": "Ogun, Ogoun, ou Ogou, ou Gou, est au départ un orisha dans la mythologie yoruba, et un lwa du vaudou haïtien, qui se présente sous plusieurs aspects.\nIl préside au feu, au fer et à la guerre. Comme tel, il est le patron des forgerons. Il est le frère de Shangô.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/41/Statue_of_Ogun_shrine_at_the_Sacred_Grove_Of_Oshun.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Ogun_%28divinit%C3%A9%29",
  "etape": "titre du CSV"
 },
 "mythologies-africaines|Eshu": {
  "slug": "mythologies-africaines",
  "nom": "Eshu",
  "titre": "Eshu",
  "extrait": "Eshu, Exú ou Èṣù est un esprit (Orisha) d'origine africaine, issu des traditions religieuse des Yorubas. Il est l’orixá central du candomblé brésilien, que l'on retrouve dans le vaudou sous le nom de Papa Legba. Il est connu sous les noms de : Exu, Èṣù, Eshu, Bara, Legbá, Elegbara, Eleggua, Aluvaiá, Bombo Njila, Pambu Njila. On le retrouve au Bénin et dans l'ancien royaume du Dahomey dans les villes suivantes : Ondo, Ilesa, Ijebu, Abeokuta, Ekiti, Lagos.",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Eshu",
  "etape": "titre du CSV"
 },
 "mythologies-africaines|Oya": {
  "slug": "mythologies-africaines",
  "nom": "Oya",
  "titre": "Oya",
  "extrait": "Oya, Oyá, ou Iansã (dans le candomblé brésilien) est une divinité originaire des traditions religieuses yorubas. Elle est l'orisha du vent, de la tempête, des éclairs, de la mort et de la renaissance. Dans la santería cubaine, elle est apparentée à la Notre-Dame de Candelaria et à sainte Thérèse d'Avila.",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Oya",
  "etape": "titre du CSV"
 },
 "mythologies-africaines|Orunmila": {
  "slug": "mythologies-africaines",
  "nom": "Orunmila",
  "titre": "Ọrunmila",
  "extrait": "Ọrunmila (nommé Ọrúnla ou Orúla en Amérique latine) est l'Orisha (divinité Yoruba) de la sagesse, de la connaissance et de la divination, ainsi que le premier Babalawo.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/45/IMG-20180922-WA0007_cropped.jpg",
  "lien": "https://fr.wikipedia.org/wiki/%E1%BB%8Crunmila",
  "etape": "titre du CSV"
 },
 "mythologies-africaines|Nyame": {
  "slug": "mythologies-africaines",
  "nom": "Nyame",
  "titre": "Nyame",
  "extrait": "Nyame (ou Nyankopon) est le dieu suprême de l'Akom, la religion traditionnelle du peuple Akan du Ghana. Il est le dieu créateur, ominiscient et omnipotent.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/e/e3/Gye_Nyame_%28Adinkra_Symbol%29.svg",
  "lien": "https://fr.wikipedia.org/wiki/Nyame",
  "etape": "titre du CSV"
 },
 "mythologies-africaines|Asase Ya": {
  "slug": "mythologies-africaines",
  "nom": "Asase Ya",
  "titre": "Asase Ya",
  "extrait": "Asase Ya (ou Asase Yaa) est l'esprit ou la déesse de la terre et de la fertilité agricole ainsi que de l'amour, de la paix et de la vérité dans la religion akan. C'est la deuxième divinité en puissance après Nyame et elle présentée souvent comme son épouse.\n« Ya », dans le calendrier akan (en), désigne une femme née le jeudi, et ses adeptes s'abstiennent donc de travailler la terre ce jour-là, en son honneur. Elle n'a ni prêtre ni sanctuaire car, à l'instar de Nyame, elle n'est pas un abosom que",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/8/8b/Asase_Ye_Duru.svg",
  "lien": "https://fr.wikipedia.org/wiki/Asase_Ya",
  "etape": "titre du CSV"
 },
 "mythologies-africaines|Mami Wata": {
  "slug": "mythologies-africaines",
  "nom": "Mami Wata",
  "titre": "Mami Wata",
  "extrait": "Mami Wata (ou Mamy Wata, Mami Watta ou Mama Wata), est une divinité aquatique du culte africain vodoun, dont le culte est répandu en Afrique de l'Ouest, du Centre et du Sud, dans la diaspora africaine, les Caraïbes, et dans certaines régions d'Amérique du Nord et du Sud.\n\n",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c1/Mami_Wata_poster.png",
  "lien": "https://fr.wikipedia.org/wiki/Mami_Wata",
  "etape": "titre du CSV"
 },
 "mythologies-africaines|Damballa": {
  "slug": "mythologies-africaines",
  "nom": "Damballa",
  "titre": "Damballa",
  "extrait": "Dambalah, Damballa ou Damballah, est l'esprit vaudou de la fécondité, de la bonté, et de la connaissance symbolisé par la couleuvre ou le boa. \nIl est en couple avec Ayida Wedo, la maîtresse du ciel. Il apporte et communique les connaissances occultes et le savoir ; il est un grand esprit de fertilité et de sagesse qui aidera également à éviter les mauvais pas et à prendre les bonnes directions.\nIl représente le principe du bien, et vit près des rivières et des sources. Sa couleur est le blanc, ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/4a/VeveDamballah.svg",
  "lien": "https://fr.wikipedia.org/wiki/Damballa",
  "etape": "titre du CSV"
 },
 "mythologies-africaines|Nyambe": {
  "slug": "mythologies-africaines",
  "nom": "Nyambe",
  "titre": "Nyambe",
  "extrait": "Nyambe ou Nyambɛ̂, dans la spiritualité traditionnelle du peuple Bassa, désigne Dieu comme étant l'éternité du cosmos avec toute sa sagesse, sa puissance et sa beauté'[source insuffisante]. Avec l'arrivée du christianisme, il devient la traduction en langue Bassa de Dieu créateur de l'univers dans les écrits bibliques de l'église protestante'[source insuffisante].",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f2/Seated_Male_Figure_MET_DP285728.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Nyambe",
  "etape": "titre du CSV"
 },
 "mythologies-africaines|Nommo": {
  "slug": "mythologies-africaines",
  "nom": "Nommo",
  "titre": "Nommo",
  "extrait": "Les nommo sont, dans la mythologie des Dogons du Mali, des génies ancestraux des eaux (parfois décrits comme des dieux).",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/9/97/Brooklyn_Museum_1989.51.39_Nommo_Figure_with_Raised_Arms.jpg",
