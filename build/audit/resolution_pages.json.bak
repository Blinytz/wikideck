 "grands-peintres|Paul Signac": {
  "slug": "grands-peintres",
  "nom": "Paul Signac",
  "titre": "Paul Signac",
  "extrait": "Paul Signac, né le 11 novembre 1863 à Paris et mort le 15 août 1935 dans la même ville, est un peintre paysagiste français, proche du mouvement libertaire, qui donna naissance au pointillisme, avec le peintre Seurat. Il a aussi mis au point la technique du divisionnisme. Cofondateur avec Seurat de la Société des artistes indépendants dont il fut président, il est ami avec Victor Dupont, peintre fauve et vice-président du Salon.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/4b/Paul_Signac_1923.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Paul_Signac",
  "etape": "titre du CSV"
 },
 "grands-peintres|Henri Rousseau": {
  "slug": "grands-peintres",
  "nom": "Henri Rousseau",
  "titre": "Henri Rousseau",
  "extrait": "Henri Rousseau, aussi appelé « Le Douanier Rousseau », né le 21 mai 1844 à Laval (Mayenne), mort le 2 septembre 1910 à Paris, est un peintre français, considéré comme un représentant majeur de l'art naïf.\nIssu d'une famille modeste, il est successivement commis d’avocat à Nantes, militaire à Angers, avant de partir pour Paris où il travaille d'abord comme clerc d’huissier, puis pour l'octroi de la ville, y occupant un poste de commis de deuxième classe, dans le cadre duquel il contrôle les entré",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/6/69/Douanier_Rousseau_Dornac.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Henri_Rousseau",
  "etape": "titre du CSV"
 },
 "grands-peintres|Odilon Redon": {
  "slug": "grands-peintres",
  "nom": "Odilon Redon",
  "titre": "Odilon Redon",
  "extrait": "Odilon Redon, pseudonyme de Bertrand Redon, né le 20 avril 1840 à Bordeaux et mort le 6 juillet 1916 à Paris, est un peintre et graveur symboliste et onirique français.\nSon art explore les aspects de la pensée, la part sombre et ésotérique de l'âme humaine, empreinte des mécanismes du rêve.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/4c/Odilon_Redon_vers_1880.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Odilon_Redon",
