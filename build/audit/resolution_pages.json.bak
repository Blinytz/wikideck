 "races-de-chat|Munchkin": {
  "slug": "races-de-chat",
  "nom": "Munchkin",
  "titre": "Munchkin (chat)",
  "extrait": "Le munchkin est une race de chat originaire des États-Unis, issu de mutation génétique spontanée (l'achondroplasie) survenue en 1983. Ce chat est caractérisé par ses pattes courtes, d'où le surnom de « chat basset » qu'on lui donne parfois. Il est souvent qualifié de « chat miniature » ou de « chat nain », bien que ce soit faux, puisque le munchkin possède un corps de taille normale. Seules ses pattes sont plus courtes que la moyenne.\n\n",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/28/Munchkinshorthaired.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Munchkin_%28chat%29",
  "etape": "titre qualifié"
 },
 "races-de-chat|Savannah": {
  "slug": "races-de-chat",
  "nom": "Savannah",
  "titre": "Savannah (chat)",
  "extrait": "Le savannah est une race de chats, créée aux États-Unis vers 1986. Ce chat de grande taille résulte du croisement entre un serval mâle et une chatte, puis , à partir de la cinquième génération, de l'hybride mâle ainsi obtenu avec une chatte (les quatre ou cinq premières générations d’hybrides mâles sont stériles, à la différence des femelles).\nIl montre plusieurs ressemblances physiques avec le serval, dont la taille, la couleur et les oreilles de forme caractéristique. Il pèse entre six et quat",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c4/Savannah_Cat_portrait.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Savannah_%28chat%29",
  "etape": "titre qualifié"
 },
