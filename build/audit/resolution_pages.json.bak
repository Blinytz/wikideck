 "empires-et-civilisations|Empire d'Alexandre le Grand": {
  "slug": "empires-et-civilisations",
  "nom": "Empire d'Alexandre le Grand",
  "titre": "Bilan du règne d'Alexandre le Grand",
  "extrait": "Le bilan du règne d'Alexandre le Grand se fonde sur une étude de la gestion politique et économique des territoires conquis ou soumis à son autorité. La première conséquence des conquêtes d'Alexandre le Grand est la formation d'un des plus vastes empires jamais constitués jusqu'alors, agglomérant l'empire perse achéménide, le royaume de Macédoine, la Grèce et les confins du nord-ouest de l'Inde. Tous les pouvoirs dont Alexandre est détenteur, par héritage ou par conquête, sont réunis entre ses s",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/b/bd/Macedonia_%28ancient_kingdom%2C_greatest_extent%29.svg",
  "lien": "https://fr.wikipedia.org/wiki/Bilan_du_r%C3%A8gne_d%27Alexandre_le_Grand",
  "etape": "titre du CSV"
 },
 "empires-et-civilisations|Empire séleucide": {
  "slug": "empires-et-civilisations",
  "nom": "Empire séleucide",
  "titre": "Séleucides",
  "extrait": "Les Séleucides (en grec ancien Σελευκίδαι / Seleukídai) sont une dynastie de l'époque hellénistique issue de Séleucos Ier, l'un des Diadoques d'Alexandre le Grand, qui a constitué un empire formé de la majeure partie des territoires orientaux conquis par Alexandre, allant de l'Anatolie à l'Indus. Les Séleucides règnent de la fin du IVe au Ier siècle av. J.-C., avec pour cœur politique la Syrie, d'où l'appellation courante dès l'Antiquité de « rois de Syrie ». Les Séleucides règnent jusqu'au IIe ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/9/94/Seleucid_Empire_alternative_map.jpg",
