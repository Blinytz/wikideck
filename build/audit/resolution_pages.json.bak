 "grands-peintres|Nicolas de Staël": {
  "slug": "grands-peintres",
  "nom": "Nicolas de Staël",
  "titre": "Nicolas de Staël",
  "extrait": "Nicolas de Staël (prononcé [stal]), baron Nikolaï Vladimirovitch Staël von Holstein (en russe : Николай Владимирович Шталь фон Гольштейн), né le 23 décembre 1913 (5 janvier 1914 dans le calendrier grégorien) à Saint-Pétersbourg et mort le 16 mars 1955 à Antibes, est un peintre français originaire de Russie, issu d'une branche cadette de la famille Staël von Holstein.\nLa carrière de Nicolas de Staël s'étend sur quinze ans, de 1940 à sa mort. Artiste prolifique, il peint durant ces années plus d'u",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/70/Photographie_de_Nicolas_de_Sta%C3%ABl.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Nicolas_de_Sta%C3%ABl",
  "etape": "titre du CSV"
 },
 "grands-peintres|Pierre Soulages": {
  "slug": "grands-peintres",
  "nom": "Pierre Soulages",
  "titre": "Pierre Soulages",
  "extrait": "Pierre Soulages, né le 24 décembre 1919 à Rodez (Aveyron) et mort le 25 octobre 2022 à Nîmes (Gard), est un peintre et graveur français.\nAssocié depuis la fin des années 1940 à l'art abstrait, un temps rapproché de l'action painting et de l'abstraction lyrique, il travaille hors de tout groupe et son œuvre échappe à tout positionnement théorique collectif. Particulièrement connu pour son usage des reflets de la couleur noire, qu'il appelle « noir-lumière » ou « outrenoir », il peut néanmoins êtr",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/b/b0/655446-artiste-pierre-soulages_%28cropped%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Pierre_Soulages",
  "etape": "titre du CSV"
 },
 "grands-peintres|Yves Klein": {
  "slug": "grands-peintres",
  "nom": "Yves Klein",
  "titre": "Yves Klein",
  "extrait": "Yves Klein est un artiste français, né le 28 avril 1928 à Nice et mort le 6 juin 1962 à Paris.\nEn 1954, il se tourne définitivement vers l'art et entame son « Aventure monochrome ».\nYves Klein est notamment connu pour son bleu outremer, qu’il nommera « IKB » (International Klein Blue).\nDe ses monochromes, au vide, à la « technique des pinceaux vivants » ou « Anthropométrie », jusqu'à l'emploi des éléments de la nature afin de manifester leur force créatrice ou de l’or qu’il utilise comme un pass",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/0c/Yves_Klein_in_front_of_one_of_his_canvases_%281962%29_%28cropped%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Yves_Klein",
  "etape": "titre du CSV"
 },
 "grands-peintres|Roy Lichtenstein": {
  "slug": "grands-peintres",
  "nom": "Roy Lichtenstein",
  "titre": "Roy Lichtenstein",
  "extrait": "Roy Lichtenstein, né le 27 octobre 1923 à Manhattan (New York), où il est mort le 29 septembre 1997, est un des artistes les plus importants du mouvement pop art américain. Ses œuvres s'inspirent fortement de la publicité et de l'imagerie populaire de son époque, ainsi que des bandes dessinées (« comics »). Il décrit lui-même son style comme étant « aussi artificiel que possible ».",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c3/Roy_Lichtenstein_%281967%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Roy_Lichtenstein",
  "etape": "titre du CSV"
 },
 "grands-peintres|Willem de Kooning": {
  "slug": "grands-peintres",
  "nom": "Willem de Kooning",
  "titre": "Willem de Kooning",
  "extrait": "Willem De Kooning, né le 24 avril 1904 à Rotterdam et mort le 19 mars 1997 à Long Island (New York), est un peintre d'origine néerlandaise, naturalisé américain, précurseur de l'expressionnisme abstrait.\nDe Kooning peint des figures, des portraits, en utilisant la gouache, l'aquarelle, le pastel, les techniques mixtes ; il est aussi sculpteur et dessinateur.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/0/09/Willem_de_Kooning_in_his_studio.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Willem_de_Kooning",
  "etape": "titre du CSV"
 },
 "grands-peintres|Jean Dubuffet": {
  "slug": "grands-peintres",
  "nom": "Jean Dubuffet",
  "titre": "Jean Dubuffet",
  "extrait": "Jean Dubuffet, né le 31 juillet 1901 au Havre et mort le 12 mai 1985 à Paris 6e, est un peintre, sculpteur et plasticien français, le premier théoricien d'un style d'art auquel il a donné le nom d'« art brut », des productions de marginaux ou de malades mentaux : peintures, sculptures, calligraphies, dont il reconnaît s'être lui-même largement inspiré.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c8/Paolo_Monti_-_Serie_fotografica_%28Italia%2C_1960%29_-_BEIC_6363665_dettaglio.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Jean_Dubuffet",
  "etape": "titre du CSV"
 },
 "grands-peintres|Gerhard Richter": {
  "slug": "grands-peintres",
  "nom": "Gerhard Richter",
  "titre": "Gerhard Richter",
  "extrait": "Gerhard Richter, né à Dresde le 9 février 1932, est un artiste peintre allemand dont l'œuvre est reconnue, depuis les années 1980, « comme une expérience artistique inédite et remarquable ».\nPeintre polymorphe, il aborde des sujets figuratifs ou produit des œuvres abstraites.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/7f/Gerhard_Richter%2C_Prague_%282017%29.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Gerhard_Richter",
  "etape": "titre du CSV"
 },
 "grands-peintres|Anselm Kiefer": {
  "slug": "grands-peintres",
  "nom": "Anselm Kiefer",
  "titre": "Anselm Kiefer",
  "extrait": "Anselm Kiefer, né le 8 mars 1945 à Donaueschingen, est un artiste plasticien contemporain allemand. Il vit et travaille en France à Barjac (Gard) et en région parisienne.\nÉtabli en France depuis 1993, il est l’un des artistes allemands les plus célèbres des années 2000 et compte parmi les artistes vivants dont les œuvres atteignent les sommes les plus élevées.",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Anselm_Kiefer",
  "etape": "titre du CSV"
 },
 "grands-peintres|Yayoi Kusama": {
  "slug": "grands-peintres",
  "nom": "Yayoi Kusama",
  "titre": "Yayoi Kusama",
  "extrait": "Yayoi Kusama (草間 彌生, Kusama Yayoi, parfois écrit 草間 弥生), née le 22 mars 1929 à Matsumoto (préfecture de Nagano), est une artiste contemporaine japonaise avant-gardiste, peintre, sculptrice et écrivaine.\nElle utilise souvent des pois et des couleurs sur ses œuvres.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f5/20130918Yayoi_Kusama1.jpg",
