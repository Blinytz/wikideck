 "inventions-importantes|Télégraphe": {
  "slug": "inventions-importantes",
  "nom": "Télégraphe",
  "titre": "Télégraphie électrique",
  "extrait": "Un télégraphe électrique est un système de messagerie texte point à point, principalement utilisés des années 1840 à la fin du XXe siècle. Il s'agit du premier système de télécommunications électriques et du plus répandu des premiers systèmes de messagerie appelés télégraphes, qui ont été conçus pour communiquer des messages textuels plus rapidement que le transport physique. La télégraphie électrique peut être considérée comme le premier exemple d'électrotechnique.\nLa télégraphie textuelle cons",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/2/2c/Cooke_and_Wheatstone_electric_telegraph.jpg",
  "lien": "https://fr.wikipedia.org/wiki/T%C3%A9l%C3%A9graphie_%C3%A9lectrique",
  "etape": "titre du CSV"
 },
 "inventions-importantes|Téléphone": {
  "slug": "inventions-importantes",
  "nom": "Téléphone",
  "titre": "Téléphone",
  "extrait": "Le téléphone est un appareil de communication initialement conçu pour transmettre la voix humaine et pouvoir communiquer à distance.\nPour fonctionner, le téléphone nécessite une infrastructure terrestre ou spatiale : le réseau téléphonique. Après y avoir raccordé son terminal fixe ou avoir allumé son téléphone mobile, l'utilisateur ayant souscrit un abonnement auprès d'un opérateur de télécommunications peut passer un appel téléphonique à un destinataire également raccordé en composant son numér",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/a6/Telefon_BW_2012-02-18_13-44-32.JPG",
  "lien": "https://fr.wikipedia.org/wiki/T%C3%A9l%C3%A9phone",
  "etape": "titre du CSV"
 },
 "inventions-importantes|Machine à écrire": {
  "slug": "inventions-importantes",
  "nom": "Machine à écrire",
  "titre": "Machine à écrire",
  "extrait": "Une machine à écrire est une machine mécanographique permettant de produire des documents avec des caractères imprimés. Elle se présente sous la forme d'un clavier comportant une cinquantaine de touches représentant les caractères qui seront imprimés sur le papier.\nElle peut être portative et légère (pour travailler en voyageant), intermédiaire ou de bureau (plus lourde, mais moins fragile).\nElle a été utilisée de la fin du XIXe siècle (notamment par les dactylographes, ou « dactylos ») jusqu'à ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/17/Olympia_Simplex.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Machine_%C3%A0_%C3%A9crire",
  "etape": "titre du CSV"
 },
 "inventions-importantes|GPS": {
  "slug": "inventions-importantes",
  "nom": "GPS",
  "titre": "Global Positioning System",
  "extrait": "Le Global Positioning System (GPS) (en français : « Système mondial de positionnement » [littéralement] ou « Géo-positionnement par satellite »), originellement connu sous le nom de Navstar GPS, est un système de positionnement par satellites appartenant au gouvernement fédéral des États-Unis. Mis en place par le département de la Défense des États-Unis à des fins militaires à partir de 1973, le système avec vingt-quatre satellites est totalement opérationnel en 1995.\nLes signaux transmis par le",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/17/Navstar.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Global_Positioning_System",
  "etape": "titre du CSV"
 },
 "inventions-importantes|Intelligence Artificielle": {
  "slug": "inventions-importantes",
  "nom": "Intelligence Artificielle",
  "titre": "Intelligence artificielle",
  "extrait": "L'intelligence artificielle (IA) est l'ensemble des systèmes informatiques capables d'effectuer des tâches typiquement associées à l'intelligence, telles que l'apprentissage, le raisonnement, la résolution de problèmes, la perception ou la prise de décision. L'intelligence artificielle est également le champ de recherche visant à développer de tels systèmes.\nL'IA est un domaine de l'informatique qui s'appuie sur des fondements mathématiques (statistiques, algèbre linéaire, probabilités) et des c",
  "illustration": "",
  "lien": "https://fr.wikipedia.org/wiki/Intelligence_artificielle",
  "etape": "titre du CSV"
 },
 "oiseaux|Grand Corbeau": {
  "slug": "oiseaux",
  "nom": "Grand Corbeau",
  "titre": "Grand Corbeau",
  "extrait": "Le Grand Corbeau (Corvus corax) est une espèce d'oiseaux de la famille des corvidés. Il est le plus grand oiseau de l'ordre des passeriformes après le corbeau corbivau, et probablement le passereau le plus lourd. Présent dans tout l'hémisphère nord, c’est l’espèce de corvidé dont l’aire de répartition est la plus étendue. Les grands corbeaux vivent généralement de 10 à 15 ans mais certains individus ont vécu 40 ans. Les juvéniles peuvent se déplacer en groupes mais les couples appariés restent e",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/78/Corvus_corax_%28Common_Raven%29%2C_Yosemite_NP%2C_CA%2C_US_-_Diliff.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Grand_Corbeau",
  "etape": "titre du CSV"
 },
