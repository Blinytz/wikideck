 },
 "mythologies-asie-est|Yamata no Orochi": {
  "slug": "mythologies-asie-est",
  "nom": "Yamata no Orochi",
  "titre": "Yamata-no-Orochi",
  "extrait": "Le Yamata-no-Orochi (ヤマタノオロチ (Yamata no Orochi), également écrit (八岐大蛇), (八俣遠呂智), ou (八俣遠呂知)), également simplement désigné sous le nom d’Orochi (大蛇 (Orochi)), est un serpent draconiforme doté de huit têtes et huit queues issue de la mythologie japonaise dans laquelle il tient une place importante, de par sa mention dans les grands récits fondateurs du Japon compilés dans le Kojiki et le Nihon Shoki.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/4b/11.36845-Utagawa_Kuniteru_I-Museum_of_Fine_Art_Boston.jpg",
