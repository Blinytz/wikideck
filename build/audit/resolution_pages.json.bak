 },
 "souverains-et-conquerants|Néron": {
  "slug": "souverains-et-conquerants",
  "nom": "Néron",
  "titre": "Néron",
  "extrait": "Néron (latin : Imperator Nero Claudius Caesar Augustus Germanicus, grec ancien : Νέρων / nérōn), né Lucius Domitius Ahenobarbus le 15 décembre 37 à Antium et mort le 9 juin 68 à Rome, est empereur romain du 13 octobre 54 jusqu'à sa mort. Il est le cinquième et dernier empereur romain de la dynastie julio-claudienne.\nNé de l'union entre Cnaeus Domitius Ahenobarbus et Agrippine la Jeune, il accède au trône après la mort de son grand-oncle Claude, qui l'avait adopté et nommé successeur au détriment",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/5/52/Et%C3%A0_romana_imperiale%2C_busto_di_nerone%2C_da_olbia%2C_54-59_dc_ca.jpg",
