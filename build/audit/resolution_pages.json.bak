 "grands-explorateurs|Louis Antoine de Bougainville": {
  "slug": "grands-explorateurs",
  "nom": "Louis Antoine de Bougainville",
  "titre": "Louis-Antoine de Bougainville",
  "extrait": "Le comte Louis-Antoine de Bougainville, né le 12 novembre 1729 à Paris (paroisse Saint-Merry) et mort le 31 août 1811 à Paris (ancien 3e arrondissement), est un officier de marine, explorateur et écrivain français.\nIl a mené en tant que capitaine, de 1766 à 1769, le premier tour du monde commandité par le gouvernement français. Le récit qu'il en a fait dans son Voyage autour du monde, journal de bord publié en 1771, fit sensation dans les sociétés européennes de l'époque. Cet ouvrage allait insp",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/1f/Ducreux_-_Louis_Antoine_de_Bougainville.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Louis-Antoine_de_Bougainville",
  "etape": "titre du CSV"
 },
 "grands-explorateurs|Jeanne Baret": {
  "slug": "grands-explorateurs",
  "nom": "Jeanne Baret",
  "titre": "Jeanne Barret",
  "extrait": "Jeanne Barret (également écrit Baré, Baret ou Barer), née le 27 juillet 1740 à La Comelle et morte le 5 août 1807 à Saint-Aulaye (Saint-Antoine-de-Breuilh) est une exploratrice et botaniste française.\nMembre de l'expédition de Bougainville sur la Boudeuse et l'Étoile de 1766 à 1769, elle est notamment connue pour être la première femme à avoir fait le tour du monde. Déguisée en homme, sous le nom de Jean Barret, elle s’est enrôlée comme valet et assistant du naturaliste de l’expédition, Philiber",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/78/Jeanne_Barret_Madlla_Bare.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Jeanne_Barret",
  "etape": "titre du CSV"
 },
 "grands-explorateurs|Jules Dumont d'Urville": {
  "slug": "grands-explorateurs",
  "nom": "Jules Dumont d'Urville",
  "titre": "Jules Dumont d'Urville",
  "extrait": "Jules Sébastien César Dumont d’Urville, né à Condé-sur-Noireau (Calvados) le 23 mai 1790 et mort accidentellement à Meudon le 8 mai 1842, est un officier de marine et explorateur français qui participa à plusieurs voyages d'exploration scientifique entre 1822 et 1840, notamment à bord de l'Astrolabe.\nEn 1840, il est un des premiers à poser le pied en Antarctique et découvre la terre Adélie.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/5/5f/Dumont_d%27Urville.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Jules_Dumont_d%27Urville",
  "etape": "titre du CSV"
 },
 "grands-explorateurs|René Caillié": {
  "slug": "grands-explorateurs",
  "nom": "René Caillié",
  "titre": "René Caillié",
  "extrait": "René Caillié ou René Caillé, né le 19 novembre 1799 (28 Brumaire An VIII) à Mauzé-sur-le-Mignon (Deux-Sèvres) et mort le 17 mai 1838 à La Gripperie-Saint-Symphorien (Charente-Maritime), est un explorateur français, figure emblématique de l'exploration africaine. Il est surtout connu pour avoir été le premier Européen à atteindre Tombouctou et à en revenir vivant, exploit qui a fait de lui une célébrité à son époque.\n\n",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/f/f9/Ren%C3%A9_Cailli%C3%A9.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Ren%C3%A9_Cailli%C3%A9",
  "etape": "titre du CSV"
 },
 "grands-explorateurs|Heinrich Barth": {
  "slug": "grands-explorateurs",
  "nom": "Heinrich Barth",
  "titre": "Heinrich Barth",
  "extrait": "Heinrich Barth (né le 16 février 1821 à Hambourg - mort le 25 novembre 1865 à Berlin) est un explorateur de l'Afrique occidentale, mais aussi un linguiste, géographe, ethnologue et anthropologue allemand. Au cours d'une expédition organisée par le gouvernement britannique de 1849 à 1855, il subit les plus rudes épreuves pendant un voyage de près de 5 ans (1850-1855), sous un climat accablant et parmi des populations inconnues des Européens, et voit tomber autour de lui les deux autres membres de",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/7a/Barth_Unterschrift.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Heinrich_Barth",
  "etape": "titre du CSV"
 },
 "grands-explorateurs|Pierre Savorgnan de Brazza": {
  "slug": "grands-explorateurs",
  "nom": "Pierre Savorgnan de Brazza",
  "titre": "Pierre Savorgnan de Brazza",
  "extrait": "Pierre Savorgnan de Brazza, né le 26 janvier 1852 à Rome et mort le 14 septembre 1905 à Dakar, est une figure majeure de l'exploration et de la colonisation française en Afrique centrale. D'origine italienne, naturalisé français, il est connu pour ses expéditions dans le bassin du Congo et pour son rôle dans la fondation du Congo français.\nIssu de l'aristocratie romaine, il est attiré très tôt par l'aventure et l'exploration. Après avoir servi dans la marine française, il se tourne vers l'Afriqu",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/18/Pierre_Savorgnan_de_Brazza_by_Paul_Nadar.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Pierre_Savorgnan_de_Brazza",
  "etape": "titre du CSV"
 },
 "grands-explorateurs|Alexandra David-Néel": {
  "slug": "grands-explorateurs",
  "nom": "Alexandra David-Néel",
  "titre": "Alexandra David-Néel",
  "extrait": "Louise Eugénie Alexandrine Marie David, plus connue sous le nom d’Alexandra David-Néel, née le 24 octobre 1868 à Saint-Mandé et morte le 8 septembre 1969 à Digne-les-Bains, est une orientaliste, tibétologue, chanteuse d'opéra, journaliste, écrivaine et exploratrice, féministe, anarchiste, franc-maçonne et bouddhiste française.\nElle est, en 1924, la première femme occidentale à atteindre Lhassa, capitale du Tibet, exploit dont les journaux se font l'écho un an plus tard et qui contribue fortement",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/8/8c/Alexandra_David-Neels.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Alexandra_David-N%C3%A9el",
  "etape": "titre du CSV"
 },
 "grands-explorateurs|Isabelle Eberhardt": {
