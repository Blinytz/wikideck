 },
 "monuments-emblematiques|Palais d'Hiver": {
  "slug": "monuments-emblematiques",
  "nom": "Palais d'Hiver",
  "titre": "Palais d'Hiver",
  "extrait": "Le palais d'Hiver (en russe : Зимний дворец, IPA : [ˈzʲimnʲɪj dvɐˈrʲɛts], Zimnij dvorets) à Saint-Pétersbourg, en Russie, était, de 1732 à 1917, la résidence officielle des monarques russes. Aujourd'hui, le palais restauré fait partie d'un ensemble de bâtiments abritant le musée de l'Ermitage. Situé entre le quai du Palais et la place du Palais, adjacent au site du palais d'Hiver original de Pierre le Grand, le Palais d'Hiver actuel et quatrième a été construit et modifié presque continuellement",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/7/75/Winter_Palace_Panorama_2.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Palais_d%27Hiver",
  "etape": "titre du CSV"
 },
 "monuments-emblematiques|Mur de Berlin": {
  "slug": "monuments-emblematiques",
  "nom": "Mur de Berlin",
  "titre": "Mur de Berlin",
  "extrait": "Le mur de Berlin (en allemand : Berliner Mauer, /bɛʁˌliːnɐ ˈmaʊ̯ɐ/ ), parfois appelé « mur de la honte » (Schandmauer) par les Ouest-Allemands et officiellement appelé par le gouvernement est-allemand « rempart antifasciste » (Antifaschistischer Schutzwall), est érigé en plein Berlin dès la nuit du 12 au 13 août 1961 par la République démocratique allemande (RDA), d'abord sous la forme de rideau de fils de fer barbelé, au cours du mois d'août et de septembre 1961, puis sous la forme d'un mur en ",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/5/5d/Berlinermauer.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Mur_de_Berlin",
  "etape": "titre du CSV"
 },
 "monuments-emblematiques|Château de Bran": {
  "slug": "monuments-emblematiques",
  "nom": "Château de Bran",
  "titre": "Château de Bran",
  "extrait": "Le château de Bran (Castelul Bran en roumain) près de Brașov en Transylvanie, non loin de la limite avec la Valachie, est un monument historique classé et un lieu touristique de Roumanie.\nLe château est redevenu la propriété des Habsbourg, comme il l'avait déjà été avant 1918, au temps de l'Autriche-Hongrie, mais le premier château a été construit par les chevaliers Teutoniques au début du XIIIe siècle bien avant la dynastie habsbourgeoise. Surnommé « le château de Dracula », il est associé, dan",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/1/17/Castelul_Bran2.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Ch%C3%A2teau_de_Bran",
  "etape": "titre du CSV"
 },
 "monuments-emblematiques|Dôme du Rocher": {
  "slug": "monuments-emblematiques",
  "nom": "Dôme du Rocher",
  "titre": "Dôme du Rocher",
  "extrait": "Le dôme du Rocher ou la coupole du Rocher (en arabe : قبة الصخرة (Qubbat Aṣ-Ṣakhrah) ; en hébreu : כיפת הסלע (Kippat ha-Sel‘a)) — appelé parfois mosquée d'Omar — est un sanctuaire érigé à la fin du VIIe siècle sur ordre du calife Abd al-Malik sur le mont du Temple, sur l'« Esplanade des Mosquées ». Ce site représente le troisième lieu saint de l'islam comprenant également la mosquée Al-Aqsa à Jérusalem-Est.\nLe dôme du Rocher est désigné par l'UNESCO comme site du patrimoine mondial.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/c/c3/Jerusalem_DomeoftheRock_J65.JPG",
  "lien": "https://fr.wikipedia.org/wiki/D%C3%B4me_du_Rocher",
  "etape": "titre du CSV"
 },
 "monuments-emblematiques|Masjid al-Haram": {
  "slug": "monuments-emblematiques",
  "nom": "Masjid al-Haram",
  "titre": "Mosquée al-Haram",
  "extrait": "La mosquée al-Haram (en arabe : الْمَسْجِدُ ٱلْحَرَام, al-Masjid al-Ḥaram, « la Mosquée sacrée »), ou grande mosquée de la Mecque, est une mosquée à La Mecque, en Arabie saoudite. Elle est le premier lieu saint de l'islam et la plus grande mosquée du monde, qui abrite en son centre la Kaaba, le plus important sanctuaire de l'islam, dans lequel est enchâssée la pierre noire. C'est elle que les musulmans tentent de toucher au cours des ṭawāf (circumambulations) qu'ils accomplissent durant leur pèl",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/3/3f/Great_Mosque_of_Mecca1.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Mosqu%C3%A9e_al-Haram",
  "etape": "titre du CSV"
 },
 "monuments-emblematiques|Krak des Chevaliers": {
  "slug": "monuments-emblematiques",
  "nom": "Krak des Chevaliers",
  "titre": "Krak des Chevaliers",
  "extrait": "Le krak des Chevaliers (en arabe : قلعة الحصن Qal`at al-Hosn, « La forteresse imprenable » ou littéralement « Le château de la forteresse » ), krak de l'Hospital (voir krak) est un château fort, emblématique de la Renaissance du XIIe siècle. Datant de l'époque des croisades, il est situé dans l'ouest de la Syrie, sur les derniers contreforts du jabal Ansariya. Depuis 2006, il est inscrit sur la liste du patrimoine mondial de l'UNESCO.\nLes Hospitaliers de l'ordre de Saint-Jean de Jérusalem gèrent",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/4/40/KRAK_DES_CHEVALIERS_-_GAR_-_6-00.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Krak_des_Chevaliers",
  "etape": "titre du CSV"
 },
 "monuments-emblematiques|Mosquée Hassan-II": {
  "slug": "monuments-emblematiques",
  "nom": "Mosquée Hassan-II",
  "titre": "Mosquée Hassan-II",
  "extrait": "La mosquée Hassan-II (arabe : مسجد الحسن الثاني) est une grande mosquée située à Casablanca (Maroc). Érigée en partie sur la mer, elle est un complexe religieux et culturel, aménagée sur neuf hectares et comporte une salle de prières, une salle d'ablutions, des bains, une école coranique (madrasa), une bibliothèque, un musée, et une Académie des arts traditionnels.\nAutrefois gratuit, l'accès à l'esplanade de la mosquée Hassan II coûte 70 dirhams depuis novembre 2024.\nLe site officiel de la fonda",
  "illustration": "https://upload.wikimedia.org/wikipedia/fr/f/fc/Mosqu%C3%A9e_Hassan_II_-_2016-04-13.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Mosqu%C3%A9e_Hassan-II",
  "etape": "titre du CSV"
 },
 "monuments-emblematiques|Borobudur": {
  "slug": "monuments-emblematiques",
  "nom": "Borobudur",
  "titre": "Temple de Borobudur",
  "extrait": "Le temple de Borobudur (en indonésien : Candi Borobudur ; en javanais : Candhi Barabudhur) est une importante construction bouddhiste, bâtie aux VIIIe et IXe siècles à l'époque de la dynastie Sailendra dans le centre de l'île de Java en Indonésie.\nLe site, construit aux alentours de l'an 800, semble avoir été abandonné vers l'an 1100.\nPendant une tournée d'inspection à Semarang dans le centre de Java en 1814, Thomas Stamford Raffles, alors lieutenant-gouverneur de l'île, entendit parler d'un gra",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/b/bf/Borobudur_Northwest_View.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Temple_de_Borobudur",
  "etape": "titre du CSV"
 },
 "monuments-emblematiques|Pagode Shwedagon": {
  "slug": "monuments-emblematiques",
  "nom": "Pagode Shwedagon",
  "titre": "Pagode Shwedagon",
  "extrait": "La pagode Shwedagon ou pagode de Shwedagon (de shwe, or, et dagon, ancien nom de Rangoon) est une pagode (stûpa) remarquable situé sur la colline de Singuttara à Rangoon, en Birmanie. Ce lieu saint bouddhiste est le premier centre religieux de Birmanie car selon la légende, il contient des reliques de quatre anciens Bouddhas, dont huit cheveux du Bouddha Gautama.",
  "illustration": "https://upload.wikimedia.org/wikipedia/commons/a/a3/Yangon_-_Shwedagon_Pagoda_03.jpg",
  "lien": "https://fr.wikipedia.org/wiki/Pagode_Shwedagon",
